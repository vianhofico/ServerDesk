<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ServerDesk.App\ServerDesk.App.csproj" />
    <ProjectReference Include="..\..\src\ServerDesk.Application\ServerDesk.Application.csproj" />
    <ProjectReference Include="..\..\src\ServerDesk.Domain\ServerDesk.Domain.csproj" />
    <ProjectReference Include="..\..\src\ServerDesk.Infrastructure.Persistence\ServerDesk.Infrastructure.Persistence.csproj" />
    <ProjectReference Include="..\..\src\ServerDesk.Infrastructure.Ssh\ServerDesk.Infrastructure.Ssh.csproj" />
    <ProjectReference Include="..\..\src\ServerDesk.Platform.Windows\ServerDesk.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures\Capabilities\**\*"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never" />
    <None Include="Fixtures\Dashboard\**\*"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never" />
    <None Include="Fixtures\Network\**\*"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never" />
    <None Include="Fixtures\Logs\**\*"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never" />
    <None Include="Fixtures\Docker\**\*"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never" />
    <None Include="Fixtures\Git\**\*"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never" />
    <None Include="Fixtures\ScheduledTasks\**\*"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never" />
    <None Include="Fixtures\Nginx\**\*"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never" />
    <None Include="Fixtures\Tls\**\*"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never" />
    <None Include="Fixtures\EnvironmentFiles\**\*"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never" />
    <None Include="..\..\src\ServerDesk.App\Localization\Strings.*.xaml"
          Link="Fixtures\Localization\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
