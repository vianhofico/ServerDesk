<Window x:Class="ServerDesk.App.UserAdministrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.UserAdmin.WindowTitle}"
        Width="1280"
        Height="820"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Loc.UserAdmin.Subtitle}"
                           Margin="0,4,0,0"
                           Opacity="0.72"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="StatusText"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="RefreshButton"
                        Content="{DynamicResource Loc.UserAdmin.Refresh}"
                        MinWidth="94"
                        Padding="14,7"
                        Click="RefreshOnClick" />
                <Button x:Name="CancelButton"
                        Content="{DynamicResource Loc.UserAdmin.Cancel}"
                        MinWidth="94"
                        Padding="14,7"
                        Margin="8,0,0,0"
                        IsEnabled="False"
                        Click="CancelOnClick" />
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" Margin="0,16,0,0">
            <TabItem Header="{DynamicResource Loc.UserAdmin.UsersTab}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="5*" />
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="UserGrid"
                              Grid.Column="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              EnableRowVirtualization="True"
                              SelectionChanged="UserSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Loc.UserAdmin.Username}" Binding="{Binding Username}" Width="130" />
                            <DataGridTextColumn Header="UID" Binding="{Binding UserId}" Width="75" />
                            <DataGridTextColumn Header="{DynamicResource Loc.UserAdmin.PrimaryGroup}" Binding="{Binding PrimaryGroup}" Width="120" />
                            <DataGridTextColumn Header="{DynamicResource Loc.UserAdmin.Home}" Binding="{Binding Home}" Width="2*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.UserAdmin.Shell}" Binding="{Binding Shell}" Width="*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.UserAdmin.LockState}" Binding="{Binding LockState}" Width="105" />
                            <DataGridCheckBoxColumn Header="{DynamicResource Loc.UserAdmin.SudoVisible}" Binding="{Binding HasSudoVisibility}" Width="85" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Column="2"
                            BorderThickness="1"
                            BorderBrush="#22000000"
                            CornerRadius="6"
                            Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc.UserAdmin.GuardedMutation}"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="SelectedUserText"
                                           Margin="0,6,0,12"
                                           TextWrapping="Wrap" />

                                <TextBlock Text="{DynamicResource Loc.UserAdmin.MutationKind}" />
                                <ComboBox x:Name="UserMutationComboBox"
                                          Margin="0,4,0,10"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Text"
                                          SelectionChanged="UserEditorChanged" />

                                <TextBlock Text="{DynamicResource Loc.UserAdmin.TargetUsername}" />
                                <TextBox x:Name="TargetUsernameTextBox"
                                         Margin="0,4,0,10"
                                         TextChanged="UserEditorTextChanged" />

                                <TextBlock Text="{DynamicResource Loc.UserAdmin.Value}" />
                                <TextBox x:Name="UserValueTextBox"
                                         Margin="0,4,0,10"
                                         TextChanged="UserEditorTextChanged" />

                                <TextBlock Text="{DynamicResource Loc.UserAdmin.CreateHome}" />
                                <TextBox x:Name="CreateHomeTextBox"
                                         Margin="0,4,0,10"
                                         TextChanged="UserEditorTextChanged" />

                                <TextBlock Text="{DynamicResource Loc.UserAdmin.CreateShell}" />
                                <TextBox x:Name="CreateShellTextBox"
                                         Margin="0,4,0,6"
                                         TextChanged="UserEditorTextChanged" />
                                <CheckBox x:Name="CreateHomeCheckBox"
                                          Content="{DynamicResource Loc.UserAdmin.CreateHomeDirectory}"
                                          IsChecked="True"
                                          Margin="0,0,0,12"
                                          Checked="UserEditorToggleChanged"
                                          Unchecked="UserEditorToggleChanged" />

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="PreviewUserButton"
                                            Content="{DynamicResource Loc.UserAdmin.Preview}"
                                            Padding="14,7"
                                            Click="PreviewUserOnClick" />
                                    <Button x:Name="ExecuteUserButton"
                                            Content="{DynamicResource Loc.UserAdmin.Execute}"
                                            Padding="14,7"
                                            Margin="8,0,0,0"
                                            IsEnabled="False"
                                            Click="ExecuteUserOnClick" />
                                </StackPanel>

                                <TextBlock Text="{DynamicResource Loc.UserAdmin.ExactCommand}"
                                           FontWeight="SemiBold"
                                           Margin="0,14,0,4" />
                                <TextBox x:Name="UserPreviewTextBox"
                                         IsReadOnly="True"
                                         MinHeight="58"
                                         TextWrapping="Wrap"
                                         FontFamily="Cascadia Mono, Consolas" />
                                <TextBlock x:Name="UserImpactText"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Loc.UserAdmin.KeysTab}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="5*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock x:Name="KeysUserText"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <Button x:Name="LoadKeysButton"
                                    Content="{DynamicResource Loc.UserAdmin.LoadKeys}"
                                    Margin="12,0,0,0"
                                    Padding="12,6"
                                    Click="LoadKeysOnClick" />
                        </StackPanel>
                        <DataGrid x:Name="KeyGrid"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  EnableRowVirtualization="True"
                                  SelectionChanged="KeySelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Loc.UserAdmin.Fingerprint}" Binding="{Binding Fingerprint}" Width="2*" />
                                <DataGridTextColumn Header="{DynamicResource Loc.UserAdmin.KeyType}" Binding="{Binding KeyType}" Width="145" />
                                <DataGridTextColumn Header="{DynamicResource Loc.UserAdmin.Comment}" Binding="{Binding Comment}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Border Grid.Column="2"
                            BorderThickness="1"
                            BorderBrush="#22000000"
                            CornerRadius="6"
                            Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc.UserAdmin.GuardedKeys}"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource Loc.UserAdmin.PublicKeyOnly}"
                                           Margin="0,6,0,12"
                                           Opacity="0.72"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{DynamicResource Loc.UserAdmin.PublicKeyLine}" />
                                <TextBox x:Name="PublicKeyTextBox"
                                         Margin="0,4,0,10"
                                         MinHeight="78"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         TextChanged="KeyEditorTextChanged" />

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="PreviewAddKeyButton"
                                            Content="{DynamicResource Loc.UserAdmin.PreviewAddKey}"
                                            Padding="12,7"
                                            Click="PreviewAddKeyOnClick" />
                                    <Button x:Name="PreviewRemoveKeyButton"
                                            Content="{DynamicResource Loc.UserAdmin.PreviewRemoveKey}"
                                            Padding="12,7"
                                            Margin="8,0,0,0"
                                            Click="PreviewRemoveKeyOnClick" />
                                </StackPanel>
                                <Button x:Name="ExecuteKeyButton"
                                        Content="{DynamicResource Loc.UserAdmin.ExecuteKey}"
                                        Padding="12,7"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        IsEnabled="False"
                                        Click="ExecuteKeyOnClick" />

                                <TextBlock Text="{DynamicResource Loc.UserAdmin.KeyPreview}"
                                           FontWeight="SemiBold"
                                           Margin="0,14,0,4" />
                                <TextBox x:Name="KeyPreviewTextBox"
                                         IsReadOnly="True"
                                         MinHeight="58"
                                         TextWrapping="Wrap" />
                                <TextBlock x:Name="KeyImpactText"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   Text="{DynamicResource Loc.UserAdmin.SafetyFooter}"
                   Opacity="0.72"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
