<Window x:Class="ServerDesk.App.ScheduledTasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ServerDesk.App"
        Title="{DynamicResource Loc.Tasks.WindowTitle}"
        Width="1480"
        Height="900"
        MinWidth="1120"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Loaded="WindowOnLoaded"
        Closed="WindowOnClosed">
    <Window.Resources>
        <local:ScheduledTaskKindDisplayConverter x:Key="ScheduledTaskKindDisplayConverter" />
        <Style x:Key="TaskSummaryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style x:Key="TaskSummaryValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="TaskDetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style x:Key="TaskDetailValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,10" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="TaskTechnicalValue"
               TargetType="TextBlock"
               BasedOn="{StaticResource TaskDetailValue}">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SurfaceCard}" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Header.Title}"
                               FontSize="27"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Header.Subtitle}"
                               Margin="0,3,0,10"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ServerNameText" FontWeight="SemiBold" />
                        <TextBlock Text="  ·  " Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="EndpointText"
                                   Style="{StaticResource TechnicalText}"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="12,8" CornerRadius="8" Background="{DynamicResource SurfaceSecondaryBrush}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Header.Environment}" Style="{StaticResource TaskSummaryLabel}" />
                            <TextBlock x:Name="EnvironmentValueText" Margin="0,2,0,0" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Margin="8,0,0,0" Padding="12,8" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Header.Connection}" Style="{StaticResource TaskSummaryLabel}" />
                            <TextBlock x:Name="ConnectionValueText" Margin="0,2,0,0" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource CommandBarSurface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RefreshButton"
                            Content="{DynamicResource Loc.Tasks.Refresh}"
                            Click="RefreshOnClick"
                            Style="{StaticResource SecondaryButton}" />
                    <Button x:Name="CancelButton"
                            Margin="6,0,0,0"
                            Content="{DynamicResource Loc.TasksWorkspace.Command.Cancel}"
                            Click="CancelOnClick"
                            Style="{StaticResource GhostButton}"
                            IsEnabled="False" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Command.Target}"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="TargetValueText"
                               Margin="0,2,0,0"
                               FontFamily="Cascadia Mono, Consolas"
                               Text="{DynamicResource Loc.TasksWorkspace.Command.NoTarget}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="EnableButton"
                            Content="{DynamicResource Loc.Tasks.Enable}"
                            Click="EnableOnClick"
                            Style="{StaticResource SecondaryButton}"
                            IsEnabled="False" />
                    <Button x:Name="DisableButton"
                            Margin="6,0,0,0"
                            Content="{DynamicResource Loc.Tasks.Disable}"
                            Click="DisableOnClick"
                            Style="{StaticResource SecondaryButton}"
                            IsEnabled="False" />
                    <Button x:Name="DeleteButton"
                            Margin="8,0,0,0"
                            Content="{DynamicResource Loc.Tasks.Delete}"
                            Click="DeleteOnClick"
                            Style="{StaticResource DangerButton}"
                            IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.55*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SurfaceCard}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Summary.Total}" Style="{StaticResource TaskSummaryLabel}" />
                    <TextBlock x:Name="TotalTasksValue" Text="0" Style="{StaticResource TaskSummaryValue}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource SurfaceCard}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Summary.Visible}" Style="{StaticResource TaskSummaryLabel}" />
                    <TextBlock x:Name="VisibleTasksValue" Text="0" Style="{StaticResource TaskSummaryValue}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Summary.Cron}" Style="{StaticResource TaskSummaryLabel}" />
                    <TextBlock x:Name="CronTasksValue" Text="0" Style="{StaticResource TaskSummaryValue}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource SurfaceCard}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Summary.Systemd}" Style="{StaticResource TaskSummaryLabel}" />
                    <TextBlock x:Name="SystemdTasksValue" Text="0" Style="{StaticResource TaskSummaryValue}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource SurfaceCard}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Summary.Enabled}" Style="{StaticResource TaskSummaryLabel}" />
                    <TextBlock x:Name="EnabledTasksValue" Text="0" Style="{StaticResource TaskSummaryValue}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="5" Style="{StaticResource SurfaceCard}" Padding="12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Tasks.ActionTooltip}" Style="{StaticResource TaskSummaryLabel}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Summary.CronCapability}" FontWeight="SemiBold" />
                        <TextBlock Text=": " />
                        <TextBlock x:Name="CronCapabilityText" />
                        <TextBlock Text="  ·  " Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Summary.SystemdCapability}" FontWeight="SemiBold" />
                        <TextBlock Text=": " />
                        <TextBlock x:Name="SystemdCapabilityText" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>
            <Border x:Name="StatusCard" Style="{StaticResource InlineInfoCard}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
                    <TextBlock x:Name="CapabilityText"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
            </Border>
            <Grid Grid.Column="1">
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource OperationalSearchTextBox}"
                         Padding="10,6,38,6"
                         TextChanged="SearchBoxOnTextChanged"
                         ToolTip="{DynamicResource Loc.Tasks.SearchHint}"
                         AutomationProperties.Name="{DynamicResource Loc.TasksWorkspace.Search.Label}" />
                <Button x:Name="ClearSearchButton"
                        Width="32"
                        Height="30"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,3,0"
                        Padding="0"
                        Content="×"
                        ToolTip="{DynamicResource Loc.TasksWorkspace.Search.Clear}"
                        Click="ClearSearchOnClick"
                        Style="{StaticResource GhostButton}"
                        Visibility="Collapsed"
                        AutomationProperties.Name="{DynamicResource Loc.TasksWorkspace.Search.Clear}" />
            </Grid>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.1*" />
                <ColumnDefinition Width="1.55*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource SurfaceCard}" CornerRadius="8" ClipToBounds="True">
                <Grid>
                    <DataGrid x:Name="TaskGrid"
                              Style="{StaticResource OperationalDataGrid}"
                              BorderThickness="0"
                              SelectionChanged="TaskGridOnSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Loc.Tasks.Type}"
                                                Binding="{Binding Kind, Converter={StaticResource ScheduledTaskKindDisplayConverter}}"
                                                Width="0.9*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Tasks.Name}" Binding="{Binding Name}" Width="1.3*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Tasks.Schedule}" Binding="{Binding Schedule}" Width="1.4*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TechnicalText}" />
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{DynamicResource Loc.Tasks.Command}" Binding="{Binding CommandOrUnit}" Width="2.2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TechnicalText}" />
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridCheckBoxColumn Header="{DynamicResource Loc.Tasks.Enabled}" Binding="{Binding Enabled}" Width="0.65*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.TasksWorkspace.Details.NextRun}" Binding="{Binding NextRun}" Width="1.25*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TechnicalText}" />
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border x:Name="TaskStateOverlay"
                            Background="{DynamicResource SurfaceBrush}"
                            Visibility="Visible"
                            IsHitTestVisible="False">
                        <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="TaskStateTitle" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock x:Name="TaskStateDetail"
                                       Margin="0,7,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="14,0,0,0" Style="{StaticResource DetailsPane}">
                <TabControl x:Name="WorkspaceTabs">
                    <TabItem Header="{DynamicResource Loc.Tasks.Details}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4">
                                <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Details.Title}" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock x:Name="DetailsHintText"
                                           Margin="0,9,0,0"
                                           Text="{DynamicResource Loc.TasksWorkspace.Details.Hint}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap" />

                                <StackPanel x:Name="DetailsContent" Margin="0,14,0,0" Visibility="Collapsed">
                                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Details.Kind}" Style="{StaticResource TaskDetailLabel}" />
                                    <TextBlock x:Name="DetailKindText" Style="{StaticResource TaskDetailValue}" />
                                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Details.Name}" Style="{StaticResource TaskDetailLabel}" />
                                    <TextBlock x:Name="DetailNameText" Style="{StaticResource TaskTechnicalValue}" />
                                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Details.Schedule}" Style="{StaticResource TaskDetailLabel}" />
                                    <TextBlock x:Name="DetailScheduleText" Style="{StaticResource TaskTechnicalValue}" />
                                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Details.Command}" Style="{StaticResource TaskDetailLabel}" />
                                    <TextBlock x:Name="DetailCommandText" Style="{StaticResource TaskTechnicalValue}" />
                                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Details.Enabled}" Style="{StaticResource TaskDetailLabel}" />
                                    <TextBlock x:Name="DetailEnabledText" Style="{StaticResource TaskDetailValue}" />
                                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Details.Active}" Style="{StaticResource TaskDetailLabel}" />
                                    <TextBlock x:Name="DetailActiveText" Style="{StaticResource TaskDetailValue}" />
                                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Details.LastRun}" Style="{StaticResource TaskDetailLabel}" />
                                    <TextBlock x:Name="DetailLastRunText" Style="{StaticResource TaskTechnicalValue}" />
                                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Details.NextRun}" Style="{StaticResource TaskDetailLabel}" />
                                    <TextBlock x:Name="DetailNextRunText" Style="{StaticResource TaskTechnicalValue}" />
                                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Details.Source}" Style="{StaticResource TaskDetailLabel}" />
                                    <TextBlock x:Name="DetailSourceText" Style="{StaticResource TaskTechnicalValue}" />
                                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Details.Editable}" Style="{StaticResource TaskDetailLabel}" />
                                    <TextBlock x:Name="DetailEditableText" Style="{StaticResource TaskDetailValue}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,14">
                                        <Button x:Name="HistoryButton"
                                                Content="{DynamicResource Loc.Tasks.LoadHistory}"
                                                Click="HistoryOnClick"
                                                Style="{StaticResource SecondaryButton}"
                                                IsEnabled="False" />
                                        <Button x:Name="RawSourceButton"
                                                Margin="6,0,0,0"
                                                Content="{DynamicResource Loc.Tasks.LoadRawSource}"
                                                Click="RawSourceOnClick"
                                                Style="{StaticResource SecondaryButton}"
                                                IsEnabled="False" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Margin="0,4,0,0" Padding="12" CornerRadius="8" Background="{DynamicResource SurfaceSecondaryBrush}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.Tasks.CronEditor}" FontWeight="SemiBold" FontSize="16" />
                                            <Button x:Name="NewCronButton"
                                                    Grid.Column="1"
                                                    Content="{DynamicResource Loc.Tasks.NewCron}"
                                                    Click="NewCronOnClick"
                                                    Style="{StaticResource SecondaryButton}"
                                                    IsEnabled="False" />
                                        </Grid>
                                        <TextBlock Margin="0,6,0,8"
                                                   Text="{DynamicResource Loc.TasksWorkspace.Editor.AdvancedHint}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="{DynamicResource Loc.Tasks.Minute}" />
                                                <TextBox x:Name="MinuteBox" Style="{StaticResource FieldTextBox}" Margin="0,4,0,8" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                                <TextBlock Text="{DynamicResource Loc.Tasks.Hour}" />
                                                <TextBox x:Name="HourBox" Style="{StaticResource FieldTextBox}" Margin="0,4,0,8" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                                <TextBlock Text="{DynamicResource Loc.Tasks.DayOfMonth}" />
                                                <TextBox x:Name="DayOfMonthBox" Style="{StaticResource FieldTextBox}" Margin="0,4,0,8" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Margin="0,0,6,0">
                                                <TextBlock Text="{DynamicResource Loc.Tasks.Month}" />
                                                <TextBox x:Name="MonthBox" Style="{StaticResource FieldTextBox}" Margin="0,4,0,8" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="{DynamicResource Loc.Tasks.DayOfWeek}" />
                                                <TextBox x:Name="DayOfWeekBox" Style="{StaticResource FieldTextBox}" Margin="0,4,0,8" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{DynamicResource Loc.Tasks.Command}" />
                                        <TextBox x:Name="CommandBox"
                                                 Style="{StaticResource FieldTextBox}"
                                                 Margin="0,4,0,8"
                                                 FontFamily="Cascadia Mono, Consolas" />
                                        <CheckBox x:Name="CronEnabledCheck"
                                                  Content="{DynamicResource Loc.Tasks.Enabled}"
                                                  Margin="0,2,0,10"
                                                  IsChecked="True" />
                                        <Button x:Name="SaveCronButton"
                                                Content="{DynamicResource Loc.Tasks.SaveCron}"
                                                Click="SaveCronOnClick"
                                                Style="{StaticResource PrimaryButton}"
                                                HorizontalAlignment="Left"
                                                IsEnabled="False" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="{DynamicResource Loc.Tasks.RawCrontab}">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Loc.Tasks.RawCrontabHint}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBox x:Name="RawCronBox"
                                     Grid.Row="1"
                                     Margin="0,10,0,10"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     FontFamily="Cascadia Mono, Consolas"
                                     FontSize="12"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" />
                            <Button x:Name="ApplyRawCronButton"
                                    Grid.Row="2"
                                    Content="{DynamicResource Loc.Tasks.ApplyRawCrontab}"
                                    Click="ApplyRawCronOnClick"
                                    Style="{StaticResource DangerButton}"
                                    HorizontalAlignment="Left"
                                    IsEnabled="False" />
                        </Grid>
                    </TabItem>

                    <TabItem Header="{DynamicResource Loc.Tasks.History}">
                        <TextBox x:Name="HistoryBox"
                                 Margin="8"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="12"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" />
                    </TabItem>

                    <TabItem Header="{DynamicResource Loc.Tasks.RawSource}">
                        <TextBox x:Name="RawSourceBox"
                                 Margin="8"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="12"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" />
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <TextBlock Grid.Row="5"
                   Margin="0,10,0,0"
                   Text="{DynamicResource Loc.Tasks.SafetyFooter}"
                   Foreground="{DynamicResource MutedTextBrush}"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
