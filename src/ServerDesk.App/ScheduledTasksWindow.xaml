<Window x:Class="ServerDesk.App.ScheduledTasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ServerDesk.App"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource Loc.Tasks.WindowTitle}"
        Width="1480"
        Height="900"
        MinWidth="1120"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Loaded="WindowOnLoaded"
        Closed="WindowOnClosed">
    <Window.Resources>
        <local:ScheduledTaskKindDisplayConverter x:Key="ScheduledTaskKindDisplayConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Header.Title}"
                               Style="{StaticResource PageTitleText}" />
                    <TextBlock Margin="0,2,0,3"
                               Text="{DynamicResource Loc.TasksWorkspace.Header.Subtitle}"
                               Style="{StaticResource CaptionText}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ServerNameText" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="  ·  " Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="EndpointText"
                                   Style="{StaticResource TechnicalText}"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusPill}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Header.Environment}"
                                       Style="{StaticResource CaptionText}" />
                            <TextBlock Text=" · " Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock x:Name="EnvironmentValueText" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Margin="8,0,0,0" Style="{StaticResource AccentStatusPill}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6"
                                     Height="6"
                                     Margin="0,0,7,0"
                                     Fill="{DynamicResource AccentBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="ConnectionValueText" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="20,14,20,0"
                Style="{StaticResource CommandBarSurface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RefreshButton"
                            Click="RefreshOnClick"
                            Style="{StaticResource PrimaryButton}"
                            AutomationProperties.Name="{DynamicResource Loc.Tasks.Refresh}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;"
                                       Margin="0,0,7,0"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="White" />
                            <TextBlock Text="{DynamicResource Loc.Tasks.Refresh}" Foreground="White" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelButton"
                            Margin="8,0,0,0"
                            Content="{DynamicResource Loc.TasksWorkspace.Command.Cancel}"
                            Click="CancelOnClick"
                            Style="{StaticResource GhostButton}"
                            IsEnabled="False" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Command.Target}"
                               Style="{StaticResource EyebrowText}" />
                    <TextBlock x:Name="TargetValueText"
                               Margin="0,2,0,0"
                               Style="{StaticResource TechnicalText}"
                               Text="{DynamicResource Loc.TasksWorkspace.Command.NoTarget}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="EnableButton"
                            Content="{DynamicResource Loc.Tasks.Enable}"
                            Click="EnableOnClick"
                            Style="{StaticResource SecondaryButton}"
                            IsEnabled="False" />
                    <Button x:Name="DisableButton"
                            Margin="6,0,0,0"
                            Content="{DynamicResource Loc.Tasks.Disable}"
                            Click="DisableOnClick"
                            Style="{StaticResource SecondaryButton}"
                            IsEnabled="False" />
                    <Button x:Name="DeleteButton"
                            Margin="8,0,0,0"
                            Content="{DynamicResource Loc.Tasks.Delete}"
                            Click="DeleteOnClick"
                            Style="{StaticResource DangerButton}"
                            IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="20,10,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1.7*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource MetricTile}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Summary.Total}" Style="{StaticResource EyebrowText}" />
                    <TextBlock x:Name="TotalTasksValue" Margin="0,4,0,0" Text="0" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource MetricTile}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Summary.Visible}" Style="{StaticResource EyebrowText}" />
                    <TextBlock x:Name="VisibleTasksValue" Margin="0,4,0,0" Text="0" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource MetricTile}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Summary.Cron}" Style="{StaticResource EyebrowText}" />
                    <TextBlock x:Name="CronTasksValue" Margin="0,4,0,0" Text="0" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource MetricTile}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Summary.Systemd}" Style="{StaticResource EyebrowText}" />
                    <TextBlock x:Name="SystemdTasksValue" Margin="0,4,0,0" Text="0" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="8" Style="{StaticResource MetricTile}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Summary.Enabled}" Style="{StaticResource EyebrowText}" />
                    <TextBlock x:Name="EnabledTasksValue" Margin="0,4,0,0" Text="0" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="10" Style="{StaticResource InlineInfoCard}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Tasks.ActionTooltip}"
                               Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Summary.CronCapability}" FontWeight="SemiBold" />
                        <TextBlock Text=": " />
                        <TextBlock x:Name="CronCapabilityText" />
                        <TextBlock Text="  ·  " Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Summary.SystemdCapability}" FontWeight="SemiBold" />
                        <TextBlock Text=": " />
                        <TextBlock x:Name="SystemdCapabilityText" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="20,10,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>
            <Border x:Name="StatusCard" Style="{StaticResource InlineInfoCard}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
                    <TextBlock x:Name="CapabilityText"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionText}" />
                </StackPanel>
            </Border>
            <Grid Grid.Column="1">
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource OperationalSearchTextBox}"
                         Padding="34,6,36,6"
                         TextChanged="SearchBoxOnTextChanged"
                         ToolTip="{DynamicResource Loc.Tasks.SearchHint}"
                         AutomationProperties.Name="{DynamicResource Loc.TasksWorkspace.Search.Label}" />
                <TextBlock Text="&#xE721;"
                           Margin="11,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="13"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <Button x:Name="ClearSearchButton"
                        Width="32"
                        Height="30"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,3,0"
                        Padding="0"
                        ToolTip="{DynamicResource Loc.TasksWorkspace.Search.Clear}"
                        Click="ClearSearchOnClick"
                        Style="{StaticResource GhostButton}"
                        Visibility="Collapsed"
                        AutomationProperties.Name="{DynamicResource Loc.TasksWorkspace.Search.Clear}">
                    <TextBlock Text="&#xE711;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="11" />
                </Button>
            </Grid>
        </Grid>

        <Grid Grid.Row="4" Margin="20,0,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.1*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.55*" />
            </Grid.ColumnDefinitions>

            <ui:Card Grid.Column="0" Padding="0" ClipToBounds="True">
                <Grid>
                    <DataGrid x:Name="TaskGrid"
                              Style="{StaticResource OperationalDataGrid}"
                              BorderThickness="0"
                              SelectionChanged="TaskGridOnSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Loc.Tasks.Type}"
                                                Binding="{Binding Kind, Converter={StaticResource ScheduledTaskKindDisplayConverter}}"
                                                Width="0.9*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Tasks.Name}" Binding="{Binding Name}" Width="1.3*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Tasks.Schedule}" Binding="{Binding Schedule}" Width="1.4*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TechnicalText}" />
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{DynamicResource Loc.Tasks.Command}" Binding="{Binding CommandOrUnit}" Width="2.2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TechnicalText}" />
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridCheckBoxColumn Header="{DynamicResource Loc.Tasks.Enabled}" Binding="{Binding Enabled}" Width="0.65*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.TasksWorkspace.Details.NextRun}" Binding="{Binding NextRun}" Width="1.25*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TechnicalText}" />
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border x:Name="TaskStateOverlay"
                            Background="{DynamicResource SurfaceBrush}"
                            Visibility="Visible"
                            IsHitTestVisible="False">
                        <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="48"
                                    Height="48"
                                    Margin="0,0,0,14"
                                    CornerRadius="14"
                                    Background="{DynamicResource SurfaceSecondaryBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="&#xE823;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="20"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="TaskStateTitle"
                                       Style="{StaticResource SectionTitleText}"
                                       TextAlignment="Center" />
                            <TextBlock x:Name="TaskStateDetail"
                                       Margin="0,7,0,0"
                                       Style="{StaticResource SecondaryBodyText}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ui:Card>

            <Border Grid.Column="2" Style="{StaticResource DetailsPane}">
                <TabControl x:Name="WorkspaceTabs">
                    <TabItem Header="{DynamicResource Loc.Tasks.Details}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4">
                                <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Details.Title}"
                                           Style="{StaticResource SectionTitleText}" />
                                <TextBlock x:Name="DetailsHintText"
                                           Margin="0,9,0,0"
                                           Text="{DynamicResource Loc.TasksWorkspace.Details.Hint}"
                                           Style="{StaticResource SecondaryBodyText}"
                                           TextWrapping="Wrap" />

                                <StackPanel x:Name="DetailsContent" Margin="0,14,0,0" Visibility="Collapsed">
                                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Details.Kind}" Style="{StaticResource FormLabelText}" />
                                    <TextBlock x:Name="DetailKindText" Margin="0,2,0,10" />
                                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Details.Name}" Style="{StaticResource FormLabelText}" />
                                    <TextBlock x:Name="DetailNameText" Margin="0,2,0,10" Style="{StaticResource TechnicalText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Details.Schedule}" Style="{StaticResource FormLabelText}" />
                                    <TextBlock x:Name="DetailScheduleText" Margin="0,2,0,10" Style="{StaticResource TechnicalText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Details.Command}" Style="{StaticResource FormLabelText}" />
                                    <TextBlock x:Name="DetailCommandText" Margin="0,2,0,10" Style="{StaticResource TechnicalText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Details.Enabled}" Style="{StaticResource FormLabelText}" />
                                    <TextBlock x:Name="DetailEnabledText" Margin="0,2,0,10" />
                                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Details.Active}" Style="{StaticResource FormLabelText}" />
                                    <TextBlock x:Name="DetailActiveText" Margin="0,2,0,10" />
                                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Details.LastRun}" Style="{StaticResource FormLabelText}" />
                                    <TextBlock x:Name="DetailLastRunText" Margin="0,2,0,10" Style="{StaticResource TechnicalText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Details.NextRun}" Style="{StaticResource FormLabelText}" />
                                    <TextBlock x:Name="DetailNextRunText" Margin="0,2,0,10" Style="{StaticResource TechnicalText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Details.Source}" Style="{StaticResource FormLabelText}" />
                                    <TextBlock x:Name="DetailSourceText" Margin="0,2,0,10" Style="{StaticResource TechnicalText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Loc.TasksWorkspace.Details.Editable}" Style="{StaticResource FormLabelText}" />
                                    <TextBlock x:Name="DetailEditableText" Margin="0,2,0,10" />

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,14">
                                        <Button x:Name="HistoryButton"
                                                Content="{DynamicResource Loc.Tasks.LoadHistory}"
                                                Click="HistoryOnClick"
                                                Style="{StaticResource SecondaryButton}"
                                                IsEnabled="False" />
                                        <Button x:Name="RawSourceButton"
                                                Margin="6,0,0,0"
                                                Content="{DynamicResource Loc.Tasks.LoadRawSource}"
                                                Click="RawSourceOnClick"
                                                Style="{StaticResource SecondaryButton}"
                                                IsEnabled="False" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Margin="0,4,0,0" Style="{StaticResource SectionSurface}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.Tasks.CronEditor}"
                                                       Style="{StaticResource SectionTitleText}" />
                                            <Button x:Name="NewCronButton"
                                                    Grid.Column="1"
                                                    Content="{DynamicResource Loc.Tasks.NewCron}"
                                                    Click="NewCronOnClick"
                                                    Style="{StaticResource SecondaryButton}"
                                                    IsEnabled="False" />
                                        </Grid>
                                        <TextBlock Margin="0,6,0,8"
                                                   Text="{DynamicResource Loc.TasksWorkspace.Editor.AdvancedHint}"
                                                   Style="{StaticResource SecondaryBodyText}"
                                                   TextWrapping="Wrap" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="{DynamicResource Loc.Tasks.Minute}" Style="{StaticResource FormLabelText}" />
                                                <TextBox x:Name="MinuteBox" Style="{StaticResource FieldTextBox}" Margin="0,4,0,8"
                                                         AutomationProperties.Name="{DynamicResource Loc.Tasks.Minute}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                                <TextBlock Text="{DynamicResource Loc.Tasks.Hour}" Style="{StaticResource FormLabelText}" />
                                                <TextBox x:Name="HourBox" Style="{StaticResource FieldTextBox}" Margin="0,4,0,8"
                                                         AutomationProperties.Name="{DynamicResource Loc.Tasks.Hour}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                                <TextBlock Text="{DynamicResource Loc.Tasks.DayOfMonth}" Style="{StaticResource FormLabelText}" />
                                                <TextBox x:Name="DayOfMonthBox" Style="{StaticResource FieldTextBox}" Margin="0,4,0,8"
                                                         AutomationProperties.Name="{DynamicResource Loc.Tasks.DayOfMonth}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Margin="0,0,6,0">
                                                <TextBlock Text="{DynamicResource Loc.Tasks.Month}" Style="{StaticResource FormLabelText}" />
                                                <TextBox x:Name="MonthBox" Style="{StaticResource FieldTextBox}" Margin="0,4,0,8"
                                                         AutomationProperties.Name="{DynamicResource Loc.Tasks.Month}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="{DynamicResource Loc.Tasks.DayOfWeek}" Style="{StaticResource FormLabelText}" />
                                                <TextBox x:Name="DayOfWeekBox" Style="{StaticResource FieldTextBox}" Margin="0,4,0,8"
                                                         AutomationProperties.Name="{DynamicResource Loc.Tasks.DayOfWeek}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{DynamicResource Loc.Tasks.Command}" Style="{StaticResource FormLabelText}" />
                                        <TextBox x:Name="CommandBox"
                                                 Style="{StaticResource FieldTextBox}"
                                                 Margin="0,4,0,8"
                                                 FontFamily="Cascadia Mono, Consolas"
                                                 AutomationProperties.Name="{DynamicResource Loc.Tasks.Command}" />
                                        <CheckBox x:Name="CronEnabledCheck"
                                                  Content="{DynamicResource Loc.Tasks.Enabled}"
                                                  Margin="0,2,0,10"
                                                  IsChecked="True" />
                                        <Button x:Name="SaveCronButton"
                                                Content="{DynamicResource Loc.Tasks.SaveCron}"
                                                Click="SaveCronOnClick"
                                                Style="{StaticResource PrimaryButton}"
                                                HorizontalAlignment="Left"
                                                IsEnabled="False" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="{DynamicResource Loc.Tasks.RawCrontab}">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Loc.Tasks.RawCrontabHint}"
                                       Style="{StaticResource SecondaryBodyText}"
                                       TextWrapping="Wrap" />
                            <TextBox x:Name="RawCronBox"
                                     Grid.Row="1"
                                     Margin="0,10,0,10"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     FontFamily="Cascadia Mono, Consolas"
                                     FontSize="12"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" />
                            <Button x:Name="ApplyRawCronButton"
                                    Grid.Row="2"
                                    Content="{DynamicResource Loc.Tasks.ApplyRawCrontab}"
                                    Click="ApplyRawCronOnClick"
                                    Style="{StaticResource DangerButton}"
                                    HorizontalAlignment="Left"
                                    IsEnabled="False" />
                        </Grid>
                    </TabItem>

                    <TabItem Header="{DynamicResource Loc.Tasks.History}">
                        <TextBox x:Name="HistoryBox"
                                 Margin="8"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="12"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" />
                    </TabItem>

                    <TabItem Header="{DynamicResource Loc.Tasks.RawSource}">
                        <TextBox x:Name="RawSourceBox"
                                 Margin="8"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="12"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" />
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <TextBlock Grid.Row="5"
                   Margin="22,10,22,14"
                   Text="{DynamicResource Loc.Tasks.SafetyFooter}"
                   Style="{StaticResource CaptionText}"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
