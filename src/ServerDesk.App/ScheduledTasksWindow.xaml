<Window x:Class="ServerDesk.App.ScheduledTasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scheduled Tasks"
        Width="1480" Height="880" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Loaded="WindowOnLoaded" Closed="WindowOnClosed">
    <Window.Resources>
        <Style x:Key="TaskButton" TargetType="Button">
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,8,8" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="7,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="26" FontWeight="SemiBold" />
                <TextBlock x:Name="EndpointText" Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="{DynamicResource Loc.Tasks.Refresh}" Click="RefreshOnClick" Style="{StaticResource TaskButton}" Margin="0" />
                <Button Content="{DynamicResource Loc.Common.Cancel}" Click="CancelOnClick" Style="{StaticResource TaskButton}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,14,0,12" Padding="10" CornerRadius="7" Background="{DynamicResource SurfaceSecondaryBrush}">
            <StackPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
                <TextBlock x:Name="CapabilityText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="510" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <Border Padding="12" CornerRadius="9" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Loc.Tasks.List}" FontWeight="SemiBold" FontSize="16" />
                    <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,10,0,10" TextChanged="SearchBoxOnTextChanged" ToolTip="{DynamicResource Loc.Tasks.SearchHint}" />
                    <DataGrid x:Name="TaskGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              SelectionChanged="TaskGridOnSelectionChanged" EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Loc.Tasks.Type}" Binding="{Binding Kind}" Width="90" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Tasks.Name}" Binding="{Binding Name}" Width="160" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Tasks.Schedule}" Binding="{Binding Schedule}" Width="*" />
                            <DataGridCheckBoxColumn Header="{DynamicResource Loc.Tasks.Enabled}" Binding="{Binding Enabled}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="14" CornerRadius="9" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <TabControl>
                    <TabItem Header="{DynamicResource Loc.Tasks.Details}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <TextBlock x:Name="SelectedTitleText" Text="{DynamicResource Loc.Tasks.SelectTask}" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock x:Name="SelectedDetailText" Margin="0,5,0,12" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
                                <WrapPanel Margin="0,0,0,18">
                                    <Button x:Name="EnableButton" Content="{DynamicResource Loc.Tasks.Enable}" Click="EnableOnClick" Style="{StaticResource TaskButton}" Margin="0" IsEnabled="False" />
                                    <Button x:Name="DisableButton" Content="{DynamicResource Loc.Tasks.Disable}" Click="DisableOnClick" Style="{StaticResource TaskButton}" IsEnabled="False" />
                                    <Button x:Name="DeleteButton" Content="{DynamicResource Loc.Tasks.Delete}" Click="DeleteOnClick" Style="{StaticResource TaskButton}" IsEnabled="False" />
                                    <Button x:Name="HistoryButton" Content="{DynamicResource Loc.Tasks.LoadHistory}" Click="HistoryOnClick" Style="{StaticResource TaskButton}" IsEnabled="False" />
                                    <Button x:Name="RawSourceButton" Content="{DynamicResource Loc.Tasks.LoadRawSource}" Click="RawSourceOnClick" Style="{StaticResource TaskButton}" IsEnabled="False" />
                                </WrapPanel>

                                <Border Padding="12" CornerRadius="7" Background="{DynamicResource SurfaceSecondaryBrush}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Loc.Tasks.CronEditor}" FontWeight="SemiBold" FontSize="16" />
                                            <Button Grid.Column="1" Content="{DynamicResource Loc.Tasks.NewCron}" Click="NewCronOnClick" Style="{StaticResource TaskButton}" Margin="8,0,0,0" />
                                        </Grid>
                                        <TextBlock Margin="0,6,0,8" Text="{DynamicResource Loc.Tasks.CronEditorHint}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0"><TextBlock Text="{DynamicResource Loc.Tasks.Minute}" /><TextBox x:Name="MinuteBox" Style="{StaticResource FieldBox}" /></StackPanel>
                                            <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Loc.Tasks.Hour}" /><TextBox x:Name="HourBox" Style="{StaticResource FieldBox}" /></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource Loc.Tasks.DayOfMonth}" /><TextBox x:Name="DayOfMonthBox" Style="{StaticResource FieldBox}" /></StackPanel>
                                            <StackPanel Grid.Column="3"><TextBlock Text="{DynamicResource Loc.Tasks.Month}" /><TextBox x:Name="MonthBox" Style="{StaticResource FieldBox}" /></StackPanel>
                                            <StackPanel Grid.Column="4"><TextBlock Text="{DynamicResource Loc.Tasks.DayOfWeek}" /><TextBox x:Name="DayOfWeekBox" Style="{StaticResource FieldBox}" Margin="0,4,0,8" /></StackPanel>
                                        </Grid>
                                        <TextBlock Text="{DynamicResource Loc.Tasks.Command}" />
                                        <TextBox x:Name="CommandBox" Style="{StaticResource FieldBox}" Margin="0,4,0,8" />
                                        <CheckBox x:Name="CronEnabledCheck" Content="{DynamicResource Loc.Tasks.Enabled}" Margin="0,2,0,10" IsChecked="True" />
                                        <Button x:Name="SaveCronButton" Content="{DynamicResource Loc.Tasks.SaveCron}" Click="SaveCronOnClick" Style="{StaticResource TaskButton}" Margin="0" IsEnabled="False" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="{DynamicResource Loc.Tasks.RawCrontab}">
                        <Grid Margin="10">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Loc.Tasks.RawCrontabHint}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBox x:Name="RawCronBox" Grid.Row="1" Margin="0,10,0,10" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="12"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                            <Button x:Name="ApplyRawCronButton" Grid.Row="2" Content="{DynamicResource Loc.Tasks.ApplyRawCrontab}" Click="ApplyRawCronOnClick"
                                    Style="{StaticResource TaskButton}" Margin="0" HorizontalAlignment="Left" IsEnabled="False" />
                        </Grid>
                    </TabItem>

                    <TabItem Header="{DynamicResource Loc.Tasks.History}">
                        <TextBox x:Name="HistoryBox" Margin="10" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                    </TabItem>

                    <TabItem Header="{DynamicResource Loc.Tasks.RawSource}">
                        <TextBox x:Name="RawSourceBox" Margin="10" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Margin="0,10,0,0" Text="{DynamicResource Loc.Tasks.SafetyFooter}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
    </Grid>
</Window>
