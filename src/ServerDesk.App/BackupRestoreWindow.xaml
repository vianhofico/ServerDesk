<Window x:Class="ServerDesk.App.BackupRestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.BackupRestore.WindowTitle}"
        Width="1180" Height="760" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Loc.BackupRestore.Subtitle}" Margin="0,4,0,0" Opacity="0.72" TextWrapping="Wrap" />
            <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource Loc.BackupRestore.TargetPath}" />
                <TextBox x:Name="TargetPathTextBox" Margin="0,4,0,0" TextChanged="CreateEditorChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{DynamicResource Loc.BackupRestore.DestinationDirectory}" />
                <TextBox x:Name="DestinationTextBox" Margin="0,4,0,0" TextChanged="CreateEditorChanged" />
            </StackPanel>
            <Button Grid.Column="3" x:Name="CreateButton"
                    Content="{DynamicResource Loc.BackupRestore.CreateVerify}"
                    Margin="12,20,0,0" Padding="14,7" VerticalAlignment="Top"
                    Click="CreateBackupOnClick" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="BackupGrid" Grid.Column="0"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionChanged="BackupSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Loc.BackupRestore.Created}" Binding="{Binding CreatedAtUtc}" Width="160" />
                    <DataGridTextColumn Header="{DynamicResource Loc.BackupRestore.Target}" Binding="{Binding TargetPath.Value}" Width="2*" />
                    <DataGridTextColumn Header="{DynamicResource Loc.BackupRestore.Backup}" Binding="{Binding BackupPath.Value}" Width="2*" />
                    <DataGridTextColumn Header="{DynamicResource Loc.BackupRestore.Size}" Binding="{Binding Size}" Width="90" />
                    <DataGridCheckBoxColumn Header="{DynamicResource Loc.BackupRestore.Verified}" Binding="{Binding IsVerified}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" BorderThickness="1" BorderBrush="#22000000" CornerRadius="6" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.BackupRestore.Restore}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Loc.BackupRestore.ExactTargetNotice}" Margin="0,6,0,12" Opacity="0.72" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource Loc.BackupRestore.SelectedManifest}" FontWeight="SemiBold" />
                        <TextBlock x:Name="ManifestText" Margin="0,4,0,10" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PreviewRestoreButton" Content="{DynamicResource Loc.BackupRestore.PreviewRestore}"
                                    Padding="14,7" Click="PreviewRestoreOnClick" />
                            <Button x:Name="ExecuteRestoreButton" Content="{DynamicResource Loc.BackupRestore.ExecuteRestore}"
                                    Padding="14,7" Margin="8,0,0,0" IsEnabled="False" Click="ExecuteRestoreOnClick" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Loc.BackupRestore.Preview}" FontWeight="SemiBold" Margin="0,14,0,4" />
                        <TextBox x:Name="PreviewTextBox" IsReadOnly="True" MinHeight="84" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource Loc.BackupRestore.Rollback}" FontWeight="SemiBold" Margin="0,12,0,4" />
                        <TextBlock x:Name="RollbackText" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource Loc.BackupRestore.VerificationPolicy}" Margin="0,14,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="{DynamicResource Loc.BackupRestore.Footer}" Margin="0,12,0,0" Opacity="0.68" TextWrapping="Wrap" />
    </Grid>
</Window>
