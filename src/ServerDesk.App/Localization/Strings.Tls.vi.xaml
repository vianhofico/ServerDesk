    <system:String x:Key="Loc.Tls.RenewConfirmTitle">Gia hạn chứng chỉ Certbot?</system:String>
    <system:String x:Key="Loc.Tls.RenewConfirmMessage">Certbot lineage: {0}\nChứng chỉ: {1}\n\nThao tác có thể liên hệ CA, thay file chứng chỉ và reload nginx khi chứng chỉ thay đổi. ServerDesk sẽ không retry mù nếu trạng thái hoàn tất không xác định. Tiếp tục?</system:String>
