    <system:String x:Key="Loc.Tls.RenewFailed">Gia hạn Certbot thất bại.</system:String>
    <system:String x:Key="Loc.Tls.Ambiguous">Không xác định chắc chắn trạng thái hoàn tất. Hãy làm mới chứng chỉ và nginx trước khi thử lại.</system:String>
    <system:String x:Key="Loc.Tls.Obtain">Cấp chứng chỉ</system:String>
    <system:String x:Key="Loc.Tls.ObtainHelp">Quy trình cấp dùng Certbot certonly với nginx authenticator. Nó không tự sửa site nginx. Hãy gắn đường dẫn chứng chỉ bằng trình sửa nginx được bảo vệ.</system:String>
    <system:String x:Key="Loc.Tls.NginxSite">Site nginx</system:String>
    <system:String x:Key="Loc.Tls.CertificateName">Tên chứng chỉ</system:String>
    <system:String x:Key="Loc.Tls.Domains">Tên miền</system:String>
    <system:String x:Key="Loc.Tls.Email">Email ACME</system:String>
    <system:String x:Key="Loc.Tls.Terms">Tôi chấp nhận điều khoản của ACME CA cho yêu cầu này</system:String>
    <system:String x:Key="Loc.Tls.ObtainConfirmTitle">Cấp chứng chỉ bằng Certbot?</system:String>
    <system:String x:Key="Loc.Tls.ObtainConfirmMessage">Site: {0}\nTên chứng chỉ: {1}\nTên miền: {2}\n\nThao tác sẽ liên hệ CA và tạo lineage do Certbot quản lý. ServerDesk dùng certonly và không tự sửa nginx. Tiếp tục?</system:String>
    <system:String x:Key="Loc.Tls.Obtaining">Đang cấp chứng chỉ và xác minh trạng thái Certbot, OpenSSL, nginx…</system:String>
    <system:String x:Key="Loc.Tls.ObtainSuccess">Đã cấp và xác minh chứng chỉ. Hãy gắn chứng chỉ vào nginx bằng trình sửa site được bảo vệ.</system:String>
    <system:String x:Key="Loc.Tls.ObtainFailed">Cấp chứng chỉ thất bại.</system:String>
    <system:String x:Key="Loc.Tls.SelectCertificate">Chọn một chứng chỉ do Certbot quản lý để gia hạn.</system:String>
    <system:String x:Key="Loc.Tls.SelectSite">Chọn một site nginx trước khi cấp chứng chỉ.</system:String>
    <system:String x:Key="Loc.Tls.SafetyFooter">Inventory TLS không bao giờ đọc nội dung private key. Trạng thái chứng chỉ dựa trên thời hạn được parse từ chứng chỉ, không dựa tên file.</system:String>
