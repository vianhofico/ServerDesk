<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <system:String x:Key="Loc.Env.WindowTitle">Environment Files</system:String>
    <system:String x:Key="Loc.Env.ActionTooltip">Inspect and edit one explicitly selected deployment environment file with secret masking and guarded apply</system:String>
    <system:String x:Key="Loc.Env.Title">Environment file on {0}</system:String>
    <system:String x:Key="Loc.Env.Subtitle">Explicit path only · secret values masked by default · raw content is never executed as shell</system:String>
    <system:String x:Key="Loc.Env.Path">Remote environment-file path</system:String>
    <system:String x:Key="Loc.Env.PathHint">Example: /srv/my-app/.env</system:String>
    <system:String x:Key="Loc.Env.Load">Load</system:String>
    <system:String x:Key="Loc.Env.Refresh">Refresh live file</system:String>
    <system:String x:Key="Loc.Env.Cancel">Cancel</system:String>
    <system:String x:Key="Loc.Env.Entries">Supported key/value entries</system:String>
    <system:String x:Key="Loc.Env.Line">Line</system:String>
    <system:String x:Key="Loc.Env.Key">Key</system:String>
    <system:String x:Key="Loc.Env.Value">Value</system:String>
    <system:String x:Key="Loc.Env.Secret">Secret</system:String>
    <system:String x:Key="Loc.Env.Yes">Yes</system:String>
    <system:String x:Key="Loc.Env.No">No</system:String>
    <system:String x:Key="Loc.Env.Reveal">Reveal selected</system:String>
    <system:String x:Key="Loc.Env.Hide">Hide selected</system:String>
    <system:String x:Key="Loc.Env.CopyValue">Copy value</system:String>
    <system:String x:Key="Loc.Env.SelectedEntry">Simple key/value editor</system:String>
    <system:String x:Key="Loc.Env.KeyHint">Key name</system:String>
    <system:String x:Key="Loc.Env.ValueHint">New value (the current secret is never prefilled)</system:String>
    <system:String x:Key="Loc.Env.SetValue">Set selected value</system:String>
    <system:String x:Key="Loc.Env.AddKey">Add key</system:String>
    <system:String x:Key="Loc.Env.DeleteKey">Delete selected</system:String>
    <system:String x:Key="Loc.Env.RawAdvanced">Raw advanced editor</system:String>
    <system:String x:Key="Loc.Env.RawWarningTitle">Reveal raw environment file?</system:String>
    <system:String x:Key="Loc.Env.RawWarningMessage">Raw mode displays every value, including secrets and unsupported syntax. Continue only if you need advanced editing. Saving still uses lost-update checks and atomic guarded apply.</system:String>
    <system:String x:Key="Loc.Env.RawEditor">Raw advanced content</system:String>
    <system:String x:Key="Loc.Env.RawEditorHint">Advanced mode preserves exactly what you type. ServerDesk never sources or executes this content.</system:String>
    <system:String x:Key="Loc.Env.Validator">Optional deployment validator</system:String>
    <system:String x:Key="Loc.Env.ValidatorExecutable">Executable</system:String>
    <system:String x:Key="Loc.Env.ValidatorExecutableHint">Example: docker</system:String>
    <system:String x:Key="Loc.Env.ValidatorArguments">Arguments — one token per line</system:String>
    <system:String x:Key="Loc.Env.ValidatorArgumentsHint">compose&#10;--env-file&#10;{file}&#10;config&#10;--quiet</system:String>
    <system:String x:Key="Loc.Env.ValidatorSafety">Only the typed {file} staged-path placeholder is supported. Shell interpreters are rejected.</system:String>
    <system:String x:Key="Loc.Env.Apply">Apply guarded changes</system:String>
    <system:String x:Key="Loc.Env.ApplyConfirmTitle">Apply environment-file changes?</system:String>
    <system:String x:Key="Loc.Env.ApplyConfirmMessage">Replace {0} with the staged candidate? {1} changed lines are detected. The live file is rechecked first and original mode/UID/GID must be preserved.</system:String>
    <system:String x:Key="Loc.Env.CopySecretTitle">Copy secret value?</system:String>
    <system:String x:Key="Loc.Env.CopySecretMessage">This places the selected secret value on the Windows clipboard. Clipboard contents may be visible to other applications. Continue?</system:String>
    <system:String x:Key="Loc.Env.RevealSecretTitle">Reveal secret value?</system:String>
    <system:String x:Key="Loc.Env.RevealSecretMessage">Reveal this secret in the ServerDesk window until it is hidden, edited, or refreshed?</system:String>
    <system:String x:Key="Loc.Env.DeleteConfirmTitle">Delete environment key?</system:String>
    <system:String x:Key="Loc.Env.DeleteConfirmMessage">Delete key {0} from the working candidate? Only this exact supported assignment line will be removed.</system:String>
    <system:String x:Key="Loc.Env.Loading">Loading the explicitly selected environment file…</system:String>
    <system:String x:Key="Loc.Env.Loaded">Loaded {0} supported entries.</system:String>
    <system:String x:Key="Loc.Env.Empty">The file contains no supported KEY=VALUE assignments.</system:String>
    <system:String x:Key="Loc.Env.LoadFailed">Unable to load the environment file.</system:String>
    <system:String x:Key="Loc.Env.Disconnected">Connect to the server before inspecting an environment file.</system:String>
    <system:String x:Key="Loc.Env.Cancelled">Operation cancelled.</system:String>
    <system:String x:Key="Loc.Env.NoChanges">There are no working changes to apply.</system:String>
    <system:String x:Key="Loc.Env.WorkingChanged">Working candidate changed. Live file has not been modified.</system:String>
    <system:String x:Key="Loc.Env.ApplyRunning">Rechecking the live file and applying the staged candidate…</system:String>
    <system:String x:Key="Loc.Env.ApplySuccess">Environment file applied and post-verified.</system:String>
    <system:String x:Key="Loc.Env.ApplyFailed">Environment-file apply failed.</system:String>
    <system:String x:Key="Loc.Env.ValidationFailed">The deployment validator rejected the staged file. Its output is hidden to protect secrets.</system:String>
    <system:String x:Key="Loc.Env.Ambiguous">Completion is ambiguous. Refresh the live file before any further mutation.</system:String>
    <system:String x:Key="Loc.Env.RefreshRequired">Refresh is required before Apply is enabled again.</system:String>
    <system:String x:Key="Loc.Env.UnsupportedWarning">Unsupported/raw lines are present. Simple edits preserve them unchanged; use raw advanced mode only when necessary.</system:String>
    <system:String x:Key="Loc.Env.SecretMasked">Secret-looking values are masked by default.</system:String>
    <system:String x:Key="Loc.Env.PathRequired">Enter an explicit absolute remote file path.</system:String>
    <system:String x:Key="Loc.Env.InvalidEdit">The simple edit is invalid. Use raw advanced mode for unsupported syntax.</system:String>
    <system:String x:Key="Loc.Env.Added">Key added to the working candidate.</system:String>
    <system:String x:Key="Loc.Env.Updated">Selected value updated in the working candidate.</system:String>
    <system:String x:Key="Loc.Env.Deleted">Selected key removed from the working candidate.</system:String>
    <system:String x:Key="Loc.Env.Copied">Value copied to the clipboard.</system:String>
    <system:String x:Key="Loc.Env.RawEnabled">Raw advanced editor revealed. All values are now visible in that editor.</system:String>
    <system:String x:Key="Loc.Env.SafetyFooter">ServerDesk does not discover env files broadly, execute env content, log values, or blindly retry uncertain writes.</system:String>
</ResourceDictionary>
