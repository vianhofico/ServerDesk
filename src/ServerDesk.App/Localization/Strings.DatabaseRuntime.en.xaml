    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Loc.DatabaseProfiles.DiagnosticsSearch">Search normalized diagnostics</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Loc.DatabaseProfiles.DiagnosticsKind">Type</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Loc.DatabaseProfiles.DiagnosticsName">Name</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Loc.DatabaseProfiles.DiagnosticsValue">Value</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Loc.DatabaseProfiles.DiagnosticsDetail">Detail</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Loc.DatabaseProfiles.DiagnosticsLoading">Opening the loopback SSH tunnel and loading bounded read-only engine diagnostics…</sys:String>
