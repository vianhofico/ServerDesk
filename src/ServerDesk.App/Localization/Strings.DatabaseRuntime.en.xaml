    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Loc.DatabaseProfiles.Disconnected">The server is disconnected. Saved profiles can still be edited, but SSH tunnel testing is unavailable until the server reconnects.</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Loc.DatabaseProfiles.LoadFailed">Database profiles could not be loaded: {0}</sys:String>
