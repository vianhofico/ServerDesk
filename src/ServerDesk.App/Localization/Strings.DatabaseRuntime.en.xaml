    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Loc.DatabaseProfiles.PasswordDisabledHint">No database password will be stored for this profile.</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Loc.DatabaseProfiles.InvalidSelection">Choose a supported database engine and authentication type.</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Loc.DatabaseProfiles.InvalidPort">Remote database port must be between 1 and 65535.</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Loc.DatabaseProfiles.SafetyFooter">M6.2 always creates an ephemeral local forward bound to 127.0.0.1 with an automatic local port. There is no silent direct/public database fallback. Tunnel testing checks TCP reachability only; authenticated engine diagnostics start in M6.3.</sys:String>
