    <system:String x:Key="Loc.Nginx.Editor.CanonicalPath">Resolved file</system:String>
    <system:String x:Key="Loc.Nginx.Editor.SimpleTab">Simple</system:String>
    <system:String x:Key="Loc.Nginx.Editor.RawTab">Raw</system:String>
