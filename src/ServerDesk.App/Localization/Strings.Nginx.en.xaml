    <system:String x:Key="Loc.Nginx.Editor.ConfirmTitle">Apply nginx configuration?</system:String>
    <system:String x:Key="Loc.Nginx.Editor.ConfirmMessage">This can reload nginx and affect active traffic. Target: {0}\n{1}\n\nServerDesk validates before replacement and will not blindly retry an ambiguous mutation. Continue?</system:String>
    <system:String x:Key="Loc.Nginx.Editor.ApplySuccess">nginx configuration applied and verified.</system:String>
    <system:String x:Key="Loc.Nginx.Editor.ValidationFailed">Candidate validation failed. The live nginx file was not replaced.</system:String>
    <system:String x:Key="Loc.Nginx.Editor.RolledBack">Apply failed deterministically and the previous nginx configuration was restored.</system:String>
    <system:String x:Key="Loc.Nginx.Editor.Ambiguous">Completion state is ambiguous. Do not retry until the live file and nginx runtime are refreshed.</system:String>
    <system:String x:Key="Loc.Nginx.Editor.ApplyFailed">nginx apply failed.</system:String>
    <system:String x:Key="Loc.Nginx.Editor.Cancelled">Operation cancelled.</system:String>
    <system:String x:Key="Loc.Nginx.Editor.LoadFailed">Unable to load the nginx file: {0}</system:String>
    <system:String x:Key="Loc.Nginx.Editor.Backup">Recovery backup: {0}</system:String>
