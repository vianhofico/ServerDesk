<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="Loc.DatabaseRestores.Open">Restore backup đã chọn</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.WindowTitle">Restore cơ sở dữ liệu có kiểm soát</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Title">Restore có kiểm soát — {0}</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Subtitle">Chỉ restore manifest đã xác minh đang được chọn vào đúng database identity đã lưu. Preview chỉ dùng một lần và trạng thái live được xác minh lại trước khi gửi thao tác destructive.</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Target">Đích restore chính xác</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Server">Server</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Engine">Engine</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.BackupId">ID backup đã xác minh</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.BackupPath">Đường dẫn backup đã xác minh</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.BackupSha">SHA-256</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.BackupSize">Kích thước đã xác minh</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.BackupTool">Tool backup</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.RestoreTool">Tool restore</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.LiveIdentity">Identity live của đích</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.LiveObjects">Số user object quan sát được</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Command">Lệnh restore chính xác</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Warning">Cảnh báo mất dữ liệu</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Rollback">Rollback</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.RollbackUnavailable">Workflow này không cam kết và không cung cấp rollback tự động.</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Preview">Preview và xác minh lại</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Execute">Thực thi restore destructive</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Close">Đóng</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Previewing">Đang xác minh lại backup đã verified, restore tool và đúng target live…</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.PreviewReady">Preview đã sẵn sàng. Kiểm tra toàn bộ identity và hệ quả mất dữ liệu trước khi thực thi.</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Executing">Đang thực thi restore destructive và sau đó xác minh lại đúng target…</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Success">Restore hoàn tất và identity chính xác của target đã được xác minh sau thao tác.</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Ambiguous">Trạng thái hoàn tất restore không xác định. Không retry. Hãy kiểm tra lại đúng target và backup đã xác minh được chọn trước mọi thao tác tiếp theo.</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Unsupported">Chế độ restore này chưa được chứng nhận. Không tạo lệnh destructive nào.</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Disconnected">Hãy kết nối server trước khi preview hoặc thực thi restore.</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Stale">Preview, backup đã xác minh, capability của tool hoặc đúng target đã thay đổi. Chưa gửi restore; hãy preview lại.</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.FailureAuth">Database từ chối credential đã lưu hoặc credential không thể được đọc an toàn. Chưa gửi restore.</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.FailurePermission">Database hoặc server từ chối thao tác restore bắt buộc.</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.FailureNetwork">Không thể truy cập đường SSH/database một cách tin cậy.</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.FailureCapability">Capability restore hoặc xác minh bắt buộc không có sẵn.</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.FailureUnexpected">Restore không thể hoàn tất hoặc xác minh một cách an toàn.</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.ConfirmTitle">Xác nhận restore database destructive</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Confirm">Đây là thao tác destructive và có thể ghi đè hoặc xóa dữ liệu.\n\nServer: {0}\nDatabase đích: {1}\nID backup đã xác minh: {2}\nĐường dẫn backup: {3}\nRestore tool: {4}\n\n{5}\n\nKhông có rollback tự động. Nếu trạng thái hoàn tất trở nên không xác định, ServerDesk sẽ KHÔNG tự động retry.\n\nThực thi đúng restore này?</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.SafetyFooter">An toàn: chỉ manifest đã xác minh đang được chọn mới có thể restore, và chỉ vào đúng database identity có trong cả profile lẫn manifest. Preview chỉ dùng một lần; checksum/cấu trúc backup, phiên bản restore tool và trạng thái target live được xác minh lại ngay trước dispatch. Credential chỉ đi qua sensitive stdin. Trạng thái destructive không xác định không bao giờ bị retry mù. Redis fail-closed.</sys:String>
</ResourceDictionary>
