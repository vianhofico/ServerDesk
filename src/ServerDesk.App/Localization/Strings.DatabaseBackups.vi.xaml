<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="Loc.DatabaseBackups.Open">Backup đã xác minh</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.WindowTitle">Backup cơ sở dữ liệu đã xác minh</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Title">Backup đã xác minh — {0}</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Subtitle">Tạo backup logic cho đúng database profile đã lưu và database/schema được chỉ định bên dưới. ServerDesk chỉ đánh dấu artifact là dùng được sau khi xác minh xác định kích thước, SHA-256 và cấu trúc theo từng engine.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.ProfileSummary">Profile: {0} · Engine: {1} · Đích: {2}:{3}</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.DatabaseName">Database / schema</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Destination">Thư mục đích trên server</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.DestinationHint">Dùng thư mục tuyệt đối đã tồn tại và đã chuẩn hóa, ví dụ /var/backups/serverdesk.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Create">Tạo và xác minh backup</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Refresh">Làm mới lịch sử</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Close">Đóng</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.HistoryTitle">Lịch sử backup đã xác minh</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.HistoryEmpty">Chưa có backup đã xác minh nào được ghi nhận cho database profile này.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Created">Thời điểm tạo</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Database">Database</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Path">Đường dẫn backup</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Format">Định dạng</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Tool">Tool / phiên bản</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Size">Kích thước</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Checksum">SHA-256</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Verified">Đã xác minh</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Loading">Đang tải lịch sử backup đã xác minh…</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Creating">Đang tạo đúng database backup và thu thập bằng chứng xác minh…</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Success">Backup đã xác minh thành công: {0}</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.SuccessHistoryFailed">Backup đã xác minh thành công tại {0}, nhưng không ghi được lịch sử xác minh cục bộ. Không chạy lại backup chỉ để sửa lịch sử.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Unsupported">Chế độ backup này chưa được chứng nhận. Không thử fallback không an toàn.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Ambiguous">Trạng thái hoàn tất backup không xác định. ServerDesk sẽ không tự động thử lại. Hãy kiểm tra đúng thư mục đích trước khi quyết định retry.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Disconnected">Hãy kết nối server trước khi tạo database backup.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.InvalidInput">Nhập rõ database/schema và một thư mục đích tuyệt đối, đã chuẩn hóa và đã tồn tại.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.FailureAuth">Database từ chối credential đã lưu. Không ghi nhận backup nào là đã xác minh.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.FailurePermission">Server hoặc database từ chối thao tác cần thiết để backup. Không ghi nhận backup nào là đã xác minh.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.FailureNetwork">Không thể truy cập database hoặc đường SSH một cách tin cậy. Không ghi nhận backup nào là đã xác minh.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.FailurePath">Đích backup hoặc thư mục đích được chỉ định không hợp lệ, không còn tồn tại hoặc đã thay đổi.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.FailureCapability">Capability backup/xác minh bắt buộc của engine không có sẵn hoặc chưa được hỗ trợ.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.FailureTimeout">Thao tác backup hết thời gian. Phải kiểm tra chính xác output trước mọi lần retry.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.FailureUnexpected">Database backup thất bại mà không có bằng chứng xác minh. Không artifact nào được hiển thị là an toàn/có thể restore.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.HistoryFailure">Không thể tải lịch sử backup đã xác minh.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.SafetyFooter">An toàn: thao tác này thay đổi filesystem trên server. Credential được truyền bằng sensitive stdin và không bao giờ xuất hiện trong command arguments, audit hoặc metadata backup. Chỉ artifact đã xác minh mới xuất hiện trong lịch sử. Trạng thái hoàn tất không xác định sẽ không bao giờ bị retry mù. Redis fail-closed cho đến khi semantics persistence-copy xác định được chứng nhận.</sys:String>
</ResourceDictionary>
