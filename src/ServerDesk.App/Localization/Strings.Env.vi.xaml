<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <system:String x:Key="Loc.Env.WindowTitle">Tệp môi trường</system:String>
    <system:String x:Key="Loc.Env.ActionTooltip">Kiểm tra và sửa một tệp môi trường triển khai được chọn rõ ràng với che secret và áp dụng có bảo vệ</system:String>
    <system:String x:Key="Loc.Env.Title">Tệp môi trường trên {0}</system:String>
    <system:String x:Key="Loc.Env.Subtitle">Chỉ đường dẫn chỉ định · secret được che mặc định · nội dung raw không bao giờ được chạy như shell</system:String>
    <system:String x:Key="Loc.Env.Path">Đường dẫn tệp môi trường trên server</system:String>
    <system:String x:Key="Loc.Env.PathHint">Ví dụ: /srv/my-app/.env</system:String>
    <system:String x:Key="Loc.Env.Load">Tải</system:String>
    <system:String x:Key="Loc.Env.Refresh">Tải lại tệp live</system:String>
    <system:String x:Key="Loc.Env.Cancel">Hủy</system:String>
    <system:String x:Key="Loc.Env.Entries">Các key/value được hỗ trợ</system:String>
    <system:String x:Key="Loc.Env.Line">Dòng</system:String>
    <system:String x:Key="Loc.Env.Key">Key</system:String>
    <system:String x:Key="Loc.Env.Value">Giá trị</system:String>
    <system:String x:Key="Loc.Env.Secret">Secret</system:String>
    <system:String x:Key="Loc.Env.Yes">Có</system:String>
    <system:String x:Key="Loc.Env.No">Không</system:String>
    <system:String x:Key="Loc.Env.Reveal">Hiện mục đã chọn</system:String>
    <system:String x:Key="Loc.Env.Hide">Che mục đã chọn</system:String>
    <system:String x:Key="Loc.Env.CopyValue">Sao chép giá trị</system:String>
    <system:String x:Key="Loc.Env.SelectedEntry">Trình sửa key/value đơn giản</system:String>
    <system:String x:Key="Loc.Env.KeyHint">Tên key</system:String>
    <system:String x:Key="Loc.Env.ValueHint">Giá trị mới (secret hiện tại không được tự điền)</system:String>
    <system:String x:Key="Loc.Env.SetValue">Đặt giá trị đã chọn</system:String>
    <system:String x:Key="Loc.Env.AddKey">Thêm key</system:String>
    <system:String x:Key="Loc.Env.DeleteKey">Xóa mục đã chọn</system:String>
    <system:String x:Key="Loc.Env.RawAdvanced">Trình sửa raw nâng cao</system:String>
    <system:String x:Key="Loc.Env.RawWarningTitle">Hiện toàn bộ tệp môi trường raw?</system:String>
    <system:String x:Key="Loc.Env.RawWarningMessage">Chế độ raw hiển thị mọi giá trị, gồm cả secret và cú pháp chưa hỗ trợ. Chỉ tiếp tục khi cần sửa nâng cao. Khi lưu vẫn có kiểm tra lost-update và áp dụng atomic có bảo vệ.</system:String>
    <system:String x:Key="Loc.Env.RawEditor">Nội dung raw nâng cao</system:String>
    <system:String x:Key="Loc.Env.RawEditorHint">Chế độ nâng cao giữ đúng nội dung bạn nhập. ServerDesk không bao giờ source hoặc thực thi nội dung này.</system:String>
    <system:String x:Key="Loc.Env.Validator">Validator triển khai tùy chọn</system:String>
    <system:String x:Key="Loc.Env.ValidatorExecutable">Executable</system:String>
    <system:String x:Key="Loc.Env.ValidatorExecutableHint">Ví dụ: docker</system:String>
    <system:String x:Key="Loc.Env.ValidatorArguments">Tham số — mỗi dòng là một token</system:String>
    <system:String x:Key="Loc.Env.ValidatorArgumentsHint">compose&#10;--env-file&#10;{file}&#10;config&#10;--quiet</system:String>
    <system:String x:Key="Loc.Env.ValidatorSafety">Chỉ hỗ trợ placeholder đường dẫn staged {file}. Các shell interpreter sẽ bị từ chối.</system:String>
    <system:String x:Key="Loc.Env.Apply">Áp dụng thay đổi có bảo vệ</system:String>
    <system:String x:Key="Loc.Env.ApplyConfirmTitle">Áp dụng thay đổi tệp môi trường?</system:String>
    <system:String x:Key="Loc.Env.ApplyConfirmMessage">Thay {0} bằng candidate staged? Phát hiện {1} dòng thay đổi. Tệp live sẽ được kiểm tra lại trước và mode/UID/GID ban đầu phải được giữ nguyên.</system:String>
    <system:String x:Key="Loc.Env.CopySecretTitle">Sao chép secret?</system:String>
    <system:String x:Key="Loc.Env.CopySecretMessage">Thao tác này đặt secret đã chọn vào clipboard Windows. Ứng dụng khác có thể đọc clipboard. Tiếp tục?</system:String>
    <system:String x:Key="Loc.Env.RevealSecretTitle">Hiện secret?</system:String>
    <system:String x:Key="Loc.Env.RevealSecretMessage">Hiện secret này trong cửa sổ ServerDesk cho tới khi bạn che lại, sửa hoặc tải lại?</system:String>
    <system:String x:Key="Loc.Env.DeleteConfirmTitle">Xóa key môi trường?</system:String>
    <system:String x:Key="Loc.Env.DeleteConfirmMessage">Xóa key {0} khỏi candidate đang sửa? Chỉ đúng dòng assignment được hỗ trợ này sẽ bị xóa.</system:String>
    <system:String x:Key="Loc.Env.Loading">Đang tải tệp môi trường được chọn rõ ràng…</system:String>
    <system:String x:Key="Loc.Env.Loaded">Đã tải {0} mục được hỗ trợ.</system:String>
    <system:String x:Key="Loc.Env.Empty">Tệp không có assignment KEY=VALUE được hỗ trợ.</system:String>
    <system:String x:Key="Loc.Env.LoadFailed">Không thể tải tệp môi trường.</system:String>
    <system:String x:Key="Loc.Env.Disconnected">Hãy kết nối server trước khi kiểm tra tệp môi trường.</system:String>
    <system:String x:Key="Loc.Env.Cancelled">Đã hủy thao tác.</system:String>
    <system:String x:Key="Loc.Env.NoChanges">Không có thay đổi nào để áp dụng.</system:String>
    <system:String x:Key="Loc.Env.WorkingChanged">Candidate đang sửa đã thay đổi. Tệp live chưa bị sửa.</system:String>
    <system:String x:Key="Loc.Env.ApplyRunning">Đang kiểm tra lại tệp live và áp dụng candidate staged…</system:String>
    <system:String x:Key="Loc.Env.ApplySuccess">Đã áp dụng và kiểm tra lại tệp môi trường.</system:String>
    <system:String x:Key="Loc.Env.ApplyFailed">Áp dụng tệp môi trường thất bại.</system:String>
    <system:String x:Key="Loc.Env.ValidationFailed">Validator triển khai đã từ chối tệp staged. Output được ẩn để bảo vệ secret.</system:String>
    <system:String x:Key="Loc.Env.Ambiguous">Không xác định chắc trạng thái hoàn tất. Hãy tải lại tệp live trước mọi mutation tiếp theo.</system:String>
    <system:String x:Key="Loc.Env.RefreshRequired">Phải tải lại trước khi nút Áp dụng được bật lại.</system:String>
    <system:String x:Key="Loc.Env.UnsupportedWarning">Có dòng raw/chưa hỗ trợ. Sửa đơn giản sẽ giữ nguyên chúng; chỉ dùng chế độ raw nâng cao khi cần.</system:String>
    <system:String x:Key="Loc.Env.SecretMasked">Các giá trị trông giống secret được che mặc định.</system:String>
    <system:String x:Key="Loc.Env.PathRequired">Nhập đường dẫn tuyệt đối rõ ràng tới tệp trên server.</system:String>
    <system:String x:Key="Loc.Env.InvalidEdit">Thay đổi đơn giản không hợp lệ. Hãy dùng chế độ raw nâng cao cho cú pháp chưa hỗ trợ.</system:String>
    <system:String x:Key="Loc.Env.Added">Đã thêm key vào candidate đang sửa.</system:String>
    <system:String x:Key="Loc.Env.Updated">Đã cập nhật giá trị đã chọn trong candidate đang sửa.</system:String>
    <system:String x:Key="Loc.Env.Deleted">Đã xóa key đã chọn khỏi candidate đang sửa.</system:String>
    <system:String x:Key="Loc.Env.Copied">Đã sao chép giá trị vào clipboard.</system:String>
    <system:String x:Key="Loc.Env.RawEnabled">Đã mở trình sửa raw nâng cao. Mọi giá trị hiện đang hiển thị trong trình sửa đó.</system:String>
    <system:String x:Key="Loc.Env.SafetyFooter">ServerDesk không tự quét rộng tệp env, không thực thi nội dung env, không ghi log giá trị và không tự retry khi trạng thái ghi không chắc chắn.</system:String>
</ResourceDictionary>
