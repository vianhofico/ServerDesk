    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Loc.DatabaseProfiles.DiagnosticsFailureNetwork">Không thể truy cập cơ sở dữ liệu qua SSH tunnel loopback.</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Loc.DatabaseProfiles.DiagnosticsFailureCapability">Engine hoặc database đã chọn không cung cấp khả năng chẩn đoán an toàn bắt buộc.</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Loc.DatabaseProfiles.DiagnosticsFailureParse">Không thể chuẩn hóa phản hồi của engine một cách an toàn.</sys:String>
