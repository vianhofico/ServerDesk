    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Loc.DatabaseProfiles.DiagnosticsFailureAuthentication">Cơ sở dữ liệu từ chối thông tin xác thực đã lưu.</sys:String>
