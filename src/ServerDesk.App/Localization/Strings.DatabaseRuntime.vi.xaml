    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Loc.DatabaseProfiles.DiagnosticsCancelled">Đã hủy chẩn đoán cơ sở dữ liệu.</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Loc.DatabaseProfiles.DiagnosticsEmpty">Chọn hồ sơ đã lưu rồi nhấn Kiểm tra chỉ đọc.</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Loc.DatabaseProfiles.DiagnosticsSummaryFormat">{0} {1} · danh tính {2} · ghi nhận {3}</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Loc.DatabaseProfiles.DiagnosticsTruncated">Engine trả về nhiều catalog hơn giới hạn cấu hình. Chỉ tập dữ liệu đầu tiên trong giới hạn được hiển thị.</sys:String>
