    <system:String x:Key="Loc.FirewallMutation.ImpactUnknown">không xác định</system:String>
    <system:String x:Key="Loc.FirewallMutation.ImpactNoKnownRestriction">chưa phát hiện hạn chế trực tiếp</system:String>
