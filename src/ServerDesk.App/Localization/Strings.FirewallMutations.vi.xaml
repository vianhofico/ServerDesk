    <system:String x:Key="Loc.FirewallMutation.NoSelectedRule">Không có rule chuẩn hóa nào được chọn khi mở màn hình này.</system:String>
    <system:String x:Key="Loc.FirewallMutation.InvalidRequest">Yêu cầu thay đổi tường lửa không hợp lệ.</system:String>
