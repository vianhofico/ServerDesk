<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="Loc.DatabaseBackups.Open">Verified backups</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.WindowTitle">Verified database backups</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Title">Verified backups — {0}</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Subtitle">Create a logical backup for the exact saved database profile and explicit database/schema below. ServerDesk marks an artifact usable only after deterministic size, SHA-256, and engine-specific structural verification.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.ProfileSummary">Profile: {0} · Engine: {1} · Target: {2}:{3}</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.DatabaseName">Database / schema</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Destination">Remote destination directory</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.DestinationHint">Use an existing normalized absolute directory, for example /var/backups/serverdesk.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Create">Create and verify backup</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Refresh">Refresh history</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Close">Close</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.HistoryTitle">Verified backup history</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.HistoryEmpty">No verified backups are recorded for this database profile.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Created">Created</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Database">Database</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Path">Backup path</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Format">Format</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Tool">Tool / version</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Size">Size</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Checksum">SHA-256</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Verified">Verified</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Loading">Loading verified backup history…</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Creating">Creating the exact database backup and collecting verification evidence…</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Success">Backup verified successfully: {0}</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.SuccessHistoryFailed">Backup verified successfully at {0}, but local verified-history persistence failed. Do not repeat the backup solely to repair history.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Unsupported">This backup mode is not certified. No unsafe fallback was attempted.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Ambiguous">Backup completion is ambiguous. ServerDesk will not retry automatically. Inspect the exact destination before deciding whether to retry.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.Disconnected">Connect to this server before creating a database backup.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.InvalidInput">Enter an explicit database/schema and an existing normalized absolute destination directory.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.FailureAuth">The database rejected the stored credential. No verified backup was recorded.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.FailurePermission">The server or database denied a required backup operation. No verified backup was recorded.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.FailureNetwork">The database or SSH path could not be reached reliably. No verified backup was recorded.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.FailurePath">The explicit backup target or destination is invalid, missing, or changed.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.FailureCapability">The required engine backup/verification capability is unavailable or unsupported.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.FailureTimeout">The backup operation timed out. Its exact output must be inspected before any retry.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.FailureUnexpected">Database backup failed without verified evidence. No artifact is presented as safe/restorable.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.HistoryFailure">Verified backup history could not be loaded.</sys:String>
    <sys:String x:Key="Loc.DatabaseBackups.SafetyFooter">Safety: this operation mutates the remote filesystem. Credentials are supplied through sensitive stdin and are never shown in command arguments, audit, or backup metadata. Only verified artifacts appear in history. Ambiguous completion is never blindly retried. Redis fails closed unless deterministic persistence-copy semantics are certified.</sys:String>
</ResourceDictionary>
