<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <system:String x:Key="Loc.Shell.Header.ProductStatus">Không gian V1</system:String>
    <system:String x:Key="Loc.Shell.Header.Server">Máy chủ hiện tại</system:String>
    <system:String x:Key="Loc.Shell.Header.NoServer">Chưa chọn máy chủ</system:String>
    <system:String x:Key="Loc.Shell.Header.NoServerHint">Chọn một máy chủ để bật các công cụ theo máy chủ.</system:String>
    <system:String x:Key="Loc.Shell.ServerPane.Title">Máy chủ</system:String>
    <system:String x:Key="Loc.Shell.ServerPane.GlobalDashboard">Tổng quan toàn bộ</system:String>
    <system:String x:Key="Loc.Shell.Workspace.Title">Không gian làm việc</system:String>
    <system:String x:Key="Loc.Shell.Workspace.RequiresServer">Chọn một máy chủ để dùng công cụ này.</system:String>
    <system:String x:Key="Loc.Shell.Home.Title">Không gian máy chủ</system:String>
    <system:String x:Key="Loc.Shell.Home.Description">Luôn giữ thông tin máy chủ trong tầm nhìn và mở công cụ cần dùng từ thanh điều hướng.</system:String>
    <system:String x:Key="Loc.Shell.Empty.Title">Thêm máy chủ đầu tiên</system:String>
    <system:String x:Key="Loc.Shell.Empty.Description">Tạo hồ sơ cục bộ an toàn rồi kết nối qua SSH mà không cần mở dịch vụ quản trị công khai.</system:String>
    <system:String x:Key="Loc.Shell.Profile.Title">Hồ sơ máy chủ</system:String>
    <system:String x:Key="Loc.Shell.Profile.Description">Metadata kết nối được lưu cục bộ. Mật khẩu và passphrase hiện có không bao giờ được nạp ngược vào biểu mẫu này.</system:String>
    <system:String x:Key="Loc.Shell.Profile.DisplayName">Tên hiển thị</system:String>
    <system:String x:Key="Loc.Shell.Profile.Environment">Môi trường</system:String>
    <system:String x:Key="Loc.Shell.Profile.Host">Host / IP</system:String>
    <system:String x:Key="Loc.Shell.Profile.Port">Cổng</system:String>
    <system:String x:Key="Loc.Shell.Profile.Username">Tên đăng nhập</system:String>
    <system:String x:Key="Loc.Shell.Profile.Authentication">Xác thực</system:String>
    <system:String x:Key="Loc.Shell.Profile.PrivateKeyPath">Đường dẫn private key</system:String>
    <system:String x:Key="Loc.Shell.Profile.PrivateKeyHint">Chỉ lưu đường dẫn dưới dạng metadata; ServerDesk không sao chép nội dung private key vào SQLite.</system:String>
    <system:String x:Key="Loc.Shell.Profile.SecretSafety">Mật khẩu và passphrase được lưu trong Windows Credential Manager. Danh tính máy chủ được xác minh trước khi credential SSH được gửi tới endpoint từ xa.</system:String>
    <system:String x:Key="Loc.Shell.Profile.Save">Lưu máy chủ</system:String>
    <system:String x:Key="Loc.Shell.Server.Environment">Môi trường</system:String>
    <system:String x:Key="Loc.Shell.Server.Authentication">Xác thực</system:String>
    <system:String x:Key="Loc.Shell.Server.Connection">Kết nối</system:String>
    <system:String x:Key="Loc.Shell.Server.ConnectedSince">Kết nối từ</system:String>
    <system:String x:Key="Loc.Shell.Server.Version">Phiên bản máy chủ</system:String>
    <system:String x:Key="Loc.Shell.Server.Edit">Sửa</system:String>
    <system:String x:Key="Loc.Shell.Server.Delete">Xóa</system:String>
    <system:String x:Key="Loc.Shell.Delete.Title">Xóa hồ sơ máy chủ này?</system:String>
    <system:String x:Key="Loc.Shell.Delete.Description">Hồ sơ cục bộ và credential đã lưu trong Windows sẽ cùng bị xóa. Cần ngắt kết nối trước khi xóa hồ sơ đang kết nối.</system:String>
    <system:String x:Key="Loc.Shell.Security.Title">Ranh giới bảo mật</system:String>
    <system:String x:Key="Loc.Shell.Security.Description">Secret nằm trong Windows Credential Manager. Tin cậy host và metadata không nhạy cảm nằm cục bộ. Điều khiển từ xa vẫn ưu tiên SSH.</system:String>

    <system:String x:Key="Loc.Shell.Group.Overview">TỔNG QUAN</system:String>
    <system:String x:Key="Loc.Shell.Group.Work">LÀM VIỆC</system:String>
    <system:String x:Key="Loc.Shell.Group.Operate">VẬN HÀNH</system:String>
    <system:String x:Key="Loc.Shell.Group.Deploy">TRIỂN KHAI</system:String>
    <system:String x:Key="Loc.Shell.Group.Admin">QUẢN TRỊ</system:String>
    <system:String x:Key="Loc.Shell.Group.Server">MÁY CHỦ</system:String>

    <system:String x:Key="Loc.Shell.Nav.GlobalDashboard">Tổng quan toàn bộ</system:String>
    <system:String x:Key="Loc.Shell.Nav.GlobalDashboard.Description">So sánh các máy chủ đã lưu và xem nhanh sức khỏe nhiều máy chủ.</system:String>
    <system:String x:Key="Loc.Shell.Nav.Dashboard">Dashboard</system:String>
    <system:String x:Key="Loc.Shell.Nav.Dashboard.Description">Mở CPU, bộ nhớ, tải, uptime, mạng và sức khỏe filesystem của máy chủ đã chọn.</system:String>
    <system:String x:Key="Loc.Shell.Nav.Explorer">Explorer</system:String>
    <system:String x:Key="Loc.Shell.Nav.Explorer.Description">Duyệt và quản lý file từ xa qua kênh SFTP đã được chứng nhận.</system:String>
    <system:String x:Key="Loc.Shell.Nav.Terminal">Terminal</system:String>
    <system:String x:Key="Loc.Shell.Nav.Terminal.Description">Mở terminal SSH PTY thực cho máy chủ đã chọn.</system:String>
    <system:String x:Key="Loc.Shell.Nav.Processes">Tiến trình</system:String>
    <system:String x:Key="Loc.Shell.Nav.Processes.Description">Kiểm tra tiến trình và chạy các thao tác vòng đời có bảo vệ.</system:String>
    <system:String x:Key="Loc.Shell.Nav.Services">Dịch vụ</system:String>
    <system:String x:Key="Loc.Shell.Nav.Services.Description">Kiểm tra dịch vụ systemd và các thao tác vòng đời có xác minh.</system:String>
    <system:String x:Key="Loc.Shell.Nav.Docker">Docker</system:String>
    <system:String x:Key="Loc.Shell.Nav.Docker.Description">Kiểm tra tài nguyên Docker, Compose project và thao tác container có bảo vệ.</system:String>
    <system:String x:Key="Loc.Shell.Nav.Storage">Lưu trữ</system:String>
    <system:String x:Key="Loc.Shell.Nav.Storage.Description">Kiểm tra filesystem, block device và phân tích thư mục chỉ đọc.</system:String>
    <system:String x:Key="Loc.Shell.Nav.Network">Mạng</system:String>
    <system:String x:Key="Loc.Shell.Nav.Network.Description">Kiểm tra interface, lưu lượng và cổng đang lắng nghe.</system:String>
    <system:String x:Key="Loc.Shell.Nav.Logs">Log</system:String>
    <system:String x:Key="Loc.Shell.Nav.Logs.Description">Xem journald hoặc log text từ xa với bộ lọc và chế độ theo dõi.</system:String>
    <system:String x:Key="Loc.Shell.Nav.Tunnels">Tunnel</system:String>
    <system:String x:Key="Loc.Shell.Nav.Tunnels.Description">Quản lý SSH port forwarding local, remote và SOCKS5.</system:String>
    <system:String x:Key="Loc.Shell.Nav.ScheduledTasks">Tác vụ định kỳ</system:String>
    <system:String x:Key="Loc.Shell.Nav.ScheduledTasks.Description">Kiểm tra và quản lý workflow cron và systemd timer được hỗ trợ.</system:String>
    <system:String x:Key="Loc.Shell.Nav.Git">Git</system:String>
    <system:String x:Key="Loc.Shell.Nav.Git.Description">Kiểm tra repository, fetch chủ động và áp dụng cập nhật fast-forward có bảo vệ.</system:String>
    <system:String x:Key="Loc.Shell.Nav.Nginx">Nginx</system:String>
    <system:String x:Key="Loc.Shell.Nav.Nginx.Description">Kiểm tra site và dùng workflow cấu hình có validation.</system:String>
    <system:String x:Key="Loc.Shell.Nav.Tls">Chứng chỉ TLS</system:String>
    <system:String x:Key="Loc.Shell.Nav.Tls.Description">Kiểm tra trạng thái chứng chỉ và các workflow chứng chỉ có bảo vệ.</system:String>
    <system:String x:Key="Loc.Shell.Nav.EnvironmentFiles">File môi trường</system:String>
    <system:String x:Key="Loc.Shell.Nav.EnvironmentFiles.Description">Kiểm tra và sửa file môi trường với xử lý secret an toàn.</system:String>
    <system:String x:Key="Loc.Shell.Nav.Deployment">Triển khai</system:String>
    <system:String x:Key="Loc.Shell.Nav.Deployment.Description">Chạy workflow triển khai có preview, chủ động và được xác minh.</system:String>
    <system:String x:Key="Loc.Shell.Nav.Firewall">Tường lửa</system:String>
    <system:String x:Key="Loc.Shell.Nav.Firewall.Description">Kiểm tra và quản lý rule UFW hoặc firewalld được hỗ trợ.</system:String>
    <system:String x:Key="Loc.Shell.Nav.Users">Người dùng &amp; truy cập</system:String>
    <system:String x:Key="Loc.Shell.Nav.Users.Description">Quản lý user, group và SSH authorized key trong phạm vi được hỗ trợ.</system:String>
    <system:String x:Key="Loc.Shell.Nav.Packages">Gói phần mềm</system:String>
    <system:String x:Key="Loc.Shell.Nav.Packages.Description">Kiểm tra inventory APT/DNF và chạy thao tác package có bảo vệ.</system:String>
    <system:String x:Key="Loc.Shell.Nav.Databases">Database runtime</system:String>
    <system:String x:Key="Loc.Shell.Nav.Databases.Description">Kiểm tra runtime và diagnostics database được chứng nhận qua adapter an toàn trên SSH.</system:String>
    <system:String x:Key="Loc.Shell.Nav.DatabaseProfiles">Hồ sơ database</system:String>
    <system:String x:Key="Loc.Shell.Nav.DatabaseProfiles.Description">Quản lý metadata kết nối database không chứa secret cho máy chủ đã chọn.</system:String>
    <system:String x:Key="Loc.Shell.Nav.Backups">Sao lưu</system:String>
    <system:String x:Key="Loc.Shell.Nav.Backups.Description">Chạy workflow backup và restore có audit trong phạm vi được chứng nhận.</system:String>
    <system:String x:Key="Loc.Shell.Nav.OperationHistory">Lịch sử thao tác</system:String>
    <system:String x:Key="Loc.Shell.Nav.OperationHistory.Description">Xem các thao tác đã audit mà không lộ secret.</system:String>
    <system:String x:Key="Loc.Shell.Nav.Organize">Sắp xếp máy chủ</system:String>
    <system:String x:Key="Loc.Shell.Nav.Organize.Description">Quản lý group, tag, favorite và lọc máy chủ đã lưu.</system:String>
    <system:String x:Key="Loc.Shell.Nav.ConnectionHistory">Lịch sử kết nối</system:String>
    <system:String x:Key="Loc.Shell.Nav.ConnectionHistory.Description">Xem các lần thử kết nối SSH gần đây mà không lộ secret.</system:String>
    <system:String x:Key="Loc.Shell.Nav.ConnectionRoute">Tuyến kết nối</system:String>
    <system:String x:Key="Loc.Shell.Nav.ConnectionRoute.Description">Chọn kết nối trực tiếp, proxy hoặc SSH bastion cho máy chủ đã chọn.</system:String>
</ResourceDictionary>
