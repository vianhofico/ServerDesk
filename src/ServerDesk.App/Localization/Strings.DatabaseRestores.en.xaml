<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="Loc.DatabaseRestores.Open">Restore selected backup</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.WindowTitle">Guarded database restore</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Title">Guarded restore — {0}</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Subtitle">Restore only the selected verified manifest to the exact saved database identity. Preview is single-use and live state is revalidated before destructive dispatch.</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Target">Exact restore target</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Server">Server</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Engine">Engine</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.BackupId">Verified backup ID</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.BackupPath">Verified backup path</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.BackupSha">SHA-256</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.BackupSize">Verified size</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.BackupTool">Backup tool</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.RestoreTool">Restore tool</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.LiveIdentity">Live target identity</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.LiveObjects">Observed user objects</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Command">Exact restore command</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Warning">Data-loss warning</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Rollback">Rollback</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.RollbackUnavailable">No automatic rollback is claimed or available for this workflow.</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Preview">Preview and revalidate</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Execute">Execute destructive restore</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Close">Close</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Previewing">Revalidating the verified backup, restore tool and exact live target…</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.PreviewReady">Preview ready. Review every identity and data-loss implication before executing.</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Executing">Executing the destructive restore and then post-verifying the exact target…</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Success">Restore completed and the exact target identity was post-verified.</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Ambiguous">Restore completion is ambiguous. Do not retry. Re-inspect the exact target and selected verified backup before any next action.</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Unsupported">This restore mode is not certified. No destructive command was generated.</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Disconnected">Connect to this server before previewing or executing a restore.</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Stale">The preview, verified backup, tool capability or exact target changed. No restore was sent; preview again.</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.FailureAuth">The database rejected or could not securely load the saved credential. No restore was sent.</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.FailurePermission">The database or server denied a required restore operation.</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.FailureNetwork">The SSH/database path could not be reached reliably.</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.FailureCapability">A required restore or verification capability is unavailable.</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.FailureUnexpected">Restore could not be safely completed or verified.</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.ConfirmTitle">Confirm destructive database restore</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.Confirm">This is destructive and may overwrite or drop data.\n\nServer: {0}\nTarget database: {1}\nVerified backup ID: {2}\nBackup path: {3}\nRestore tool: {4}\n\n{5}\n\nNo automatic rollback is available. If completion becomes ambiguous, ServerDesk will NOT retry automatically.\n\nExecute this exact restore?</sys:String>
    <sys:String x:Key="Loc.DatabaseRestores.SafetyFooter">Safety: only a selected verified manifest can be restored, only to the exact database identity saved in both profile and manifest. Preview is single-use; backup checksum/structure, restore-tool version and live target state are revalidated immediately before dispatch. Credentials stay in sensitive stdin. Ambiguous destructive completion is never blindly retried. Redis fails closed.</sys:String>
</ResourceDictionary>
