<Window x:Class="ServerDesk.App.OperationHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.OperationHistory.WindowTitle}"
        Width="1440" Height="840" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource Loc.OperationHistory.Title}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Loc.OperationHistory.Subtitle}"
                       Margin="0,4,0,0" Opacity="0.72" TextWrapping="Wrap" />
            <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource Loc.OperationHistory.Search}" />
                <TextBox x:Name="SearchTextBox" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{DynamicResource Loc.OperationHistory.Server}" />
                <ComboBox x:Name="ServerComboBox" Margin="0,4,0,0" DisplayMemberPath="Text" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="{DynamicResource Loc.OperationHistory.Category}" />
                <TextBox x:Name="CategoryTextBox" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="6">
                <TextBlock Text="{DynamicResource Loc.OperationHistory.DatabaseEngine}" />
                <ComboBox x:Name="DatabaseEngineComboBox" Margin="0,4,0,0" DisplayMemberPath="Text" />
            </StackPanel>
            <StackPanel Grid.Column="8">
                <TextBlock Text="{DynamicResource Loc.OperationHistory.Limit}" />
                <ComboBox x:Name="LimitComboBox" Margin="0,4,0,0" />
            </StackPanel>

            <Grid Grid.Row="1" Grid.ColumnSpan="9" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Loc.OperationHistory.Risk}" />
                    <ComboBox x:Name="RiskComboBox" Margin="0,4,0,0" DisplayMemberPath="Text" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Loc.OperationHistory.Outcome}" />
                    <ComboBox x:Name="OutcomeComboBox" Margin="0,4,0,0" DisplayMemberPath="Text" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="{DynamicResource Loc.OperationHistory.FromDate}" />
                    <DatePicker x:Name="FromDatePicker" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="{DynamicResource Loc.OperationHistory.ToDate}" />
                    <DatePicker x:Name="ToDatePicker" Margin="0,4,0,0" />
                </StackPanel>
                <CheckBox x:Name="DatabaseOnlyCheckBox"
                          Grid.Column="8"
                          Content="{DynamicResource Loc.OperationHistory.DatabaseOnly}"
                          VerticalAlignment="Bottom"
                          Margin="0,0,0,8" />
                <StackPanel Grid.Column="10" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="LoadButton" Content="{DynamicResource Loc.OperationHistory.Load}"
                            Padding="14,7" Click="LoadOnClick" />
                    <Button Content="{DynamicResource Loc.OperationHistory.ClearFilters}"
                            Margin="8,0,0,0" Padding="14,7" Click="ClearFiltersOnClick" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="HistoryGrid" Grid.Column="0"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      ScrollViewer.CanContentScroll="True"
                      SelectionChanged="HistorySelectionChanged">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasUnknownRemoteState}" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Loc.OperationHistory.Time}" Binding="{Binding OccurredAtLocal}" Width="150" />
                    <DataGridTextColumn Header="{DynamicResource Loc.OperationHistory.Server}" Binding="{Binding ServerName}" Width="135" />
                    <DataGridTextColumn Header="{DynamicResource Loc.OperationHistory.DatabaseEngine}" Binding="{Binding DatabaseEngine}" Width="105" />
                    <DataGridTextColumn Header="{DynamicResource Loc.OperationHistory.Database}" Binding="{Binding DatabaseName}" Width="125" />
                    <DataGridTextColumn Header="{DynamicResource Loc.OperationHistory.Category}" Binding="{Binding Category}" Width="145" />
                    <DataGridTextColumn Header="{DynamicResource Loc.OperationHistory.Risk}" Binding="{Binding RiskDisplay}" Width="100" />
                    <DataGridTextColumn Header="{DynamicResource Loc.OperationHistory.Outcome}" Binding="{Binding OutcomeDisplay}" Width="135" />
                    <DataGridTextColumn Header="{DynamicResource Loc.OperationHistory.Summary}" Binding="{Binding Summary}" Width="3*" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" BorderThickness="1" BorderBrush="#22000000" CornerRadius="6" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.OperationHistory.Details}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Loc.OperationHistory.KnownFacts}" FontWeight="SemiBold" Margin="0,12,0,4" />
                        <TextBlock x:Name="KnownFactsText" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource Loc.OperationHistory.Verification}" FontWeight="SemiBold" Margin="0,12,0,4" />
                        <TextBlock x:Name="VerificationText" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource Loc.OperationHistory.UnknownFacts}" FontWeight="SemiBold" Margin="0,12,0,4" />
                        <TextBlock x:Name="UnknownFactsText" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource Loc.OperationHistory.TargetMetadata}" FontWeight="SemiBold" Margin="0,12,0,4" />
                        <TextBox x:Name="TargetTextBox" IsReadOnly="True" MinHeight="70" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="{DynamicResource Loc.OperationHistory.Footer}"
                   Margin="0,12,0,0" Opacity="0.68" TextWrapping="Wrap" />
    </Grid>
</Window>