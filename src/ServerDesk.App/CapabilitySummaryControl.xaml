<UserControl x:Class="ServerDesk.App.CapabilitySummaryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Border Padding="16"
            CornerRadius="9"
            Background="{DynamicResource SurfaceSecondaryBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Linux capabilities" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Margin="0,3,0,0"
                               Text="{Binding SummaryText}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Refresh capabilities"
                        Click="RefreshOnClick"
                        IsEnabled="{Binding CanRefresh}"
                        Style="{StaticResource SecondaryButton}" />
            </Grid>

            <ProgressBar Margin="0,12,0,0"
                         Height="3"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <Grid Margin="0,14,0,0"
                  Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="10" Margin="0,0,5,0" CornerRadius="7"
                        Background="{DynamicResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="Operating system" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding OperatingSystem}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="10" Margin="5,0" CornerRadius="7"
                        Background="{DynamicResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="Architecture / kernel" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding ArchitectureKernel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="10" Margin="5,0,0,0" CornerRadius="7"
                        Background="{DynamicResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="Remote identity" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding RemoteIdentity}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <ItemsControl Margin="0,10,0,0"
                          ItemsSource="{Binding CapabilityRows}"
                          Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="9,7"
                                Margin="0,2,0,0"
                                CornerRadius="6"
                                Background="{DynamicResource SurfaceBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="125" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding StatusText}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding DetailText}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="0,9,0,0"
                       Text="{Binding CapturedText}"
                       FontSize="10"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Border>
</UserControl>
