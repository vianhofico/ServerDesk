<Window x:Class="ServerDesk.App.DatabaseProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.DatabaseProfiles.WindowTitle}"
        Width="1320"
        Height="820"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Loc.DatabaseProfiles.Subtitle}"
                           Margin="0,4,0,0"
                           Opacity="0.72"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="{DynamicResource Loc.DatabaseProfiles.Refresh}"
                    MinWidth="92"
                    Padding="14,7"
                    Click="RefreshOnClick" />
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Margin="0,10,0,12"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="{DynamicResource Loc.DatabaseProfiles.New}"
                            MinWidth="86"
                            Padding="12,6"
                            Click="NewOnClick" />
                    <Button Content="{DynamicResource Loc.DatabaseProfiles.Delete}"
                            MinWidth="86"
                            Padding="12,6"
                            Margin="8,0,0,0"
                            Click="DeleteOnClick" />
                    <Button x:Name="TestTunnelButton"
                            Content="{DynamicResource Loc.DatabaseProfiles.TestTunnel}"
                            MinWidth="120"
                            Padding="12,6"
                            Margin="8,0,0,0"
                            Click="TestTunnelOnClick" />
                    <Button x:Name="InspectButton"
                            Content="{DynamicResource Loc.DatabaseProfiles.Inspect}"
                            MinWidth="126"
                            Padding="12,6"
                            Margin="8,0,0,0"
                            Click="InspectOnClick" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        Margin="0,12,0,0"
                        BorderThickness="1"
                        BorderBrush="#22000000"
                        CornerRadius="6"
                        Padding="12"
                        Height="290">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc.DatabaseProfiles.DiagnosticsTitle}"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="DiagnosticsSummaryText"
                                           Margin="0,3,12,0"
                                           Opacity="0.7"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBox x:Name="DiagnosticsSearchBox"
                                     Grid.Column="1"
                                     VerticalAlignment="Top"
                                     Margin="12,0,0,0"
                                     ToolTip="{DynamicResource Loc.DatabaseProfiles.DiagnosticsSearch}"
                                     TextChanged="DiagnosticsSearchChanged" />
                        </Grid>
                        <TextBlock x:Name="DiagnosticsNoticeText"
                                   Grid.Row="1"
                                   Margin="0,6,0,6"
                                   Opacity="0.72"
                                   TextWrapping="Wrap" />
                        <DataGrid x:Name="DiagnosticsGrid"
                                  Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Loc.DatabaseProfiles.DiagnosticsKind}" Binding="{Binding Kind}" Width="105" />
                                <DataGridTextColumn Header="{DynamicResource Loc.DatabaseProfiles.DiagnosticsName}" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="{DynamicResource Loc.DatabaseProfiles.DiagnosticsValue}" Binding="{Binding Value}" Width="2*" />
                                <DataGridTextColumn Header="{DynamicResource Loc.DatabaseProfiles.DiagnosticsDetail}" Binding="{Binding Detail}" Width="3*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <DataGrid x:Name="ProfilesGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          SelectionChanged="ProfileSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Loc.DatabaseProfiles.Name}" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="{DynamicResource Loc.DatabaseProfiles.Engine}" Binding="{Binding Engine}" Width="120" />
                        <DataGridTextColumn Header="{DynamicResource Loc.DatabaseProfiles.Host}" Binding="{Binding RemoteHost}" Width="*" />
                        <DataGridTextColumn Header="{DynamicResource Loc.DatabaseProfiles.Port}" Binding="{Binding RemotePort}" Width="80" />
                        <DataGridTextColumn Header="{DynamicResource Loc.DatabaseProfiles.Auth}" Binding="{Binding AuthenticationKind}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <Border Grid.Column="2"
                    BorderThickness="1"
                    BorderBrush="#22000000"
                    CornerRadius="6"
                    Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.DatabaseProfiles.EditorTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />

                        <TextBlock Text="{DynamicResource Loc.DatabaseProfiles.Name}" Margin="0,14,0,4" />
                        <TextBox x:Name="NameBox" MaxLength="100" />

                        <TextBlock Text="{DynamicResource Loc.DatabaseProfiles.Engine}" Margin="0,12,0,4" />
                        <ComboBox x:Name="EngineBox" SelectionChanged="EngineSelectionChanged" />

                        <TextBlock Text="{DynamicResource Loc.DatabaseProfiles.Host}" Margin="0,12,0,4" />
                        <TextBox x:Name="HostBox" MaxLength="255" />

                        <TextBlock Text="{DynamicResource Loc.DatabaseProfiles.Port}" Margin="0,12,0,4" />
                        <TextBox x:Name="PortBox" />

                        <TextBlock Text="{DynamicResource Loc.DatabaseProfiles.DatabaseName}" Margin="0,12,0,4" />
                        <TextBox x:Name="DatabaseNameBox" MaxLength="128" />

                        <TextBlock Text="{DynamicResource Loc.DatabaseProfiles.Username}" Margin="0,12,0,4" />
                        <TextBox x:Name="UsernameBox" MaxLength="128" />

                        <TextBlock Text="{DynamicResource Loc.DatabaseProfiles.Auth}" Margin="0,12,0,4" />
                        <ComboBox x:Name="AuthenticationBox" SelectionChanged="AuthenticationSelectionChanged" />

                        <TextBlock Text="{DynamicResource Loc.DatabaseProfiles.Password}" Margin="0,12,0,4" />
                        <PasswordBox x:Name="PasswordBox" />
                        <TextBlock x:Name="PasswordHintText"
                                   Margin="0,4,0,0"
                                   Opacity="0.68"
                                   TextWrapping="Wrap" />

                        <Button x:Name="SaveButton"
                                Content="{DynamicResource Loc.DatabaseProfiles.Save}"
                                MinWidth="100"
                                Padding="14,7"
                                HorizontalAlignment="Left"
                                Margin="0,18,0,0"
                                Click="SaveOnClick" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Margin="0,12,0,0"
                   Text="{DynamicResource Loc.DatabaseProfiles.SafetyFooter}"
                   Opacity="0.72"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
