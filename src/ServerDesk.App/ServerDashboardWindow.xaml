<Window x:Class="ServerDesk.App.ServerDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Server dashboard"
        Width="1120"
        Height="780"
        MinWidth="920"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="DashboardButton" TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Margin="0,5,0,0"
                           Text="{Binding Endpoint}"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock Margin="0,3,0,0"
                           Text="{Binding CapturedText}"
                           FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ProgressBar Width="90"
                             Height="4"
                             Margin="0,15,8,0"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <Button x:Name="RefreshButton"
                        Content="Refresh"
                        Click="RefreshOnClick"
                        Style="{StaticResource DashboardButton}" />
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Click="CancelOnClick"
                        Style="{StaticResource DashboardButton}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Padding="12"
                CornerRadius="8"
                Background="{DynamicResource SurfaceSecondaryBrush}"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer Grid.Row="2" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding MetricCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DashboardCard}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Margin="0,7,0,0"
                                               Text="{Binding Value}"
                                               FontSize="22"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="{Binding Detail}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,4,0,0" Style="{StaticResource DashboardCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Health warnings" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding WarningCountText}"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </Grid>
                        <TextBlock Margin="0,8,0,0"
                                   Text="No memory or filesystem pressure warning is active."
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Visibility="{Binding HasNoWarnings, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Warnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6"
                                            Padding="10"
                                            CornerRadius="7"
                                            Background="{DynamicResource SurfaceSecondaryBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Severity}"
                                                       FontWeight="SemiBold"
                                                       MinWidth="70" />
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Margin="0,4,0,0" Style="{StaticResource DashboardCard}">
                    <StackPanel>
                        <TextBlock Text="Filesystems" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,10"
                                   Text="Read-only filesystem usage from the normalized dashboard snapshot."
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <DataGrid ItemsSource="{Binding FileSystems}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0"
                                  MaxHeight="280">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mount" Binding="{Binding MountPoint}" Width="2*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding FileSystemType}" Width="*" />
                                <DataGridTextColumn Header="Used" Binding="{Binding Used}" Width="*" />
                                <DataGridTextColumn Header="Available" Binding="{Binding Available}" Width="*" />
                                <DataGridTextColumn Header="Usage" Binding="{Binding UsedPercent}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
