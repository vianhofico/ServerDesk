<Window x:Class="ServerDesk.App.StorageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource Loc.Storage.WindowTitle}"
        Width="1420"
        Height="880"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Loaded="WindowOnLoaded"
        Closed="WindowOnClosed">
    <Window.Resources>
        <Style x:Key="StorageTechnicalCell"
               TargetType="TextBlock"
               BasedOn="{StaticResource TechnicalText}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StorageWarningRow"
               TargetType="DataGridRow"
               BasedOn="{StaticResource OperationalDataGridRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc.Storage.Header.Title}"
                               Style="{StaticResource PageTitleText}" />
                    <TextBlock Margin="0,2,0,3"
                               Text="{DynamicResource Loc.Storage.Header.Subtitle}"
                               Style="{StaticResource CaptionText}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ServerNameText" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="  ·  " Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="EndpointText"
                                   Style="{StaticResource TechnicalText}"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusPill}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Loc.Storage.Header.Environment}" Style="{StaticResource CaptionText}" />
                            <TextBlock Text=" · " Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock x:Name="EnvironmentValueText" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Margin="8,0,0,0" Style="{StaticResource AccentStatusPill}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6"
                                     Height="6"
                                     Margin="0,0,7,0"
                                     Fill="{DynamicResource AccentBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="ConnectionValueText" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="20,14,20,0"
                Style="{StaticResource CommandBarSurface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RefreshButton"
                            Click="RefreshOnClick"
                            Style="{StaticResource PrimaryButton}"
                            AutomationProperties.Name="{DynamicResource Loc.Storage.Command.Refresh}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;"
                                       Margin="0,0,7,0"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="White" />
                            <TextBlock Text="{DynamicResource Loc.Storage.Command.Refresh}" Foreground="White" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelButton"
                            Margin="8,0,0,0"
                            Content="{DynamicResource Loc.Storage.Command.Cancel}"
                            Click="CancelOnClick"
                            Style="{StaticResource GhostButton}"
                            IsEnabled="False" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Margin="16,0"
                           VerticalAlignment="Center"
                           Text="{DynamicResource Loc.Storage.Footer}"
                           Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap" />

                <Grid Grid.Column="2">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource OperationalSearchTextBox}"
                             Padding="34,6,36,6"
                             TextChanged="SearchBoxOnTextChanged"
                             ToolTip="{DynamicResource Loc.Storage.Search.Tooltip}"
                             AutomationProperties.Name="{DynamicResource Loc.Storage.Search.Label}" />
                    <TextBlock Text="&#xE721;"
                               Margin="11,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <Button x:Name="ClearSearchButton"
                            Width="32"
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,3,0"
                            Padding="0"
                            ToolTip="{DynamicResource Loc.Storage.Search.Clear}"
                            Click="ClearSearchOnClick"
                            Style="{StaticResource GhostButton}"
                            Visibility="Collapsed"
                            AutomationProperties.Name="{DynamicResource Loc.Storage.Search.Clear}">
                        <TextBlock Text="&#xE711;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="11" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="20,10,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource InlineInfoCard}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Storage.Policy.Title}" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{DynamicResource Loc.Storage.Policy.Text}"
                               Style="{StaticResource SecondaryBodyText}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource MetricTile}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Storage.Summary.Filesystems}" Style="{StaticResource EyebrowText}" />
                    <TextBlock x:Name="FilesystemValueText" Margin="0,4,0,0" Text="0" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource MetricTile}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Storage.Summary.Warnings}" Style="{StaticResource EyebrowText}" />
                    <TextBlock x:Name="WarningValueText" Margin="0,4,0,0" Text="0" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource MetricTile}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Storage.Summary.BlockDevices}" Style="{StaticResource EyebrowText}" />
                    <TextBlock x:Name="BlockValueText" Margin="0,4,0,0" Text="0" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="8" Style="{StaticResource MetricTile}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Storage.Summary.Mounted}" Style="{StaticResource EyebrowText}" />
                    <TextBlock x:Name="MountedValueText" Margin="0,4,0,0" Text="0" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Margin="20,10,20,10"
                Style="{StaticResource InlineInfoCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Border Grid.Column="1" Margin="16,0,0,0" Style="{StaticResource StatusPill}" VerticalAlignment="Center">
                    <TextBlock x:Name="VisibleValueText" Style="{StaticResource CaptionText}" />
                </Border>
            </Grid>
        </Border>

        <ui:Card Grid.Row="4"
                 Margin="20,0,20,0"
                 Padding="0"
                 ClipToBounds="True">
            <TabControl Margin="0">
                <TabItem Header="{DynamicResource Loc.Storage.Tab.Filesystems}">
                    <Grid>
                        <DataGrid x:Name="FilesystemGrid"
                                  Style="{StaticResource OperationalDataGrid}"
                                  RowStyle="{StaticResource StorageWarningRow}"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Device}" Binding="{Binding Device}" ElementStyle="{StaticResource StorageTechnicalCell}" Width="1.5*" />
                                <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.FileSystem}" Binding="{Binding FileSystemType}" Width="0.8*" />
                                <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Total}" Binding="{Binding TotalText}" Width="1*" />
                                <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Used}" Binding="{Binding UsedText}" Width="1*" />
                                <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Available}" Binding="{Binding AvailableText}" Width="1*" />
                                <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Use}" Binding="{Binding PercentText}" ElementStyle="{StaticResource StorageTechnicalCell}" Width="0.8*" />
                                <DataGridTemplateColumn Header="{DynamicResource Loc.Storage.Column.Health}" Width="0.9*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Margin="0,0,7,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{DynamicResource Loc.Storage.Health.Healthy}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                    <Setter Property="Text" Value="{DynamicResource Loc.Storage.Health.Warning}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Mount}" Binding="{Binding MountPoint}" ElementStyle="{StaticResource StorageTechnicalCell}" Width="2.2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border x:Name="FilesystemStateOverlay"
                                Background="{DynamicResource SurfaceBrush}"
                                Visibility="Collapsed"
                                IsHitTestVisible="False">
                            <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xEDA2;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="20"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="FilesystemStateText"
                                           Margin="0,10,0,0"
                                           Style="{StaticResource SecondaryBodyText}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="{DynamicResource Loc.Storage.Tab.BlockDevices}">
                    <Grid>
                        <DataGrid x:Name="BlockGrid"
                                  Style="{StaticResource OperationalDataGrid}"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Name}" Binding="{Binding Name}" ElementStyle="{StaticResource StorageTechnicalCell}" Width="1*" />
                                <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Parent}" Binding="{Binding ParentName}" ElementStyle="{StaticResource StorageTechnicalCell}" Width="1*" />
                                <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Type}" Binding="{Binding Type}" Width="0.8*" />
                                <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Size}" Binding="{Binding SizeText}" Width="1*" />
                                <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.FileSystem}" Binding="{Binding FileSystemType}" Width="0.9*" />
                                <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Mount}" Binding="{Binding MountPoint}" ElementStyle="{StaticResource StorageTechnicalCell}" Width="2*" />
                                <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Model}" Binding="{Binding Model}" Width="1.8*" />
                                <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Media}" Binding="{Binding MediaText}" Width="0.9*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border x:Name="BlockStateOverlay"
                                Background="{DynamicResource SurfaceBrush}"
                                Visibility="Collapsed"
                                IsHitTestVisible="False">
                            <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xEDA2;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="20"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="BlockStateText"
                                           Margin="0,10,0,0"
                                           Style="{StaticResource SecondaryBodyText}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="{DynamicResource Loc.Storage.Tab.Directory}">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource DetailsPane}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="500" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc.Storage.Directory.Title}" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Margin="0,4,14,0"
                                               Text="{DynamicResource Loc.Storage.Directory.Description}"
                                               Style="{StaticResource SecondaryBodyText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="{DynamicResource Loc.Storage.Directory.Path}" Style="{StaticResource FormLabelText}" />
                                    <TextBox x:Name="DirectoryPathBox"
                                             Margin="0,4,0,0"
                                             Text="/var"
                                             Style="{StaticResource FieldTextBox}"
                                             FontFamily="Cascadia Mono, Consolas"
                                             AutomationProperties.Name="{DynamicResource Loc.Storage.Directory.Path}" />
                                </StackPanel>
                                <Button x:Name="AnalyzeButton"
                                        Grid.Column="2"
                                        Margin="8,18,0,0"
                                        VerticalAlignment="Top"
                                        Content="{DynamicResource Loc.Storage.Directory.Analyze}"
                                        Click="AnalyzeOnClick"
                                        Style="{StaticResource SecondaryButton}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Margin="0,8,0,8" Style="{StaticResource InlineInfoCard}">
                            <TextBlock x:Name="AnalyzerStatusText"
                                       Text="{DynamicResource Loc.Storage.Directory.Initial}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Grid Grid.Row="2">
                            <DataGrid x:Name="DirectoryGrid"
                                      Style="{StaticResource OperationalDataGrid}"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Path}" Binding="{Binding Path}" ElementStyle="{StaticResource StorageTechnicalCell}" Width="4*" />
                                    <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Size}" Binding="{Binding SizeText}" Width="1*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border x:Name="DirectoryStateOverlay"
                                    Background="{DynamicResource SurfaceBrush}"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xEDA2;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="20"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="DirectoryStateText"
                                               Margin="0,10,0,0"
                                               Style="{StaticResource SecondaryBodyText}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </ui:Card>

        <TextBlock Grid.Row="5"
                   Margin="22,10,22,14"
                   Text="{DynamicResource Loc.Storage.Footer}"
                   Style="{StaticResource CaptionText}"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
