<Window x:Class="ServerDesk.App.StorageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.Storage.WindowTitle}"
        Width="1420"
        Height="880"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Loaded="WindowOnLoaded"
        Closed="WindowOnClosed">
    <Window.Resources>
        <Style x:Key="StorageSummaryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style x:Key="StorageSummaryValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="StorageTechnicalCell"
               TargetType="TextBlock"
               BasedOn="{StaticResource TechnicalText}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StorageWarningRow"
               TargetType="DataGridRow"
               BasedOn="{StaticResource OperationalDataGridRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SurfaceCard}" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Storage.Header.Title}"
                               FontSize="27"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource Loc.Storage.Header.Subtitle}"
                               Margin="0,3,0,10"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ServerNameText" FontWeight="SemiBold" />
                        <TextBlock Text="  ·  " Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="EndpointText"
                                   Style="{StaticResource TechnicalText}"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="12,8"
                            CornerRadius="8"
                            Background="{DynamicResource SurfaceSecondaryBrush}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc.Storage.Header.Environment}"
                                       Style="{StaticResource StorageSummaryLabel}" />
                            <TextBlock x:Name="EnvironmentValueText"
                                       Margin="0,2,0,0"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Margin="8,0,0,0"
                            Padding="12,8"
                            CornerRadius="8"
                            Background="{DynamicResource AccentSoftBrush}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc.Storage.Header.Connection}"
                                       Style="{StaticResource StorageSummaryLabel}" />
                            <TextBlock x:Name="ConnectionValueText"
                                       Margin="0,2,0,0"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Style="{StaticResource CommandBarSurface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RefreshButton"
                            Content="{DynamicResource Loc.Storage.Command.Refresh}"
                            Click="RefreshOnClick"
                            Style="{StaticResource SecondaryButton}" />
                    <Button x:Name="CancelButton"
                            Margin="6,0,0,0"
                            Content="{DynamicResource Loc.Storage.Command.Cancel}"
                            Click="CancelOnClick"
                            Style="{StaticResource GhostButton}"
                            IsEnabled="False" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Margin="16,0"
                           VerticalAlignment="Center"
                           Text="{DynamicResource Loc.Storage.Footer}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap" />
                <Grid Grid.Column="2">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource OperationalSearchTextBox}"
                             Padding="10,6,38,6"
                             TextChanged="SearchBoxOnTextChanged"
                             ToolTip="{DynamicResource Loc.Storage.Search.Tooltip}"
                             AutomationProperties.Name="{DynamicResource Loc.Storage.Search.Label}" />
                    <Button x:Name="ClearSearchButton"
                            Width="32"
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,3,3,0"
                            Padding="0"
                            Content="×"
                            ToolTip="{DynamicResource Loc.Storage.Search.Clear}"
                            Click="ClearSearchOnClick"
                            Style="{StaticResource GhostButton}"
                            Visibility="Collapsed"
                            AutomationProperties.Name="{DynamicResource Loc.Storage.Search.Clear}" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource InlineInfoCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Storage.Policy.Title}" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{DynamicResource Loc.Storage.Policy.Text}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource SurfaceCard}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Storage.Summary.Filesystems}" Style="{StaticResource StorageSummaryLabel}" />
                    <TextBlock x:Name="FilesystemValueText" Text="0" Style="{StaticResource StorageSummaryValue}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Storage.Summary.Warnings}" Style="{StaticResource StorageSummaryLabel}" />
                    <TextBlock x:Name="WarningValueText" Text="0" Style="{StaticResource StorageSummaryValue}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource SurfaceCard}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Storage.Summary.BlockDevices}" Style="{StaticResource StorageSummaryLabel}" />
                    <TextBlock x:Name="BlockValueText" Text="0" Style="{StaticResource StorageSummaryValue}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource SurfaceCard}" Padding="12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Storage.Summary.Mounted}" Style="{StaticResource StorageSummaryLabel}" />
                    <TextBlock x:Name="MountedValueText" Text="0" Style="{StaticResource StorageSummaryValue}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Style="{StaticResource InlineInfoCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
                <TextBlock x:Name="VisibleValueText"
                           Grid.Column="1"
                           Margin="16,0,0,0"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </Grid>
        </Border>

        <TabControl Grid.Row="4" Margin="0,10,0,0">
            <TabItem Header="{DynamicResource Loc.Storage.Tab.Filesystems}">
                <Grid Margin="6">
                    <DataGrid x:Name="FilesystemGrid"
                              Style="{StaticResource OperationalDataGrid}"
                              RowStyle="{StaticResource StorageWarningRow}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Device}" Binding="{Binding Device}" ElementStyle="{StaticResource StorageTechnicalCell}" Width="1.5*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.FileSystem}" Binding="{Binding FileSystemType}" Width="0.8*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Total}" Binding="{Binding TotalText}" Width="1*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Used}" Binding="{Binding UsedText}" Width="1*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Available}" Binding="{Binding AvailableText}" Width="1*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Use}" Binding="{Binding PercentText}" ElementStyle="{StaticResource StorageTechnicalCell}" Width="0.8*" />
                            <DataGridTemplateColumn Header="{DynamicResource Loc.Storage.Column.Health}" Width="0.9*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{DynamicResource Loc.Storage.Health.Healthy}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                            <Setter Property="Text" Value="{DynamicResource Loc.Storage.Health.Warning}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Mount}" Binding="{Binding MountPoint}" ElementStyle="{StaticResource StorageTechnicalCell}" Width="2.2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border x:Name="FilesystemStateOverlay"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <TextBlock x:Name="FilesystemStateText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   MaxWidth="520"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource Loc.Storage.Tab.BlockDevices}">
                <Grid Margin="6">
                    <DataGrid x:Name="BlockGrid" Style="{StaticResource OperationalDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Name}" Binding="{Binding Name}" ElementStyle="{StaticResource StorageTechnicalCell}" Width="1*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Parent}" Binding="{Binding ParentName}" ElementStyle="{StaticResource StorageTechnicalCell}" Width="1*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Type}" Binding="{Binding Type}" Width="0.8*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Size}" Binding="{Binding SizeText}" Width="1*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.FileSystem}" Binding="{Binding FileSystemType}" Width="0.9*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Mount}" Binding="{Binding MountPoint}" ElementStyle="{StaticResource StorageTechnicalCell}" Width="2*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Model}" Binding="{Binding Model}" Width="1.8*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Media}" Binding="{Binding MediaText}" Width="0.9*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border x:Name="BlockStateOverlay"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <TextBlock x:Name="BlockStateText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   MaxWidth="520"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource Loc.Storage.Tab.Directory}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource DetailsPane}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="520" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc.Storage.Directory.Title}" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,14,0"
                                           Text="{DynamicResource Loc.Storage.Directory.Description}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="{DynamicResource Loc.Storage.Directory.Path}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBox x:Name="DirectoryPathBox"
                                         Margin="0,4,0,0"
                                         Text="/var"
                                         Style="{StaticResource OperationalSearchTextBox}"
                                         FontFamily="Cascadia Mono, Consolas" />
                            </StackPanel>
                            <Button x:Name="AnalyzeButton"
                                    Grid.Column="2"
                                    Margin="8,18,0,0"
                                    VerticalAlignment="Top"
                                    Content="{DynamicResource Loc.Storage.Directory.Analyze}"
                                    Click="AnalyzeOnClick"
                                    Style="{StaticResource SecondaryButton}" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Margin="0,8,0,8" Style="{StaticResource InlineInfoCard}">
                        <TextBlock x:Name="AnalyzerStatusText"
                                   Text="{DynamicResource Loc.Storage.Directory.Initial}"
                                   TextWrapping="Wrap" />
                    </Border>
                    <Grid Grid.Row="2">
                        <DataGrid x:Name="DirectoryGrid" Style="{StaticResource OperationalDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Path}" Binding="{Binding Path}" ElementStyle="{StaticResource StorageTechnicalCell}" Width="4*" />
                                <DataGridTextColumn Header="{DynamicResource Loc.Storage.Column.Size}" Binding="{Binding SizeText}" Width="1*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border x:Name="DirectoryStateOverlay"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <TextBlock x:Name="DirectoryStateText"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       MaxWidth="520"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="5"
                   Margin="0,10,0,0"
                   Text="{DynamicResource Loc.Storage.Footer}"
                   Foreground="{DynamicResource MutedTextBrush}"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
