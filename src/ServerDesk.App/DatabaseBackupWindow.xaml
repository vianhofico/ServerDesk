<Window x:Class="ServerDesk.App.DatabaseBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.DatabaseBackups.WindowTitle}"
        Width="1160"
        Height="720"
        MinWidth="920"
        MinHeight="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Loc.DatabaseBackups.Subtitle}"
                       Margin="0,5,0,0"
                       Opacity="0.72"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="ProfileSummaryText"
                       Margin="0,8,0,0"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,14,0,0"
                Padding="14"
                BorderThickness="1"
                BorderBrush="#22000000"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Loc.DatabaseBackups.DatabaseName}" />
                    <TextBox x:Name="DatabaseNameBox"
                             Margin="0,4,0,0"
                             MaxLength="128" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Loc.DatabaseBackups.Destination}" />
                    <TextBox x:Name="DestinationBox"
                             Margin="0,4,0,0"
                             MaxLength="1024" />
                    <TextBlock Text="{DynamicResource Loc.DatabaseBackups.DestinationHint}"
                               Margin="0,3,0,0"
                               Opacity="0.65"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="CreateButton"
                        Grid.Column="3"
                        Content="{DynamicResource Loc.DatabaseBackups.Create}"
                        Margin="16,20,0,0"
                        Padding="14,8"
                        VerticalAlignment="Top"
                        Click="CreateOnClick" />
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Margin="0,12,0,10"
                   TextWrapping="Wrap" />

        <Border Grid.Row="3"
                BorderThickness="1"
                BorderBrush="#22000000"
                CornerRadius="6"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Loc.DatabaseBackups.HistoryTitle}"
                               FontSize="17"
                               FontWeight="SemiBold" />
                    <Button Grid.Column="1"
                            Content="{DynamicResource Loc.DatabaseBackups.Refresh}"
                            Padding="12,6"
                            Click="RefreshOnClick" />
                </Grid>

                <DataGrid x:Name="HistoryGrid"
                          Grid.Row="1"
                          Margin="0,10,0,0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Loc.DatabaseBackups.Created}" Binding="{Binding Created}" Width="135" />
                        <DataGridTextColumn Header="{DynamicResource Loc.DatabaseBackups.Database}" Binding="{Binding Database}" Width="130" />
                        <DataGridTextColumn Header="{DynamicResource Loc.DatabaseBackups.Path}" Binding="{Binding Path}" Width="3*" />
                        <DataGridTextColumn Header="{DynamicResource Loc.DatabaseBackups.Format}" Binding="{Binding Format}" Width="125" />
                        <DataGridTextColumn Header="{DynamicResource Loc.DatabaseBackups.Tool}" Binding="{Binding Tool}" Width="180" />
                        <DataGridTextColumn Header="{DynamicResource Loc.DatabaseBackups.Size}" Binding="{Binding Size}" Width="100" />
                        <DataGridTextColumn Header="{DynamicResource Loc.DatabaseBackups.Checksum}" Binding="{Binding Checksum}" Width="2*" />
                        <DataGridTextColumn Header="{DynamicResource Loc.DatabaseBackups.Verified}" Binding="{Binding Verified}" Width="135" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Loc.DatabaseBackups.SafetyFooter}"
                       Opacity="0.72"
                       TextWrapping="Wrap"
                       Margin="0,0,16,0" />
            <Button Grid.Column="1"
                    Content="{DynamicResource Loc.DatabaseBackups.Close}"
                    Padding="14,7"
                    VerticalAlignment="Bottom"
                    Click="CloseOnClick" />
        </Grid>
    </Grid>
</Window>
