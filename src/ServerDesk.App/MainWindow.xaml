<Window x:Class="ServerDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="ServerDesk"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          KeyboardNavigation.TabNavigation="Continue">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="296" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Persistent navigation / server context -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,18,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="180" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,0,4,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40"
                            Height="40"
                            CornerRadius="10"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="S"
                                   Foreground="White"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ServerDesk"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Loc.AppSubtitle}"
                                   Style="{StaticResource CaptionText}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,0,0,16"
                        Padding="12"
                        CornerRadius="10"
                        Background="{DynamicResource SurfaceSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc.Shell.ServerPane.Title}"
                                       Style="{StaticResource EyebrowText}" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding ServerCountLabel}"
                                       Style="{StaticResource CaptionText}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Width="36"
                                MinWidth="36"
                                Height="36"
                                Padding="0"
                                Command="{Binding AddServerCommand}"
                                Style="{StaticResource PrimaryButton}"
                                ToolTip="{DynamicResource Loc.Common.Add}">
                            <TextBlock Text="&#xE710;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="White" />
                        </Button>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2"
                           Margin="6,0,6,6"
                           Text="{DynamicResource Loc.Shell.Header.Server}"
                           Style="{StaticResource EyebrowText}" />

                <ListBox Grid.Row="3"
                         ItemsSource="{Binding Servers}"
                         SelectedItem="{Binding SelectedServer, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource ServerListItem}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Padding="6,2"
                                            CornerRadius="8"
                                            Background="{DynamicResource SurfaceSecondaryBrush}">
                                        <TextBlock Text="{Binding Environment}"
                                                   FontSize="9.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Margin="0,4,0,0"
                                           Text="{Binding Endpoint}"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="10.5"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <StackPanel Grid.Row="2" Margin="0,6,0,0" Orientation="Horizontal">
                                    <Ellipse Width="6"
                                             Height="6"
                                             Margin="0,0,6,0"
                                             Fill="{DynamicResource AccentBrush}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ConnectionLabel}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="4"
                           Margin="6,18,6,7"
                           Text="{DynamicResource Loc.Shell.Workspace.Title}"
                           Style="{StaticResource EyebrowText}" />

                <ListBox x:Name="WorkspaceNavigationList"
                         Grid.Row="5"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Margin="8,12,8,5"
                                           Text="{Binding Group}"
                                           Style="{StaticResource EyebrowText}"
                                           Visibility="{Binding ShowGroupHeader, Converter={StaticResource BoolToVisibility}}" />
                                <Button Style="{StaticResource WorkspaceNavigationButton}"
                                        IsEnabled="{Binding IsAvailable}"
                                        Click="WorkspaceNavigationOnClick"
                                        ToolTip="{Binding Description}"
                                        ToolTipService.ShowOnDisabled="True"
                                        AutomationProperties.Name="{Binding Title}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding IconGlyph}"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2"
                                                   Text="&#xE76C;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="6"
                        Margin="0,12,0,0"
                        Padding="12"
                        CornerRadius="10"
                        Background="{DynamicResource SurfaceSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE72E;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       Text="{DynamicResource Loc.Shell.Security.Title}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Margin="0,5,0,10"
                                   Text="{DynamicResource Loc.Shell.Security.Description}"
                                   Style="{StaticResource CaptionText}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      MinWidth="0"
                                      ItemsSource="{Binding ThemeOptions}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding ThemePreference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="{DynamicResource Loc.Theme}" />
                            <ComboBox Grid.Column="2"
                                      MinWidth="0"
                                      ItemsSource="{Binding LanguageOptions}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding LanguagePreference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="{DynamicResource Loc.Language}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main workspace -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="28,0,30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid VerticalAlignment="Center">
                        <StackPanel Visibility="{Binding HasSelectedServer, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedServer.Name}"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="360" />
                                <Border Margin="10,0,0,0"
                                        Style="{StaticResource StatusPill}">
                                    <TextBlock Text="{Binding SelectedServer.Environment}"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                </Border>
                                <Border Margin="6,0,0,0"
                                        Style="{StaticResource AccentStatusPill}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Margin="0,0,6,0"
                                                 Fill="{DynamicResource AccentBrush}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedServer.ConnectionLabel}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding SelectedServer.Endpoint}"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasNoSelectedServer, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{DynamicResource Loc.Shell.Header.NoServer}"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="{DynamicResource Loc.Shell.Header.NoServerHint}"
                                       Style="{StaticResource CaptionText}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Margin="0,0,14,0" Style="{StaticResource AccentStatusPill}">
                            <TextBlock Text="{DynamicResource Loc.Shell.Header.ProductStatus}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold" />
                        </Border>
                        <ProgressBar Width="96"
                                     Height="4"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                     VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid Margin="32,28,36,38" MaxWidth="1180" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc.Shell.Home.Title}"
                                       Style="{StaticResource DisplayTitleText}" />
                            <TextBlock Margin="0,6,0,0"
                                       MaxWidth="760"
                                       HorizontalAlignment="Left"
                                       Text="{DynamicResource Loc.Shell.Home.Description}"
                                       Style="{StaticResource SecondaryBodyText}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,18,0,0">
                        <Border Style="{StaticResource InlineInfoCard}"
                                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE946;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding StatusMessage}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                        <Border Margin="0,8,0,0"
                                Style="{StaticResource InlineErrorCard}"
                                Visibility="{Binding HasErrorMessage, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xEA39;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Foreground="{DynamicResource DangerBrush}"
                                           VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ErrorMessage}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource DangerBrush}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <!-- Profile editor -->
                        <ui:Card Padding="28"
                                 Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                                <TextBlock Text="{DynamicResource Loc.Shell.Profile.Title}"
                                           Style="{StaticResource PageTitleText}" />
                                <TextBlock Margin="0,6,0,24"
                                           Text="{DynamicResource Loc.Shell.Profile.Description}"
                                           Style="{StaticResource SecondaryBodyText}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Loc.Shell.Profile.DisplayName}" Style="{StaticResource FormLabelText}" />
                                        <TextBox Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="{DynamicResource Loc.Shell.Profile.Environment}" Style="{StaticResource FormLabelText}" />
                                        <TextBox Text="{Binding Editor.Environment, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,16,0,0">
                                        <TextBlock Text="{DynamicResource Loc.Shell.Profile.Host}" Style="{StaticResource FormLabelText}" />
                                        <TextBox Text="{Binding Editor.Host, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,16,0,0">
                                        <TextBlock Text="{DynamicResource Loc.Shell.Profile.Port}" Style="{StaticResource FormLabelText}" />
                                        <TextBox Text="{Binding Editor.PortText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,16,0,0">
                                        <TextBlock Text="{DynamicResource Loc.Shell.Profile.Username}" Style="{StaticResource FormLabelText}" />
                                        <TextBox Text="{Binding Editor.Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,16,0,0">
                                        <TextBlock Text="{DynamicResource Loc.Shell.Profile.Authentication}" Style="{StaticResource FormLabelText}" />
                                        <ComboBox ItemsSource="{Binding Editor.AuthenticationChoices}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Kind"
                                                  SelectedValue="{Binding Editor.AuthenticationKind, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,16,0,0"
                                            Visibility="{Binding Editor.IsPrivateKey, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{DynamicResource Loc.Shell.Profile.PrivateKeyPath}" Style="{StaticResource FormLabelText}" />
                                    <TextBox Text="{Binding Editor.PrivateKeyPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}" />
                                    <TextBlock Margin="0,5,0,0" Text="{DynamicResource Loc.Shell.Profile.PrivateKeyHint}" Style="{StaticResource CaptionText}" />
                                </StackPanel>

                                <StackPanel Margin="0,16,0,0"
                                            Visibility="{Binding Editor.CanStoreSecret, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding Editor.SecretLabel}" Style="{StaticResource FormLabelText}" />
                                    <PasswordBox x:Name="CredentialSecretBox"
                                                 MinHeight="38"
                                                 Padding="11,7"
                                                 PasswordChanged="CredentialSecretBoxOnPasswordChanged" />
                                    <TextBlock Margin="0,5,0,0" Text="{Binding Editor.SecretHint}" Style="{StaticResource CaptionText}" />
                                </StackPanel>

                                <Border Margin="0,18,0,0"
                                        Padding="14"
                                        CornerRadius="10"
                                        Background="{DynamicResource SurfaceSecondaryBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE72E;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{DynamicResource Loc.Shell.Profile.SecretSafety}"
                                                   Style="{StaticResource BodyText}" />
                                    </Grid>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                                    <Button Content="{DynamicResource Loc.Shell.Profile.Save}"
                                            Command="{Binding SaveServerCommand}"
                                            Style="{StaticResource PrimaryButton}" />
                                    <Button Content="{DynamicResource Loc.Common.Cancel}"
                                            Margin="10,0,0,0"
                                            Command="{Binding CancelEditorCommand}"
                                            Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                        <!-- Home dashboard -->
                        <StackPanel Visibility="{Binding IsDashboardVisible, Converter={StaticResource BoolToVisibility}}">
                            <ui:Card Padding="34"
                                     Visibility="{Binding HasNoSelectedServer, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel HorizontalAlignment="Center" MaxWidth="560">
                                    <Border Width="56"
                                            Height="56"
                                            CornerRadius="16"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE710;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="20"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Margin="0,18,0,0"
                                               Text="{DynamicResource Loc.Shell.Empty.Title}"
                                               Style="{StaticResource PageTitleText}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Margin="0,8,0,20"
                                               Text="{DynamicResource Loc.Shell.Empty.Description}"
                                               Style="{StaticResource SecondaryBodyText}"
                                               TextAlignment="Center" />
                                    <Button Content="{DynamicResource Loc.Common.Add}"
                                            Command="{Binding AddServerCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Center" />
                                </StackPanel>
                            </ui:Card>

                            <ui:Card Padding="26"
                                     Visibility="{Binding HasSelectedServer, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedServer.Name}"
                                                       Style="{StaticResource PageTitleText}" />
                                            <TextBlock Margin="0,5,0,0"
                                                       Text="{Binding SelectedServer.Endpoint}"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                        </StackPanel>
                                        <WrapPanel Grid.Column="1"
                                                   Margin="20,0,0,0"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Top">
                                            <Button Content="{Binding SelectedServer.ConnectActionLabel}"
                                                    Command="{Binding ConnectServerCommand}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Visibility="{Binding SelectedServer.CanConnect, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="{Binding SelectedServer.DisconnectActionLabel}"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding DisconnectServerCommand}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Visibility="{Binding SelectedServer.CanDisconnect, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="{DynamicResource Loc.Shell.Server.Edit}"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding EditServerCommand}"
                                                    Style="{StaticResource SecondaryButton}" />
                                            <Button Content="{DynamicResource Loc.Shell.Server.Delete}"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding RequestDeleteServerCommand}"
                                                    Style="{StaticResource GhostButton}" />
                                        </WrapPanel>
                                    </Grid>

                                    <UniformGrid Columns="4" Margin="0,24,0,0">
                                        <Border Margin="0,0,6,0" Style="{StaticResource MetricTile}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Loc.Shell.Server.Environment}" Style="{StaticResource CaptionText}" />
                                                <TextBlock Margin="0,5,0,0" Text="{Binding SelectedServer.Environment}" FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="2,0,4,0" Style="{StaticResource MetricTile}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Loc.Shell.Server.Authentication}" Style="{StaticResource CaptionText}" />
                                                <TextBlock Margin="0,5,0,0" Text="{Binding SelectedServer.AuthenticationLabel}" FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="4,0,2,0" Style="{StaticResource MetricTile}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Loc.Shell.Server.Connection}" Style="{StaticResource CaptionText}" />
                                                <TextBlock Margin="0,5,0,0" Text="{Binding SelectedServer.ConnectionLabel}" FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="6,0,0,0" Style="{StaticResource MetricTile}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Loc.Shell.Server.ConnectedSince}" Style="{StaticResource CaptionText}" />
                                                <TextBlock Margin="0,5,0,0" Text="{Binding SelectedServer.ConnectedSinceDisplay}" FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <Border Margin="0,18,0,0"
                                            Padding="14"
                                            CornerRadius="10"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE968;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding SelectedServer.ConnectionDetail}" TextWrapping="Wrap" />
                                                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                                    <TextBlock Text="{DynamicResource Loc.Shell.Server.Version}" Style="{StaticResource CaptionText}" />
                                                    <TextBlock Margin="5,0,0,0"
                                                               Text="{Binding SelectedServer.ServerVersionDisplay}"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <ContentControl x:Name="CapabilityHost" Margin="0,16,0,0" />

                                    <Border Margin="0,16,0,0"
                                            Style="{StaticResource InlineErrorCard}"
                                            Visibility="{Binding IsDeleteConfirmationVisible, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE74D;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1" Margin="0,0,18,0">
                                                <TextBlock Text="{DynamicResource Loc.Shell.Delete.Title}" FontWeight="SemiBold" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Text="{DynamicResource Loc.Shell.Delete.Description}"
                                                           Style="{StaticResource CaptionText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="{DynamicResource Loc.Common.Cancel}"
                                                        Command="{Binding CancelDeleteServerCommand}"
                                                        Style="{StaticResource SecondaryButton}" />
                                                <Button Content="{DynamicResource Loc.Shell.Server.Delete}"
                                                        Margin="8,0,0,0"
                                                        Command="{Binding ConfirmDeleteServerCommand}"
                                                        Style="{StaticResource DangerButton}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
