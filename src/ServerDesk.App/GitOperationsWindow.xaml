<Window x:Class="ServerDesk.App.GitOperationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.Git.Title}"
        Width="1420"
        Height="860"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Loaded="WindowOnLoaded"
        Closed="WindowOnClosed">
    <Window.Resources>
        <Style x:Key="GitButton" TargetType="Button">
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="GitSummaryValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="GitSummaryLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="26" FontWeight="SemiBold" />
                <TextBlock x:Name="EndpointText" Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="InspectButton" Content="{DynamicResource Loc.Git.Inspect}" Click="InspectOnClick" Style="{StaticResource GitButton}" Margin="0" />
                <Button x:Name="CancelButton" Content="{DynamicResource Loc.Common.Cancel}" Click="CancelOnClick" Style="{StaticResource GitButton}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,14,0,0" Padding="12" CornerRadius="9"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Loc.Git.RepositoryPath}" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <TextBox x:Name="RepositoryPathBox" Grid.Column="1" Margin="10,0,0,0"
                         ToolTip="{DynamicResource Loc.Git.RepositoryPathHint}" />
                <Button x:Name="FetchButton" Grid.Column="2" Content="{DynamicResource Loc.Git.Fetch}" Click="FetchOnClick"
                        Style="{StaticResource GitButton}" IsEnabled="False" />
                <Button x:Name="PreviewPullButton" Grid.Column="3" Content="{DynamicResource Loc.Git.PreviewPull}" Click="PreviewPullOnClick"
                        Style="{StaticResource GitButton}" IsEnabled="False" />
                <Button x:Name="PullButton" Grid.Column="4" Content="{DynamicResource Loc.Git.ApplyPull}" Click="PullOnClick"
                        Style="{StaticResource GitButton}" IsEnabled="False" />
                <TextBlock Grid.Column="5" Margin="10,0,0,0" VerticalAlignment="Center"
                           Text="{DynamicResource Loc.Git.FastForwardOnly}"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,10,0,0" Padding="12" CornerRadius="9"
                Background="{DynamicResource SurfaceSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Loc.Git.DiscoveryRoot}" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <TextBox x:Name="DiscoveryRootBox" Grid.Column="1" Margin="10,0,0,0" Text="/srv" />
                <TextBlock Grid.Column="2" Margin="14,0,0,0" Text="{DynamicResource Loc.Git.Depth}" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <TextBox x:Name="DiscoveryDepthBox" Grid.Column="3" Margin="8,0,0,0" Text="4" />
                <Button x:Name="DiscoverButton" Grid.Column="4" Content="{DynamicResource Loc.Git.Discover}" Click="DiscoverOnClick"
                        Style="{StaticResource GitButton}" />
                <ComboBox x:Name="DiscoveryCombo" Grid.Column="5" Margin="10,0,0,0"
                          SelectionChanged="DiscoveryComboOnSelectionChanged"
                          ToolTip="{DynamicResource Loc.Git.DiscoveryHint}" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="0,10,0,10" Padding="10" CornerRadius="7"
                Background="{DynamicResource SurfaceSecondaryBrush}">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="0,0,8,0" Padding="12" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="BranchValue" Text="—" Style="{StaticResource GitSummaryValue}" />
                        <TextBlock Text="{DynamicResource Loc.Git.Branch}" Style="{StaticResource GitSummaryLabel}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Margin="0,0,8,0" Padding="12" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="RevisionValue" Text="—" Style="{StaticResource GitSummaryValue}" />
                        <TextBlock Text="{DynamicResource Loc.Git.Revision}" Style="{StaticResource GitSummaryLabel}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Margin="0,0,8,0" Padding="12" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="UpstreamValue" Text="—" Style="{StaticResource GitSummaryValue}" />
                        <TextBlock Text="{DynamicResource Loc.Git.Upstream}" Style="{StaticResource GitSummaryLabel}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Margin="0,0,8,0" Padding="12" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="AheadBehindValue" Text="—" Style="{StaticResource GitSummaryValue}" />
                        <TextBlock Text="{DynamicResource Loc.Git.AheadBehind}" Style="{StaticResource GitSummaryLabel}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Padding="12" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="WorktreeValue" Text="—" Style="{StaticResource GitSummaryValue}" />
                        <TextBlock Text="{DynamicResource Loc.Git.Worktree}" Style="{StaticResource GitSummaryLabel}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TabControl Grid.Row="2">
                <TabItem Header="{DynamicResource Loc.Git.Changes}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="DiffSummaryText" Margin="8" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <DataGrid x:Name="ChangesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Loc.Git.ChangeStatus}" Binding="{Binding StatusDisplay}" Width="80" />
                                <DataGridTextColumn Header="{DynamicResource Loc.Git.Path}" Binding="{Binding Path}" Width="*" />
                                <DataGridTextColumn Header="{DynamicResource Loc.Git.OriginalPath}" Binding="{Binding OriginalPath}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="{DynamicResource Loc.Git.Remotes}">
                    <DataGrid x:Name="RemotesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Loc.Git.Remote}" Binding="{Binding Name}" Width="180" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Git.SafeUrl}" Binding="{Binding SafeUrl}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="{DynamicResource Loc.Git.PullPreview}">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="PreviewText" Text="{DynamicResource Loc.Git.NoPreview}" TextWrapping="Wrap" />
                        <ListBox x:Name="IncomingCommitsList" Grid.Row="1" Margin="0,10,0,0"
                                 FontFamily="Consolas" FontSize="12"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <TextBlock Grid.Row="5" Margin="0,10,0,0" Text="{DynamicResource Loc.Git.SafetyFooter}"
                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
    </Grid>
</Window>
