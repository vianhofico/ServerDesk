<Window x:Class="ServerDesk.App.TlsCertificateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.Tls.WindowTitle}"
        Width="1320"
        Height="820"
        MinWidth="1040"
        MinHeight="660"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Loc.Tls.Subtitle}"
                           Margin="0,4,0,0"
                           Opacity="0.72"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="RenewButton"
                        Content="{DynamicResource Loc.Tls.Renew}"
                        MinWidth="116"
                        Padding="14,7"
                        IsEnabled="False"
                        Click="RenewOnClick" />
                <Button x:Name="RefreshButton"
                        Content="{DynamicResource Loc.Tls.Refresh}"
                        MinWidth="92"
                        Padding="14,7"
                        Margin="8,0,0,0"
                        Click="RefreshOnClick" />
                <Button x:Name="CancelButton"
                        Content="{DynamicResource Loc.Tls.Cancel}"
                        MinWidth="92"
                        Padding="14,7"
                        Margin="8,0,0,0"
                        IsEnabled="False"
                        Click="CancelOnClick" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,14,0,12"
                Padding="12"
                BorderThickness="1"
                BorderBrush="#22000000"
                CornerRadius="6">
            <StackPanel>
                <TextBlock Text="{DynamicResource Loc.Tls.Certbot}" FontWeight="SemiBold" />
                <TextBlock x:Name="CertbotStatusText" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="CertificateGrid"
                      Grid.Column="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      SelectionChanged="CertificateSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Loc.Tls.CertificatePath}" Binding="{Binding CertificatePath}" Width="3*" />
                    <DataGridTextColumn Header="{DynamicResource Loc.Tls.Health}" Binding="{Binding HealthLabel}" Width="*" />
                    <DataGridTextColumn Header="{DynamicResource Loc.Tls.DaysRemaining}" Binding="{Binding DaysLabel}" Width="70" />
                    <DataGridTextColumn Header="{DynamicResource Loc.Tls.Managed}" Binding="{Binding ManagedLabel}" Width="105" />
                </DataGrid.Columns>
            </DataGrid>

            <TabControl Grid.Column="2">
                <TabItem Header="{DynamicResource Loc.Tls.Certificates}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14">
                            <TextBlock x:Name="SelectedCertificateTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource Loc.Tls.Subject}" Margin="0,14,0,2" FontWeight="SemiBold" />
                            <TextBlock x:Name="SubjectText" TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource Loc.Tls.Issuer}" Margin="0,10,0,2" FontWeight="SemiBold" />
                            <TextBlock x:Name="IssuerText" TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource Loc.Tls.Sans}" Margin="0,10,0,2" FontWeight="SemiBold" />
                            <TextBlock x:Name="SansText" TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource Loc.Tls.Expires}" Margin="0,10,0,2" FontWeight="SemiBold" />
                            <TextBlock x:Name="ExpiryText" TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource Loc.Tls.Sites}" Margin="0,10,0,2" FontWeight="SemiBold" />
                            <TextBlock x:Name="SitesText" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{DynamicResource Loc.Tls.Obtain}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14">
                            <TextBlock Text="{DynamicResource Loc.Tls.ObtainHelp}" TextWrapping="Wrap" Opacity="0.78" />

                            <TextBlock Text="{DynamicResource Loc.Tls.NginxSite}" Margin="0,14,0,4" FontWeight="SemiBold" />
                            <ComboBox x:Name="SiteComboBox"
                                      MinHeight="34"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="SiteSelectionChanged" />

                            <TextBlock Text="{DynamicResource Loc.Tls.CertificateName}" Margin="0,12,0,4" FontWeight="SemiBold" />
                            <TextBox x:Name="CertificateNameTextBox" MinHeight="34" Padding="8,5" />

                            <TextBlock Text="{DynamicResource Loc.Tls.Domains}" Margin="0,12,0,4" FontWeight="SemiBold" />
                            <TextBox x:Name="DomainsTextBox" MinHeight="34" Padding="8,5" />

                            <TextBlock Text="{DynamicResource Loc.Tls.Email}" Margin="0,12,0,4" FontWeight="SemiBold" />
                            <TextBox x:Name="EmailTextBox" MinHeight="34" Padding="8,5" />

                            <CheckBox x:Name="TermsCheckBox"
                                      Margin="0,14,0,0"
                                      Content="{DynamicResource Loc.Tls.Terms}"
                                      Checked="ObtainInputChanged"
                                      Unchecked="ObtainInputChanged" />

                            <Button x:Name="ObtainButton"
                                    Content="{DynamicResource Loc.Tls.Obtain}"
                                    Margin="0,16,0,0"
                                    Padding="14,8"
                                    MinWidth="130"
                                    HorizontalAlignment="Left"
                                    IsEnabled="False"
                                    Click="ObtainOnClick" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <TextBlock Grid.Row="3"
                   Margin="0,12,0,0"
                   Text="{DynamicResource Loc.Tls.SafetyFooter}"
                   Opacity="0.72"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
