<Window x:Class="ServerDesk.App.DockerInventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Docker"
        Width="1380"
        Height="840"
        MinWidth="1040"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Loaded="WindowOnLoaded"
        Closed="WindowOnClosed">
    <Window.Resources>
        <Style x:Key="DockerButton" TargetType="Button">
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="26" FontWeight="SemiBold" />
                <TextBlock x:Name="EndpointText" Margin="0,5,0,0"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Refresh" Click="RefreshOnClick" Style="{StaticResource DockerButton}" Margin="0" />
                <Button Content="Cancel" Click="CancelOnClick" Style="{StaticResource DockerButton}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Search" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <TextBox x:Name="SearchBox" Grid.Column="1" Margin="10,0,0,0"
                     TextChanged="SearchBoxOnTextChanged"
                     ToolTip="Filter the currently loaded Docker inventory locally." />
        </Grid>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="10" CornerRadius="7"
                Background="{DynamicResource SurfaceSecondaryBrush}">
            <StackPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
                <TextBlock x:Name="RuntimeDetailText" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,8,0" Padding="12" CornerRadius="7"
                    Background="{DynamicResource SurfaceSecondaryBrush}">
                <StackPanel>
                    <TextBlock x:Name="EngineValue" Style="{StaticResource SummaryValue}" Text="—" />
                    <TextBlock Text="Engine / API" Style="{StaticResource SummaryLabel}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Margin="0,0,8,0" Padding="12" CornerRadius="7"
                    Background="{DynamicResource SurfaceSecondaryBrush}">
                <StackPanel>
                    <TextBlock x:Name="ContainerValue" Style="{StaticResource SummaryValue}" Text="—" />
                    <TextBlock Text="Containers" Style="{StaticResource SummaryLabel}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Margin="0,0,8,0" Padding="12" CornerRadius="7"
                    Background="{DynamicResource SurfaceSecondaryBrush}">
                <StackPanel>
                    <TextBlock x:Name="ImageValue" Style="{StaticResource SummaryValue}" Text="—" />
                    <TextBlock Text="Images" Style="{StaticResource SummaryLabel}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Margin="0,0,8,0" Padding="12" CornerRadius="7"
                    Background="{DynamicResource SurfaceSecondaryBrush}">
                <StackPanel>
                    <TextBlock x:Name="VolumeValue" Style="{StaticResource SummaryValue}" Text="—" />
                    <TextBlock Text="Volumes" Style="{StaticResource SummaryLabel}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Margin="0,0,8,0" Padding="12" CornerRadius="7"
                    Background="{DynamicResource SurfaceSecondaryBrush}">
                <StackPanel>
                    <TextBlock x:Name="NetworkValue" Style="{StaticResource SummaryValue}" Text="—" />
                    <TextBlock Text="Networks" Style="{StaticResource SummaryLabel}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="5" Padding="12" CornerRadius="7"
                    Background="{DynamicResource SurfaceSecondaryBrush}">
                <StackPanel>
                    <TextBlock x:Name="HostValue" Style="{StaticResource SummaryValue}" Text="—" />
                    <TextBlock Text="Docker host" Style="{StaticResource SummaryLabel}" />
                </StackPanel>
            </Border>
        </Grid>

        <TabControl Grid.Row="4" x:Name="InventoryTabs">
            <TabItem Header="Containers">
                <DataGrid x:Name="ContainerGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.2*" />
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="0.8*" />
                        <DataGridTextColumn Header="Image" Binding="{Binding Image}" Width="1.5*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.4*" />
                        <DataGridTextColumn Header="Ports" Binding="{Binding Ports}" Width="1.4*" />
                        <DataGridTextColumn Header="Networks" Binding="{Binding Networks}" Width="1.1*" />
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="1.3*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Images">
                <DataGrid x:Name="ImageGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Repository" Binding="{Binding Repository}" Width="1.5*" />
                        <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="0.8*" />
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="0.8*" />
                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" Width="1.5*" />
                        <DataGridTextColumn Header="Digest" Binding="{Binding Digest}" Width="1.6*" />
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="1.5*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Volumes">
                <DataGrid x:Name="VolumeGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.5*" />
                        <DataGridTextColumn Header="Driver" Binding="{Binding Driver}" Width="0.8*" />
                        <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="0.8*" />
                        <DataGridTextColumn Header="Mountpoint" Binding="{Binding Mountpoint}" Width="2.2*" />
                        <DataGridTextColumn Header="Labels" Binding="{Binding Labels}" Width="1.5*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Networks">
                <DataGrid x:Name="NetworkGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.4*" />
                        <DataGridTextColumn Header="Driver" Binding="{Binding Driver}" Width="0.9*" />
                        <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="0.8*" />
                        <DataGridTextColumn Header="IPv6" Binding="{Binding Ipv6}" Width="0.7*" />
                        <DataGridTextColumn Header="Internal" Binding="{Binding Internal}" Width="0.7*" />
                        <DataGridTextColumn Header="Labels" Binding="{Binding Labels}" Width="1.5*" />
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="1.5*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="5" x:Name="FooterText" Margin="0,10,0,0"
                   Foreground="{DynamicResource MutedTextBrush}" />
    </Grid>
</Window>
