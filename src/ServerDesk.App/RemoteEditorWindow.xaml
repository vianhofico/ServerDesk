<Window x:Class="ServerDesk.App.RemoteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote editor"
        Width="1180"
        Height="780"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Loaded="WindowOnLoaded"
        Closed="WindowOnClosed">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="25" FontWeight="SemiBold" />
                <TextBlock x:Name="EndpointText" Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Reload" Click="ReloadOnClick" Padding="13,7" Margin="6,0,0,0" />
                <Button Content="Save" Click="SaveOnClick" Padding="13,7" Margin="6,0,0,0" />
                <Button Content="Privileged save" Click="PrivilegedSaveOnClick" Padding="13,7" Margin="6,0,0,0" />
                <Button Content="Cancel" Click="CancelOnClick" Padding="13,7" Margin="6,0,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,14,0,12" Padding="10" CornerRadius="7" Background="{DynamicResource SurfaceSecondaryBrush}">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Original" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox x:Name="OriginalBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         FontFamily="Consolas"
                         FontSize="13"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" />
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Edited" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox x:Name="EditedBox"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         FontFamily="Consolas"
                         FontSize="13"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         TextChanged="EditedBoxOnTextChanged" />
            </DockPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Validator executable (optional)" FontWeight="SemiBold" />
                <TextBox x:Name="ValidatorExecutableBox" Margin="0,5,10,0" ToolTip="Example: /bin/sh" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Validator arguments · one per line" FontWeight="SemiBold" />
                <TextBox x:Name="ValidatorArgumentsBox"
                         Margin="0,5,10,0"
                         Height="58"
                         AcceptsReturn="True"
                         ToolTip="Use {file} where the staged file path should be inserted. Example: -n then {file}." />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Safety" FontWeight="SemiBold" />
                <TextBlock Margin="0,5,0,0"
                           Text="Privileged save validates the user-owned staged file first. Only after validation passes does ServerDesk use sudo -n install into a same-directory staging file and atomic mv over the live target. UID/GID/mode are preserved; chmod 777 is never used."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DiffText" VerticalAlignment="Center" FontWeight="SemiBold" />
            <TextBlock x:Name="MetadataText" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
        </Grid>
    </Grid>
</Window>
