<Window x:Class="ServerDesk.App.ProcessManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Processes"
        Width="1220"
        Height="760"
        MinWidth="940"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Loaded="WindowOnLoaded"
        Closed="WindowOnClosed">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="26" FontWeight="SemiBold" />
                <TextBlock x:Name="EndpointText" Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource CommandBarSurface}" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Refresh" Click="RefreshOnClick" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Cancel" Click="CancelOnClick" Style="{StaticResource GhostButton}" Margin="6,0,0,0" />
                    <Button Content="Terminate" Click="TerminateOnClick" Style="{StaticResource DangerButton}" Margin="12,0,0,0" />
                    <Button Content="Force kill" Click="ForceKillOnClick" Style="{StaticResource DangerButton}" Margin="6,0,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Search" Foreground="{DynamicResource MutedTextBrush}" />
            <TextBox x:Name="SearchBox"
                     Grid.Column="1"
                     Style="{StaticResource OperationalSearchTextBox}"
                     TextChanged="SearchBoxOnTextChanged" />
        </Grid>

        <Border Grid.Row="2" Margin="0,12,0,10" Padding="10" CornerRadius="7"
                Background="{DynamicResource SurfaceSecondaryBrush}">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="ProcessGrid"
                      Style="{StaticResource OperationalDataGrid}"
                      SelectionChanged="ProcessGridOnSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="0.7*" />
                    <DataGridTextColumn Header="User" Binding="{Binding User}" Width="1.1*" />
                    <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="0.8*" />
                    <DataGridTextColumn Header="Memory" Binding="{Binding MemoryText}" Width="1*" />
                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="0.7*" />
                    <DataGridTextColumn Header="Elapsed" Binding="{Binding ElapsedText}" Width="1*" />
                    <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="1.3*" />
                    <DataGridTextColumn Header="Arguments" Binding="{Binding Arguments}" Width="2.8*" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Margin="14,0,0,0" Style="{StaticResource DetailsPane}">
                <StackPanel>
                    <TextBlock Text="Process details" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="DetailsText" Margin="0,12,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="FooterText" Grid.Row="4" Margin="0,10,0,0"
                   Foreground="{DynamicResource MutedTextBrush}" />
    </Grid>
</Window>
