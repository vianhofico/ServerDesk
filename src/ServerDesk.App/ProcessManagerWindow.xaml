<Window x:Class="ServerDesk.App.ProcessManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource Loc.Processes.WindowTitle}"
        Width="1320"
        Height="820"
        MinWidth="1020"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Loaded="WindowOnLoaded"
        Closed="WindowOnClosed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc.Processes.Header.Title}"
                               Style="{StaticResource PageTitleText}" />
                    <TextBlock Margin="0,2,0,3"
                               Text="{DynamicResource Loc.Processes.Header.Subtitle}"
                               Style="{StaticResource CaptionText}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ServerNameText" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="  ·  " Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="EndpointText"
                                   Style="{StaticResource TechnicalText}"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusPill}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Loc.Processes.Header.Environment}"
                                       Style="{StaticResource CaptionText}" />
                            <TextBlock Text=" · " Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock x:Name="EnvironmentValueText" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Margin="8,0,0,0" Style="{StaticResource AccentStatusPill}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6"
                                     Height="6"
                                     Margin="0,0,7,0"
                                     Fill="{DynamicResource AccentBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="ConnectionValueText" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="20,14,20,0"
                Style="{StaticResource CommandBarSurface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RefreshButton"
                            Click="RefreshOnClick"
                            Style="{StaticResource PrimaryButton}"
                            AutomationProperties.Name="{DynamicResource Loc.Processes.Command.Refresh}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;"
                                       Margin="0,0,7,0"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="White" />
                            <TextBlock Text="{DynamicResource Loc.Processes.Command.Refresh}" Foreground="White" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelButton"
                            Margin="8,0,0,0"
                            Content="{DynamicResource Loc.Processes.Command.Cancel}"
                            Click="CancelOnClick"
                            Style="{StaticResource GhostButton}"
                            IsEnabled="False" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc.Processes.Command.Target}"
                               Style="{StaticResource EyebrowText}" />
                    <TextBlock x:Name="TargetValueText"
                               Margin="0,2,0,0"
                               Style="{StaticResource TechnicalText}"
                               Text="{DynamicResource Loc.Processes.Command.NoTarget}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="TerminateButton"
                            Content="{DynamicResource Loc.Processes.Command.Terminate}"
                            Click="TerminateOnClick"
                            Style="{StaticResource SecondaryButton}"
                            IsEnabled="False" />
                    <Button x:Name="ForceKillButton"
                            Margin="8,0,0,0"
                            Content="{DynamicResource Loc.Processes.Command.ForceKill}"
                            Click="ForceKillOnClick"
                            Style="{StaticResource DangerButton}"
                            IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="20,10,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource MetricTile}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Processes.Summary.Processes}" Style="{StaticResource EyebrowText}" />
                    <TextBlock x:Name="TotalProcessesValue" Margin="0,4,0,0" Text="0" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource MetricTile}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Processes.Summary.Visible}" Style="{StaticResource EyebrowText}" />
                    <TextBlock x:Name="VisibleProcessesValue" Margin="0,4,0,0" Text="0" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource MetricTile}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Processes.Summary.Users}" Style="{StaticResource EyebrowText}" />
                    <TextBlock x:Name="UsersValue" Margin="0,4,0,0" Text="0" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource MetricTile}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Processes.Summary.ResidentMemory}" Style="{StaticResource EyebrowText}" />
                    <TextBlock x:Name="ResidentMemoryValue" Margin="0,4,0,0" Text="0 B" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="20,10,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>
            <Border x:Name="StatusCard"
                    Style="{StaticResource InlineInfoCard}"
                    Margin="0,0,10,0">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Border>
            <Grid Grid.Column="1">
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource OperationalSearchTextBox}"
                         Padding="34,6,36,6"
                         TextChanged="SearchBoxOnTextChanged"
                         ToolTip="{DynamicResource Loc.Processes.Search.Tooltip}"
                         AutomationProperties.Name="{DynamicResource Loc.Processes.Search.Label}" />
                <TextBlock Text="&#xE721;"
                           Margin="11,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="13"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <Button x:Name="ClearSearchButton"
                        Width="32"
                        Height="30"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,3,0"
                        Padding="0"
                        ToolTip="{DynamicResource Loc.Processes.Search.Clear}"
                        Click="ClearSearchOnClick"
                        Style="{StaticResource GhostButton}"
                        Visibility="Collapsed"
                        AutomationProperties.Name="{DynamicResource Loc.Processes.Search.Clear}">
                    <TextBlock Text="&#xE711;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="11" />
                </Button>
            </Grid>
        </Grid>

        <Grid Grid.Row="4" Margin="20,0,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.35*" />
            </Grid.ColumnDefinitions>

            <ui:Card Grid.Column="0" Padding="0" ClipToBounds="True">
                <Grid>
                    <DataGrid x:Name="ProcessGrid"
                              Style="{StaticResource OperationalDataGrid}"
                              BorderThickness="0"
                              SelectionChanged="ProcessGridOnSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Loc.Processes.Column.Pid}" Binding="{Binding ProcessId}" Width="0.65*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource TechnicalText}" /></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{DynamicResource Loc.Processes.Column.User}" Binding="{Binding User}" Width="1.05*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Processes.Column.Cpu}" Binding="{Binding CpuText}" Width="0.75*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource TechnicalText}" /></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{DynamicResource Loc.Processes.Column.Memory}" Binding="{Binding MemoryText}" Width="0.9*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource TechnicalText}" /></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{DynamicResource Loc.Processes.Column.State}" Binding="{Binding State}" Width="0.7*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Processes.Column.Elapsed}" Binding="{Binding ElapsedText}" Width="1*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource TechnicalText}" /></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{DynamicResource Loc.Processes.Column.Command}" Binding="{Binding Command}" Width="1.35*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource TechnicalText}" /></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{DynamicResource Loc.Processes.Column.Arguments}" Binding="{Binding Arguments}" Width="2.6*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource TechnicalText}" /></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border x:Name="GridStateOverlay"
                            Background="{DynamicResource SurfaceBrush}"
                            Visibility="Visible"
                            IsHitTestVisible="False">
                        <StackPanel MaxWidth="500" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="48"
                                    Height="48"
                                    Margin="0,0,0,14"
                                    CornerRadius="14"
                                    Background="{DynamicResource SurfaceSecondaryBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="&#xE77B;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="GridStateTitle"
                                       Style="{StaticResource SectionTitleText}"
                                       TextAlignment="Center" />
                            <TextBlock x:Name="GridStateDetail"
                                       Margin="0,7,0,0"
                                       Style="{StaticResource SecondaryBodyText}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ui:Card>

            <Border Grid.Column="2" Style="{StaticResource DetailsPane}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="&#xE946;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Margin="10,0,0,0"
                                       Text="{DynamicResource Loc.Processes.Details.Title}"
                                       Style="{StaticResource SectionTitleText}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="DetailsHintText"
                                   Margin="0,12,0,0"
                                   Text="{DynamicResource Loc.Processes.Details.Hint}"
                                   Style="{StaticResource SecondaryBodyText}"
                                   TextWrapping="Wrap" />

                        <StackPanel x:Name="DetailsContent" Margin="0,16,0,0" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Loc.Processes.Details.Pid}" Style="{StaticResource EyebrowText}" />
                            <TextBlock x:Name="DetailPidText" Margin="0,3,0,12" Style="{StaticResource TechnicalText}" />
                            <TextBlock Text="{DynamicResource Loc.Processes.Details.ParentPid}" Style="{StaticResource EyebrowText}" />
                            <TextBlock x:Name="DetailParentPidText" Margin="0,3,0,12" Style="{StaticResource TechnicalText}" />
                            <TextBlock Text="{DynamicResource Loc.Processes.Details.User}" Style="{StaticResource EyebrowText}" />
                            <TextBlock x:Name="DetailUserText" Margin="0,3,0,12" TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource Loc.Processes.Details.State}" Style="{StaticResource EyebrowText}" />
                            <TextBlock x:Name="DetailStateText" Margin="0,3,0,12" TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource Loc.Processes.Details.Cpu}" Style="{StaticResource EyebrowText}" />
                            <TextBlock x:Name="DetailCpuText" Margin="0,3,0,12" Style="{StaticResource TechnicalText}" />
                            <TextBlock Text="{DynamicResource Loc.Processes.Details.Memory}" Style="{StaticResource EyebrowText}" />
                            <TextBlock x:Name="DetailMemoryText" Margin="0,3,0,12" Style="{StaticResource TechnicalText}" />
                            <TextBlock Text="{DynamicResource Loc.Processes.Details.Elapsed}" Style="{StaticResource EyebrowText}" />
                            <TextBlock x:Name="DetailElapsedText" Margin="0,3,0,12" Style="{StaticResource TechnicalText}" />
                            <TextBlock Text="{DynamicResource Loc.Processes.Details.Command}" Style="{StaticResource EyebrowText}" />
                            <TextBlock x:Name="DetailCommandText" Margin="0,3,0,12" Style="{StaticResource TechnicalText}" TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource Loc.Processes.Details.Arguments}" Style="{StaticResource EyebrowText}" />
                            <TextBlock x:Name="DetailArgumentsText" Margin="0,3,0,0" Style="{StaticResource TechnicalText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock x:Name="FooterText"
                   Grid.Row="5"
                   Margin="22,10,22,14"
                   Style="{StaticResource CaptionText}"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
