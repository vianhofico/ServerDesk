<Window x:Class="ServerDesk.App.PortForwardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH Tunnels - ServerDesk"
        Width="1120"
        Height="720"
        MinWidth="920"
        MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="46" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SSH Tunnels" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="ServerEndpointText"
                               Margin="0,3,0,0"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <Border Grid.Column="1"
                        Padding="11,6"
                        CornerRadius="14"
                        Background="{DynamicResource AccentSoftBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="Dedicated SSH channel per tunnel"
                               FontSize="12"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="14"
                    CornerRadius="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="2,0,2,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Saved tunnels" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Local, remote and SOCKS forwarding"
                                       Margin="0,2,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="+ Add"
                                Click="AddOnClick"
                                Style="{StaticResource PrimaryButton}" />
                    </Grid>

                    <ListBox x:Name="ForwardList"
                             Grid.Row="1"
                             BorderThickness="0"
                             Background="Transparent"
                             SelectionChanged="ForwardListOnSelectionChanged"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,3" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="11"
                                        CornerRadius="8"
                                        Background="{DynamicResource SurfaceSecondaryBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding RouteLabel}"
                                                       Margin="0,3,0,0"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Padding="8,4"
                                                CornerRadius="10"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StateLabel}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2"
                               Margin="3,10,3,0"
                               Text="Tip: bind port 0 asks the OS/server for a free port. The actual port is shown after Start."
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="22"
                    CornerRadius="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="EditorTitleText" Text="New tunnel" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock x:Name="RuntimeStateText"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="StartStopButton"
                                        Content="Start"
                                        Click="StartStopOnClick"
                                        IsEnabled="False"
                                        Style="{StaticResource PrimaryButton}" />
                                <Button x:Name="DeleteButton"
                                        Content="Delete"
                                        Margin="8,0,0,0"
                                        Click="DeleteOnClick"
                                        IsEnabled="False"
                                        Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                        </Grid>

                        <Border Margin="0,18,0,0"
                                Padding="12"
                                CornerRadius="8"
                                Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock Text="Local and Dynamic tunnels listen on this Windows PC. Remote tunnels listen on the Linux SSH server. Wildcard binds are blocked; non-loopback interface binds require explicit confirmation."
                                       TextWrapping="Wrap"
                                       FontSize="12" />
                        </Border>

                        <Grid x:Name="EditorPanel" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Name" Margin="0,0,0,5" />
                                <TextBox x:Name="NameBox" Style="{StaticResource FieldTextBox}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Type" Margin="0,0,0,5" />
                                <ComboBox x:Name="KindBox"
                                          MinHeight="36"
                                          SelectionChanged="KindBoxOnSelectionChanged" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                                <TextBlock Text="Bind host" Margin="0,0,0,5" />
                                <TextBox x:Name="BindHostBox" Style="{StaticResource FieldTextBox}" TextChanged="BindHostOnTextChanged" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                                <TextBlock Text="Bind port" Margin="0,0,0,5" />
                                <TextBox x:Name="BindPortBox" Style="{StaticResource FieldTextBox}" />
                            </StackPanel>

                            <StackPanel x:Name="DestinationHostPanel" Grid.Row="2" Grid.Column="0" Margin="0,14,0,0">
                                <TextBlock Text="Destination host" Margin="0,0,0,5" />
                                <TextBox x:Name="DestinationHostBox" Style="{StaticResource FieldTextBox}" />
                            </StackPanel>
                            <StackPanel x:Name="DestinationPortPanel" Grid.Row="2" Grid.Column="2" Margin="0,14,0,0">
                                <TextBlock Text="Destination port" Margin="0,0,0,5" />
                                <TextBox x:Name="DestinationPortBox" Style="{StaticResource FieldTextBox}" />
                            </StackPanel>

                            <Border x:Name="ExposureWarning"
                                    Grid.Row="3"
                                    Grid.ColumnSpan="3"
                                    Margin="0,14,0,0"
                                    Padding="11"
                                    CornerRadius="8"
                                    BorderBrush="{DynamicResource DangerBrush}"
                                    BorderThickness="1"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="ExposureWarningText"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource DangerBrush}" />
                            </Border>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button x:Name="SaveButton"
                                    Content="Save tunnel"
                                    Click="SaveOnClick"
                                    Style="{StaticResource PrimaryButton}" />
                            <Button Content="Reset"
                                    Margin="8,0,0,0"
                                    Click="ResetOnClick"
                                    Style="{StaticResource SecondaryButton}" />
                        </StackPanel>

                        <Border x:Name="ErrorPanel"
                                Margin="0,16,0,0"
                                Padding="11"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource DangerBrush}"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <TextBlock x:Name="ErrorText"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource DangerBrush}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Saved tunnel profiles contain metadata only; SSH credentials stay in Windows Credential Manager." />
            </Grid>
        </Border>
    </Grid>
</Window>
