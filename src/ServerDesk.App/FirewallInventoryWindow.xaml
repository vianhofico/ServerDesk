<Window x:Class="ServerDesk.App.FirewallInventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.Firewall.WindowTitle}"
        Width="1260"
        Height="780"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Loc.Firewall.Subtitle}"
                           Margin="0,4,0,0"
                           Opacity="0.72"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="StatusText"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="RefreshButton"
                        Content="{DynamicResource Loc.Firewall.Refresh}"
                        MinWidth="92"
                        Padding="14,7"
                        Click="RefreshOnClick" />
                <Button x:Name="CancelButton"
                        Content="{DynamicResource Loc.Firewall.Cancel}"
                        MinWidth="92"
                        Padding="14,7"
                        Margin="8,0,0,0"
                        IsEnabled="False"
                        Click="CancelOnClick" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="AdapterSummaryText"
                   Grid.Row="1"
                   Margin="0,12,0,0"
                   Opacity="0.75"
                   TextWrapping="Wrap" />

        <TextBox x:Name="SearchTextBox"
                 Grid.Row="2"
                 Margin="0,12,0,12"
                 MinHeight="34"
                 Padding="10,6"
                 ToolTip="{DynamicResource Loc.Firewall.Search}"
                 TextChanged="SearchOnTextChanged" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="RuleGrid"
                      Grid.Column="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      SelectionChanged="RuleSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Loc.Firewall.Adapter}" Binding="{Binding Adapter}" Width="95" />
                    <DataGridTextColumn Header="{DynamicResource Loc.Firewall.Zone}" Binding="{Binding Zone}" Width="110" />
                    <DataGridTextColumn Header="{DynamicResource Loc.Firewall.Action}" Binding="{Binding Action}" Width="100" />
                    <DataGridTextColumn Header="{DynamicResource Loc.Firewall.Direction}" Binding="{Binding Direction}" Width="105" />
                    <DataGridTextColumn Header="{DynamicResource Loc.Firewall.Protocol}" Binding="{Binding Protocol}" Width="85" />
                    <DataGridTextColumn Header="{DynamicResource Loc.Firewall.PortService}" Binding="{Binding PortOrService}" Width="*" />
                    <DataGridTextColumn Header="{DynamicResource Loc.Firewall.Source}" Binding="{Binding Source}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2"
                    BorderThickness="1"
                    BorderBrush="#22000000"
                    CornerRadius="6"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SelectedTitleText"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="AdapterZoneText" Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="ActionDirectionText" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="ProtocolTargetText" Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="SourceDestinationText" Grid.Row="4" Margin="0,8,0,8" TextWrapping="Wrap" />
                    <TextBox x:Name="RawRuleTextBox"
                             Grid.Row="5"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="12"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="4"
                   Margin="0,12,0,0"
                   Text="{DynamicResource Loc.Firewall.SafetyFooter}"
                   Opacity="0.72"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
