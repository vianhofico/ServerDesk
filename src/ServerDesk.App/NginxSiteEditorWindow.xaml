<Window x:Class="ServerDesk.App.NginxSiteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.Nginx.Editor.WindowTitle}"
        Width="1080"
        Height="780"
        MinWidth="900"
        MinHeight="640"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText"
                       FontSize="24"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource Loc.Nginx.Editor.Subtitle}"
                       Margin="0,4,0,0"
                       Opacity="0.72"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="StatusText"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Loc.Nginx.Editor.RequestedPath}"
                       FontWeight="SemiBold"
                       Margin="0,0,12,6" />
            <TextBlock x:Name="RequestedPathText"
                       Grid.Column="1"
                       Margin="0,0,0,6"
                       FontFamily="Cascadia Mono, Consolas"
                       TextWrapping="Wrap" />
            <TextBlock Grid.Row="1"
                       Text="{DynamicResource Loc.Nginx.Editor.CanonicalPath}"
                       FontWeight="SemiBold"
                       Margin="0,0,12,0" />
            <TextBlock x:Name="CanonicalPathText"
                       Grid.Row="1"
                       Grid.Column="1"
                       FontFamily="Cascadia Mono, Consolas"
                       TextWrapping="Wrap" />
        </Grid>

        <TabControl x:Name="EditorTabs" Grid.Row="2">
            <TabItem Header="{DynamicResource Loc.Nginx.Editor.SimpleTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="{DynamicResource Loc.Nginx.Editor.SimpleHelp}"
                                   TextWrapping="Wrap"
                                   Opacity="0.76"
                                   Margin="0,0,0,16" />
                        <TextBlock Text="{DynamicResource Loc.Nginx.Editor.ServerNames}"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="ServerNamesTextBox"
                                 Margin="0,5,0,14"
                                 MinHeight="34"
                                 Padding="9,6" />
                        <TextBlock Text="{DynamicResource Loc.Nginx.Editor.Listen}"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="ListenTextBox"
                                 Margin="0,5,0,14"
                                 MinHeight="34"
                                 Padding="9,6" />
                        <TextBlock Text="{DynamicResource Loc.Nginx.Editor.ProxyPass}"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="ProxyPassTextBox"
                                 Margin="0,5,0,16"
                                 MinHeight="34"
                                 Padding="9,6" />
                        <Button x:Name="ApplyFieldsButton"
                                Content="{DynamicResource Loc.Nginx.Editor.ApplyFields}"
                                HorizontalAlignment="Left"
                                MinWidth="190"
                                Padding="14,8"
                                Click="ApplyFieldsOnClick" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="RawTab" Header="{DynamicResource Loc.Nginx.Editor.RawTab}">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Loc.Nginx.Editor.RawWarning}"
                               TextWrapping="Wrap"
                               Opacity="0.76"
                               Margin="0,0,0,10" />
                    <TextBox x:Name="RawTextBox"
                             Grid.Row="1"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="12"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"
                             TextChanged="RawTextChanged" />
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DiffText"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,14,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ReloadButton"
                        Content="{DynamicResource Loc.Nginx.Editor.Reload}"
                        MinWidth="110"
                        Padding="14,8"
                        IsEnabled="False"
                        Click="ReloadOnClick" />
                <Button x:Name="CancelButton"
                        Content="{DynamicResource Loc.Nginx.Cancel}"
                        MinWidth="100"
                        Padding="14,8"
                        Margin="8,0,0,0"
                        IsEnabled="False"
                        Click="CancelOnClick" />
                <Button x:Name="ApplyButton"
                        Content="{DynamicResource Loc.Nginx.Editor.Apply}"
                        MinWidth="150"
                        Padding="14,8"
                        Margin="8,0,0,0"
                        IsEnabled="False"
                        Click="ApplyOnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
