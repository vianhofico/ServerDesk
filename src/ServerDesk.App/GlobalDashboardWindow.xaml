<Window x:Class="ServerDesk.App.GlobalDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.GlobalDashboard.WindowTitle}"
        Width="1320"
        Height="760"
        MinWidth="1040"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource Loc.GlobalDashboard.Title}"
                           FontSize="26"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,5,0,0"
                           Text="{DynamicResource Loc.GlobalDashboard.Subtitle}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Margin="18,0,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Top">
                <Button x:Name="RefreshButton"
                        Padding="14,7"
                        Content="{DynamicResource Loc.GlobalDashboard.Refresh}"
                        Click="RefreshOnClick" />
                <Button x:Name="CancelButton"
                        Margin="8,0,0,0"
                        Padding="14,7"
                        Content="{DynamicResource Loc.GlobalDashboard.Cancel}"
                        Click="CancelOnClick" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,18,0,14"
                Padding="14"
                CornerRadius="9"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="{DynamicResource Loc.GlobalDashboard.Search}"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBox x:Name="SearchTextBox" Margin="0,4,0,0" MinHeight="32" Padding="8,5" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="{DynamicResource Loc.GlobalDashboard.Group}"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBox x:Name="GroupTextBox" Margin="0,4,0,0" MinHeight="32" Padding="8,5" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="{DynamicResource Loc.GlobalDashboard.Tag}"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBox x:Name="TagTextBox" Margin="0,4,0,0" MinHeight="32" Padding="8,5" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="{DynamicResource Loc.GlobalDashboard.Environment}"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBox x:Name="EnvironmentTextBox" Margin="0,4,0,0" MinHeight="32" Padding="8,5" />
                </StackPanel>
                <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                    <CheckBox x:Name="FavoritesOnlyCheckBox"
                              Margin="0,0,0,7"
                              Content="{DynamicResource Loc.GlobalDashboard.Favorites}" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ApplyButton"
                                Padding="12,6"
                                Content="{DynamicResource Loc.GlobalDashboard.Apply}"
                                Click="ApplyFiltersOnClick" />
                        <Button x:Name="ClearButton"
                                Margin="7,0,0,0"
                                Padding="12,6"
                                Content="{DynamicResource Loc.GlobalDashboard.Clear}"
                                Click="ClearFiltersOnClick" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="8"
                CornerRadius="10"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <DataGrid ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="Transparent"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Loc.GlobalDashboard.ColumnFavorite}"
                                        Binding="{Binding FavoriteDisplay}"
                                        Width="54" />
                    <DataGridTextColumn Header="{DynamicResource Loc.GlobalDashboard.ColumnServer}"
                                        Binding="{Binding Name}"
                                        Width="150" />
                    <DataGridTextColumn Header="{DynamicResource Loc.GlobalDashboard.ColumnEndpoint}"
                                        Binding="{Binding Endpoint}"
                                        Width="190" />
                    <DataGridTextColumn Header="{DynamicResource Loc.GlobalDashboard.ColumnEnvironment}"
                                        Binding="{Binding EnvironmentDisplay}"
                                        Width="110" />
                    <DataGridTextColumn Header="{DynamicResource Loc.GlobalDashboard.ColumnGroup}"
                                        Binding="{Binding GroupDisplay}"
                                        Width="110" />
                    <DataGridTextColumn Header="{DynamicResource Loc.GlobalDashboard.ColumnTags}"
                                        Binding="{Binding TagsDisplay}"
                                        Width="150" />
                    <DataGridTextColumn Header="{DynamicResource Loc.GlobalDashboard.ColumnConnection}"
                                        Binding="{Binding ConnectionDisplay}"
                                        Width="118" />
                    <DataGridTemplateColumn Header="{DynamicResource Loc.GlobalDashboard.ColumnHealth}" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding HealthDisplay}"
                                           ToolTip="{Binding HealthDetail}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="CPU" Binding="{Binding CpuDisplay}" Width="72" />
                    <DataGridTextColumn Header="{DynamicResource Loc.GlobalDashboard.ColumnMemory}"
                                        Binding="{Binding MemoryDisplay}"
                                        Width="82" />
                    <DataGridTextColumn Header="{DynamicResource Loc.GlobalDashboard.ColumnDisk}"
                                        Binding="{Binding DiskDisplay}"
                                        Width="82" />
                    <DataGridTextColumn Header="{DynamicResource Loc.GlobalDashboard.ColumnWarnings}"
                                        Binding="{Binding WarningsDisplay}"
                                        Width="92" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText"
                       MaxWidth="980"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <Button HorizontalAlignment="Right"
                    Padding="14,7"
                    Content="{DynamicResource Loc.GlobalDashboard.Close}"
                    IsCancel="True" />
        </Grid>
    </Grid>
</Window>
