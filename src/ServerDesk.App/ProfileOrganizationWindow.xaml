<Window x:Class="ServerDesk.App.ProfileOrganizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Organize servers"
        Width="980"
        Height="680"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Organize servers" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,0"
                       Text="Search by name, host, username, environment, group or tag. Organization metadata is local only and never contains credentials."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,14"
                Padding="14"
                CornerRadius="9"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Search" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBox x:Name="SearchTextBox" Margin="0,4,0,0" MinHeight="32" Padding="8,5" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Group" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBox x:Name="GroupFilterTextBox" Margin="0,4,0,0" MinHeight="32" Padding="8,5" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Tag" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBox x:Name="TagFilterTextBox" Margin="0,4,0,0" MinHeight="32" Padding="8,5" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="Environment" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBox x:Name="EnvironmentFilterTextBox" Margin="0,4,0,0" MinHeight="32" Padding="8,5" />
                </StackPanel>
                <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                    <CheckBox x:Name="FavoritesOnlyCheckBox" Content="Favorites" Margin="0,0,0,7" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Apply" Padding="12,6" Click="ApplyFilterOnClick" />
                        <Button Content="Clear" Margin="7,0,0,0" Padding="12,6" Click="ClearFilterOnClick" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="10"
                    CornerRadius="10"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ResultCountText" Margin="4,2,4,8" FontWeight="SemiBold" />
                    <ListBox x:Name="ProfilesListBox"
                             Grid.Row="1"
                             BorderThickness="0"
                             Background="Transparent"
                             SelectionChanged="ProfileSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Profile.Name}" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Text="{Binding Profile.Host}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Text="{Binding Organization.GroupName, TargetNullValue=Ungrouped}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Margin="10,0,0,0"
                                               Text="★"
                                               FontSize="17"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Organization.IsFavorite}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="18"
                    CornerRadius="10"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="SelectedProfileNameText" Text="Select a server" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock x:Name="SelectedProfileEndpointText"
                               Margin="0,4,0,18"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" />

                    <TextBlock Text="Group" />
                    <TextBox x:Name="GroupNameTextBox" Margin="0,5,0,0" MinHeight="34" Padding="9,5" IsEnabled="False" />

                    <TextBlock Margin="0,14,0,0" Text="Tags" />
                    <TextBox x:Name="TagsTextBox" Margin="0,5,0,0" MinHeight="34" Padding="9,5" IsEnabled="False" />
                    <TextBlock Margin="0,4,0,0"
                               Text="Comma-separated, maximum 20 tags and 32 characters per tag."
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" />

                    <CheckBox x:Name="FavoriteCheckBox"
                              Margin="0,16,0,0"
                              Content="Favorite server"
                              IsEnabled="False" />

                    <Button x:Name="SaveOrganizationButton"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Left"
                            Content="Save organization"
                            Padding="14,7"
                            IsEnabled="False"
                            Click="SaveOrganizationOnClick" />

                    <TextBlock x:Name="EditorStatusText"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock VerticalAlignment="Center"
                       Text="Organization rows are removed with the server profile; no password, passphrase, private-key content or MFA response is stored here."
                       FontSize="11"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <Button HorizontalAlignment="Right" Content="Close" Padding="14,7" IsCancel="True" />
        </Grid>
    </Grid>
</Window>
