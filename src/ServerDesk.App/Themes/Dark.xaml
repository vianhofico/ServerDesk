<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#15171A</Color>
    <Color x:Key="SurfaceColor">#1F2226</Color>
    <Color x:Key="SurfaceSecondaryColor">#292D32</Color>
    <Color x:Key="SurfaceHoverColor">#31363D</Color>
    <Color x:Key="BorderColor">#343940</Color>
    <Color x:Key="PrimaryTextColor">#F5F6F7</Color>
    <Color x:Key="MutedTextColor">#A9AFB7</Color>
    <Color x:Key="AccentColor">#6EA8FE</Color>
    <Color x:Key="AccentHoverColor">#8BB9FF</Color>
    <Color x:Key="AccentSoftColor">#23395F</Color>
    <Color x:Key="SuccessColor">#6CCB83</Color>
    <Color x:Key="WarningColor">#F4B860</Color>
    <Color x:Key="DangerColor">#FF8A7A</Color>
    <Color x:Key="DangerSoftColor">#4B2828</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{StaticResource SurfaceSecondaryColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
</ResourceDictionary>
