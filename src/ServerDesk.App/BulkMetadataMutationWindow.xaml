<Window x:Class="ServerDesk.App.BulkMetadataMutationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.Bulk.WindowTitle}"
        Width="940"
        Height="650"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{DynamicResource Loc.Bulk.Title}"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,0"
                       Text="{DynamicResource Loc.Bulk.Subtitle}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <TextBlock x:Name="TargetSummaryText"
                       Margin="0,7,0,0"
                       FontWeight="SemiBold" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,14"
                Padding="14"
                CornerRadius="9"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="{DynamicResource Loc.Bulk.Operation}"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <ComboBox x:Name="OperationComboBox"
                              Margin="0,4,0,0"
                              MinHeight="32"
                              SelectionChanged="OperationOnSelectionChanged" />
                </StackPanel>
                <StackPanel x:Name="TagPanel" Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Text="{DynamicResource Loc.Bulk.Tag}"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBox x:Name="TagTextBox"
                             Margin="0,4,0,0"
                             MinHeight="32"
                             Padding="8,5"
                             TextChanged="TagOnTextChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="OperationSummaryText"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <CheckBox x:Name="ReviewedCheckBox"
                              Margin="0,10,0,0"
                              Content="{DynamicResource Loc.Bulk.ReviewAcknowledgement}"
                              Click="ReviewedOnClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="8"
                CornerRadius="10"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <DataGrid ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="Transparent"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Loc.Bulk.ColumnServer}"
                                        Binding="{Binding Name}"
                                        Width="180" />
                    <DataGridTextColumn Header="{DynamicResource Loc.Bulk.ColumnEndpoint}"
                                        Binding="{Binding Endpoint}"
                                        Width="260" />
                    <DataGridTextColumn Header="{DynamicResource Loc.Bulk.ColumnResult}"
                                        Binding="{Binding StateDisplay}"
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText"
                       MaxWidth="590"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="ApplyButton"
                        Padding="14,7"
                        Content="{DynamicResource Loc.Bulk.Apply}"
                        Click="ApplyOnClick" />
                <Button x:Name="CancelButton"
                        Margin="8,0,0,0"
                        Padding="14,7"
                        Content="{DynamicResource Loc.Bulk.Cancel}"
                        Click="CancelOnClick" />
                <Button x:Name="CloseButton"
                        Margin="8,0,0,0"
                        Padding="14,7"
                        Content="{DynamicResource Loc.Bulk.Close}"
                        Click="CloseOnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
