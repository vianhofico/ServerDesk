<Window x:Class="ServerDesk.App.DatabaseRestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.DatabaseRestores.WindowTitle}"
        Width="1040"
        Height="780"
        MinWidth="860"
        MinHeight="640"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Loc.DatabaseRestores.Subtitle}"
                       Margin="0,5,0,0"
                       Opacity="0.72"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="StatusText"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,14,0,0"
                Padding="14"
                BorderThickness="1"
                BorderBrush="#22000000"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{DynamicResource Loc.DatabaseRestores.Server}" FontWeight="SemiBold" />
                <TextBlock x:Name="ServerText" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{DynamicResource Loc.DatabaseRestores.Engine}" FontWeight="SemiBold" />
                <TextBlock x:Name="EngineText" Grid.Row="0" Grid.Column="4" />

                <TextBlock Grid.Row="1" Margin="0,7,0,0" Text="{DynamicResource Loc.DatabaseRestores.Target}" FontWeight="SemiBold" />
                <TextBlock x:Name="TargetText" Grid.Row="1" Grid.Column="1" Margin="0,7,0,0" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,7,0,0" Text="{DynamicResource Loc.DatabaseRestores.BackupId}" FontWeight="SemiBold" />
                <TextBlock x:Name="BackupIdText" Grid.Row="1" Grid.Column="4" Margin="0,7,0,0" TextWrapping="Wrap" />

                <TextBlock Grid.Row="2" Margin="0,7,0,0" Text="{DynamicResource Loc.DatabaseRestores.BackupPath}" FontWeight="SemiBold" />
                <TextBlock x:Name="BackupPathText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,7,0,0" TextWrapping="Wrap" />

                <TextBlock Grid.Row="3" Margin="0,7,0,0" Text="{DynamicResource Loc.DatabaseRestores.BackupSha}" FontWeight="SemiBold" />
                <TextBlock x:Name="BackupShaText" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,7,0,0" TextWrapping="Wrap" />

                <TextBlock Grid.Row="4" Margin="0,7,0,0" Text="{DynamicResource Loc.DatabaseRestores.BackupSize}" FontWeight="SemiBold" />
                <TextBlock x:Name="BackupSizeText" Grid.Row="4" Grid.Column="1" Margin="0,7,0,0" />
                <TextBlock Grid.Row="4" Grid.Column="3" Margin="0,7,0,0" Text="{DynamicResource Loc.DatabaseRestores.BackupTool}" FontWeight="SemiBold" />
                <TextBlock x:Name="BackupToolText" Grid.Row="4" Grid.Column="4" Margin="0,7,0,0" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PreviewButton"
                            Content="{DynamicResource Loc.DatabaseRestores.Preview}"
                            Padding="14,8"
                            Click="PreviewOnClick" />
                    <Button x:Name="ExecuteButton"
                            Grid.Column="1"
                            Content="{DynamicResource Loc.DatabaseRestores.Execute}"
                            Margin="10,0,0,0"
                            Padding="14,8"
                            IsEnabled="False"
                            Click="ExecuteOnClick" />
                </Grid>

                <Border Margin="0,14,0,0"
                        Padding="14"
                        BorderThickness="1"
                        BorderBrush="#22000000"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.DatabaseRestores.RestoreTool}" FontWeight="SemiBold" />
                        <TextBlock x:Name="RestoreToolText" Margin="0,3,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="{DynamicResource Loc.DatabaseRestores.LiveIdentity}" Margin="0,12,0,0" FontWeight="SemiBold" />
                        <TextBlock x:Name="LiveIdentityText" Margin="0,3,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="{DynamicResource Loc.DatabaseRestores.LiveObjects}" Margin="0,12,0,0" FontWeight="SemiBold" />
                        <TextBlock x:Name="LiveObjectsText" Margin="0,3,0,0" />

                        <TextBlock Text="{DynamicResource Loc.DatabaseRestores.Command}" Margin="0,12,0,0" FontWeight="SemiBold" />
                        <TextBox x:Name="CommandText"
                                 Margin="0,3,0,0"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 BorderThickness="0"
                                 Background="Transparent" />

                        <TextBlock Text="{DynamicResource Loc.DatabaseRestores.Warning}" Margin="0,12,0,0" FontWeight="SemiBold" />
                        <TextBlock x:Name="WarningText" Margin="0,3,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="{DynamicResource Loc.DatabaseRestores.Rollback}" Margin="0,12,0,0" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Loc.DatabaseRestores.RollbackUnavailable}"
                                   Margin="0,3,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Loc.DatabaseRestores.SafetyFooter}"
                       Opacity="0.72"
                       TextWrapping="Wrap"
                       Margin="0,0,18,0" />
            <Button Grid.Column="1"
                    Content="{DynamicResource Loc.DatabaseRestores.Close}"
                    Padding="14,7"
                    VerticalAlignment="Bottom"
                    Click="CloseOnClick" />
        </Grid>
    </Grid>
</Window>
