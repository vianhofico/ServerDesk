<Window x:Class="ServerDesk.App.DockerComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Docker Compose"
        Width="1420"
        Height="860"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Loaded="WindowOnLoaded"
        Closed="WindowOnClosed">
    <Window.Resources>
        <Style x:Key="ComposeButton" TargetType="Button">
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="26" FontWeight="SemiBold" />
                <TextBlock x:Name="EndpointText" Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="{DynamicResource Loc.Compose.Refresh}" Click="RefreshOnClick" Style="{StaticResource ComposeButton}" Margin="0" />
                <Button Content="{DynamicResource Loc.Common.Cancel}" Click="CancelOnClick" Style="{StaticResource ComposeButton}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,14,0,12" Padding="10" CornerRadius="7"
                Background="{DynamicResource SurfaceSecondaryBrush}">
            <StackPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
                <TextBlock x:Name="RuntimeText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="12" CornerRadius="9" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Loc.Compose.Projects}" FontWeight="SemiBold" FontSize="16" />
                    <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,10,0,10"
                             TextChanged="SearchBoxOnTextChanged"
                             ToolTip="{DynamicResource Loc.Compose.SearchHint}" />
                    <DataGrid x:Name="ProjectGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionChanged="ProjectGridOnSelectionChanged"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Loc.Compose.Project}" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Compose.Status}" Binding="{Binding Status}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="14" CornerRadius="9" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ProjectTitleText" Text="{DynamicResource Loc.Compose.SelectProject}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="ConfigPathText" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Button Content="{DynamicResource Loc.Compose.Up}" Tag="Up" Click="ActionOnClick" Style="{StaticResource ComposeButton}" IsEnabled="False" />
                            <Button Content="{DynamicResource Loc.Compose.Restart}" Tag="Restart" Click="ActionOnClick" Style="{StaticResource ComposeButton}" IsEnabled="False" />
                            <Button Content="{DynamicResource Loc.Compose.Pull}" Tag="Pull" Click="ActionOnClick" Style="{StaticResource ComposeButton}" IsEnabled="False" />
                            <Button Content="{DynamicResource Loc.Compose.Build}" Tag="Build" Click="ActionOnClick" Style="{StaticResource ComposeButton}" IsEnabled="False" />
                            <Button Content="{DynamicResource Loc.Compose.Down}" Tag="Down" Click="ActionOnClick" Style="{StaticResource ComposeButton}" IsEnabled="False" />
                        </WrapPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,8">
                        <Button x:Name="EditConfigButton" Content="{DynamicResource Loc.Compose.EditYaml}" Click="EditConfigOnClick"
                                Style="{StaticResource ComposeButton}" Margin="0" IsEnabled="False" />
                        <Button x:Name="RefreshProjectButton" Content="{DynamicResource Loc.Compose.RefreshProject}" Click="RefreshProjectOnClick"
                                Style="{StaticResource ComposeButton}" IsEnabled="False" />
                        <Button x:Name="LogsButton" Content="{DynamicResource Loc.Compose.RefreshLogs}" Click="LogsOnClick"
                                Style="{StaticResource ComposeButton}" IsEnabled="False" />
                    </StackPanel>

                    <TabControl Grid.Row="2">
                        <TabItem Header="{DynamicResource Loc.Compose.Services}">
                            <DataGrid x:Name="ServiceGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource Loc.Compose.Service}" Binding="{Binding Service}" Width="150" />
                                    <DataGridTextColumn Header="{DynamicResource Loc.Compose.Container}" Binding="{Binding Name}" Width="180" />
                                    <DataGridTextColumn Header="{DynamicResource Loc.Compose.Image}" Binding="{Binding Image}" Width="200" />
                                    <DataGridTextColumn Header="{DynamicResource Loc.Compose.State}" Binding="{Binding State}" Width="100" />
                                    <DataGridTextColumn Header="{DynamicResource Loc.Compose.Status}" Binding="{Binding Status}" Width="*" />
                                    <DataGridTextColumn Header="{DynamicResource Loc.Compose.Ports}" Binding="{Binding Publishers}" Width="180" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="{DynamicResource Loc.Compose.NormalizedConfig}">
                            <TextBox x:Name="ConfigJsonBox" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                                     FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        </TabItem>
                        <TabItem Header="{DynamicResource Loc.Compose.Logs}">
                            <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="12"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Margin="0,10,0,0" Text="{DynamicResource Loc.Compose.SafetyFooter}"
                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
    </Grid>
</Window>
