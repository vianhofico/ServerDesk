<Window x:Class="ServerDesk.App.ServiceManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Services"
        Width="1260"
        Height="780"
        MinWidth="980"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Loaded="WindowOnLoaded"
        Closed="WindowOnClosed">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="26" FontWeight="SemiBold" />
                <TextBlock x:Name="EndpointText" Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource CommandBarSurface}" VerticalAlignment="Top">
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="Refresh" Click="RefreshOnClick" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Details" Click="DetailsOnClick" Style="{StaticResource GhostButton}" Margin="6,0,0,0" />
                    <Button Content="Cancel" Click="CancelOnClick" Style="{StaticResource GhostButton}" Margin="6,0,0,0" />
                    <Button Content="Start" Click="StartOnClick" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" />
                    <Button Content="Stop" Click="StopOnClick" Style="{StaticResource DangerButton}" Margin="6,0,0,0" />
                    <Button Content="Restart" Click="RestartOnClick" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" />
                    <Button Content="Reload" Click="ReloadOnClick" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" />
                    <Button Content="Enable" Click="EnableOnClick" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" />
                    <Button Content="Disable" Click="DisableOnClick" Style="{StaticResource DangerButton}" Margin="6,0,0,0" />
                </WrapPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Search" Foreground="{DynamicResource MutedTextBrush}" />
            <TextBox x:Name="SearchBox"
                     Grid.Column="1"
                     Style="{StaticResource OperationalSearchTextBox}"
                     TextChanged="SearchBoxOnTextChanged" />
        </Grid>

        <Border Grid.Row="2" Margin="0,12,0,10" Padding="10" CornerRadius="7"
                Background="{DynamicResource SurfaceSecondaryBrush}">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.2*" />
                <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="ServiceGrid"
                      Style="{StaticResource OperationalDataGrid}"
                      SelectionChanged="ServiceGridOnSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="1.8*" />
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2.5*" />
                    <DataGridTextColumn Header="Load" Binding="{Binding LoadState}" Width="0.8*" />
                    <DataGridTextColumn Header="Active" Binding="{Binding ActiveState}" Width="0.9*" />
                    <DataGridTextColumn Header="Sub" Binding="{Binding SubState}" Width="0.9*" />
                    <DataGridTextColumn Header="Enabled" Binding="{Binding EnabledState}" Width="1*" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Margin="14,0,0,0" Style="{StaticResource DetailsPane}">
                <StackPanel>
                    <TextBlock Text="Service details" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="DetailsText" Margin="0,12,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <Button x:Name="LogsButton"
                            Content="Open logs"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Left"
                            IsEnabled="False"
                            Click="LogsOnClick"
                            Style="{StaticResource SecondaryButton}"
                            ToolTip="Open the shared Logs viewer filtered to this systemd unit." />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="FooterText" Grid.Row="4" Margin="0,10,0,0"
                   Foreground="{DynamicResource MutedTextBrush}" />
    </Grid>
</Window>
