<Window x:Class="ServerDesk.App.ServiceManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Services"
        Width="1260"
        Height="780"
        MinWidth="980"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Loaded="WindowOnLoaded"
        Closed="WindowOnClosed">
    <Window.Resources>
        <Style x:Key="ServiceButton" TargetType="Button">
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="26" FontWeight="SemiBold" />
                <TextBlock x:Name="EndpointText" Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Refresh" Click="RefreshOnClick" Style="{StaticResource ServiceButton}" Margin="0" />
                <Button Content="Details" Click="DetailsOnClick" Style="{StaticResource ServiceButton}" />
                <Button Content="Cancel" Click="CancelOnClick" Style="{StaticResource ServiceButton}" />
                <Button Content="Start" Click="StartOnClick" Style="{StaticResource ServiceButton}" />
                <Button Content="Stop" Click="StopOnClick" Style="{StaticResource ServiceButton}" />
                <Button Content="Restart" Click="RestartOnClick" Style="{StaticResource ServiceButton}" />
                <Button Content="Reload" Click="ReloadOnClick" Style="{StaticResource ServiceButton}" />
                <Button Content="Enable" Click="EnableOnClick" Style="{StaticResource ServiceButton}" />
                <Button Content="Disable" Click="DisableOnClick" Style="{StaticResource ServiceButton}" />
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Search" Foreground="{DynamicResource MutedTextBrush}" />
            <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="SearchBoxOnTextChanged" />
        </Grid>

        <Border Grid.Row="2" Margin="0,12,0,10" Padding="10" CornerRadius="7"
                Background="{DynamicResource SurfaceSecondaryBrush}">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.2*" />
                <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="ServiceGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      SelectionChanged="ServiceGridOnSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="1.8*" />
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2.5*" />
                    <DataGridTextColumn Header="Load" Binding="{Binding LoadState}" Width="0.8*" />
                    <DataGridTextColumn Header="Active" Binding="{Binding ActiveState}" Width="0.9*" />
                    <DataGridTextColumn Header="Sub" Binding="{Binding SubState}" Width="0.9*" />
                    <DataGridTextColumn Header="Enabled" Binding="{Binding EnabledState}" Width="1*" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Margin="14,0,0,0" Padding="14" CornerRadius="8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Service details" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="DetailsText" Margin="0,12,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <Button x:Name="LogsButton" Content="Open logs" Margin="0,16,0,0" Padding="10,6"
                            HorizontalAlignment="Left" IsEnabled="False" Click="LogsOnClick"
                            ToolTip="Open the shared Logs viewer filtered to this systemd unit." />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="FooterText" Grid.Row="4" Margin="0,10,0,0"
                   Foreground="{DynamicResource MutedTextBrush}" />
    </Grid>
</Window>
