<Window x:Class="ServerDesk.App.DockerDestructiveConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Docker action"
        Width="540"
        Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" />
        <TextBlock x:Name="WarningText" Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap" />
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="PromptText" Foreground="{DynamicResource MutedTextBrush}" />
            <TextBox x:Name="ConfirmationTextBox" Margin="0,6,0,0" TextChanged="ConfirmationOnChanged" />
        </StackPanel>
        <TextBlock Grid.Row="3" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Text="The destructive action is never retried automatically if ServerDesk loses a reliable completion signal." />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="92" Margin="0,0,8,0" IsCancel="True" />
            <Button x:Name="ConfirmButton" Content="Confirm" Width="110" IsDefault="True"
                    IsEnabled="False" Click="ConfirmOnClick" />
        </StackPanel>
    </Grid>
</Window>
