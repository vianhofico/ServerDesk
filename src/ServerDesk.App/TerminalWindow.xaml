<Window x:Class="ServerDesk.App.TerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ServerDesk Terminal"
        Width="1220"
        Height="780"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Server"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <ComboBox x:Name="ServerPicker"
                          Grid.Column="1"
                          DisplayMemberPath="Name"
                          VerticalContentAlignment="Center" />
                <Button Grid.Column="2"
                        Margin="10,0,0,0"
                        Padding="14,7"
                        Content="+ New terminal"
                        Click="NewTerminalOnClick" />
                <Button Grid.Column="3"
                        Margin="8,0,0,0"
                        Padding="12,7"
                        Content="Close tab"
                        Click="CloseTabOnClick" />
                <TextBlock x:Name="StatusText"
                           Grid.Column="5"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Ready" />
            </Grid>
        </Border>

        <TabControl x:Name="TerminalTabs"
                    Grid.Row="1"
                    Margin="10"
                    SelectionChanged="TerminalTabsOnSelectionChanged" />

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock Margin="14,0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Text="Ctrl+Shift+F search  •  Ctrl+Shift+C copy selection  •  Ctrl+Shift+V paste  •  Ctrl+C remains remote SIGINT" />
        </Border>
    </Grid>
</Window>
