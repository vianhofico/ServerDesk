<Window x:Class="ServerDesk.App.TerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource Loc.Terminal.WindowTitle}"
        Width="1280"
        Height="820"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <!-- Terminal identity and current session state. -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc.Terminal.Header.Title}"
                               Style="{StaticResource PageTitleText}" />
                    <TextBlock Margin="0,3,0,0"
                               Text="{DynamicResource Loc.Terminal.Header.Subtitle}"
                               Style="{StaticResource CaptionText}" />
                </StackPanel>

                <Border Grid.Column="1"
                        MaxWidth="520"
                        Style="{StaticResource AccentStatusPill}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6"
                                 Height="6"
                                 Margin="0,0,7,0"
                                 Fill="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText"
                                   Text="{DynamicResource Loc.Terminal.Status.Ready}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Session controls stay outside the terminal so terminal keystrokes are never intercepted. -->
        <Border Grid.Row="1"
                Margin="20,14,20,0"
                Style="{StaticResource CommandBarSurface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc.Terminal.Server.Label}"
                               Style="{StaticResource FormLabelText}"
                               Margin="0" />
                </StackPanel>

                <ComboBox x:Name="ServerPicker"
                          Grid.Column="1"
                          DisplayMemberPath="Name"
                          VerticalContentAlignment="Center"
                          ToolTip="{DynamicResource Loc.Terminal.Server.Hint}"
                          AutomationProperties.Name="{DynamicResource Loc.Terminal.Server.Label}" />

                <Button Grid.Column="2"
                        Margin="10,0,0,0"
                        Click="NewTerminalOnClick"
                        Style="{StaticResource PrimaryButton}"
                        AutomationProperties.Name="{DynamicResource Loc.Terminal.Command.New}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;"
                                   Margin="0,0,7,0"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="White" />
                        <TextBlock Text="{DynamicResource Loc.Terminal.Command.New}"
                                   Foreground="White" />
                    </StackPanel>
                </Button>

                <Button x:Name="ReconnectButton"
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        Click="ReconnectOnClick"
                        Style="{StaticResource SecondaryButton}"
                        IsEnabled="False"
                        AutomationProperties.Name="{DynamicResource Loc.Terminal.Command.Reconnect}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;"
                                   Margin="0,0,7,0"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12" />
                        <TextBlock Text="{DynamicResource Loc.Terminal.Command.Reconnect}" />
                    </StackPanel>
                </Button>

                <Button x:Name="CloseTabButton"
                        Grid.Column="4"
                        Margin="8,0,0,0"
                        Click="CloseTabOnClick"
                        Style="{StaticResource GhostButton}"
                        IsEnabled="False"
                        AutomationProperties.Name="{DynamicResource Loc.Terminal.Command.CloseTab}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;"
                                   Margin="0,0,7,0"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="11" />
                        <TextBlock Text="{DynamicResource Loc.Terminal.Command.CloseTab}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- xterm/WebView2 remains the primary workspace. -->
        <ui:Card Grid.Row="2"
                 Margin="20,10,20,10"
                 Padding="0"
                 ClipToBounds="True">
            <TabControl x:Name="TerminalTabs"
                        Margin="0"
                        SelectionChanged="TerminalTabsOnSelectionChanged" />
        </ui:Card>

        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE765;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionText}"
                           Text="{DynamicResource Loc.Terminal.Shortcuts}" />
            </Grid>
        </Border>
    </Grid>
</Window>
