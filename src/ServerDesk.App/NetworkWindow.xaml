<Window x:Class="ServerDesk.App.NetworkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network"
        Width="1220"
        Height="760"
        MinWidth="940"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Loaded="WindowOnLoaded"
        Closed="WindowOnClosed">
    <Window.Resources>
        <Style x:Key="NetworkButton" TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="26" FontWeight="SemiBold" />
                <TextBlock x:Name="EndpointText" Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Refresh" Click="RefreshOnClick" Style="{StaticResource NetworkButton}" Margin="0" />
                <Button Content="Cancel" Click="CancelOnClick" Style="{StaticResource NetworkButton}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Search" Foreground="{DynamicResource MutedTextBrush}" />
            <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="SearchBoxOnTextChanged"
                     ToolTip="Filter interfaces and listening sockets by address, protocol, port, PID or process." />
        </Grid>

        <Border Grid.Row="2" Margin="0,12,0,10" Padding="10" CornerRadius="7"
                Background="{DynamicResource SurfaceSecondaryBrush}">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </Border>

        <TabControl Grid.Row="3">
            <TabItem Header="Interfaces">
                <DataGrid x:Name="InterfaceGrid" Margin="6"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Interface" Binding="{Binding Name}" Width="1*" />
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="0.8*" />
                        <DataGridTextColumn Header="Addresses" Binding="{Binding Addresses}" Width="2.6*" />
                        <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="1.4*" />
                        <DataGridTextColumn Header="MTU" Binding="{Binding Mtu}" Width="0.7*" />
                        <DataGridTextColumn Header="RX total" Binding="{Binding RxTotal}" Width="1*" />
                        <DataGridTextColumn Header="TX total" Binding="{Binding TxTotal}" Width="1*" />
                        <DataGridTextColumn Header="RX/s" Binding="{Binding RxRate}" Width="1*" />
                        <DataGridTextColumn Header="TX/s" Binding="{Binding TxRate}" Width="1*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Listening ports">
                <DataGrid x:Name="PortGrid" Margin="6"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="0.8*" />
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="1*" />
                        <DataGridTextColumn Header="Local address" Binding="{Binding LocalAddress}" Width="2*" />
                        <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="0.8*" />
                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="0.8*" />
                        <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="2*" />
                        <DataGridTextColumn Header="Owner" Binding="{Binding OwnerStatus}" Width="1.2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="FooterText" Grid.Row="4" Margin="0,10,0,0"
                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
    </Grid>
</Window>
