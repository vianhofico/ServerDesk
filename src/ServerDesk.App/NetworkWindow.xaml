<Window x:Class="ServerDesk.App.NetworkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource Loc.Network.WindowTitle}"
        Width="1320"
        Height="820"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Loaded="WindowOnLoaded"
        Closed="WindowOnClosed">
    <Window.Resources>
        <Style x:Key="NetworkStateText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc.Network.Header.Title}"
                               Style="{StaticResource PageTitleText}" />
                    <TextBlock Margin="0,2,0,3"
                               Text="{DynamicResource Loc.Network.Header.Subtitle}"
                               Style="{StaticResource CaptionText}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ServerNameText"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="  ·  "
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="EndpointText"
                                   Style="{StaticResource TechnicalText}"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusPill}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Loc.Network.Header.Environment}"
                                       Style="{StaticResource CaptionText}" />
                            <TextBlock Text=" · " Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock x:Name="EnvironmentValueText"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Margin="8,0,0,0" Style="{StaticResource AccentStatusPill}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6"
                                     Height="6"
                                     Margin="0,0,7,0"
                                     Fill="{DynamicResource AccentBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="ConnectionValueText"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="20,14,20,0"
                Style="{StaticResource CommandBarSurface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RefreshButton"
                            Click="RefreshOnClick"
                            Style="{StaticResource PrimaryButton}"
                            AutomationProperties.Name="{DynamicResource Loc.Network.Command.Refresh}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;"
                                       Margin="0,0,7,0"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="White" />
                            <TextBlock Text="{DynamicResource Loc.Network.Command.Refresh}"
                                       Foreground="White" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelButton"
                            Margin="8,0,0,0"
                            Click="CancelOnClick"
                            Style="{StaticResource GhostButton}"
                            AutomationProperties.Name="{DynamicResource Loc.Network.Command.Cancel}">
                        <TextBlock Text="{DynamicResource Loc.Network.Command.Cancel}" />
                    </Button>
                </StackPanel>

                <Grid Grid.Column="2">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource OperationalSearchTextBox}"
                             Padding="34,6,36,6"
                             TextChanged="SearchBoxOnTextChanged"
                             ToolTip="{DynamicResource Loc.Network.Search.Tooltip}"
                             AutomationProperties.Name="{DynamicResource Loc.Network.Search.Label}" />
                    <TextBlock Text="&#xE721;"
                               Margin="11,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <Button x:Name="ClearSearchButton"
                            Width="32"
                            Height="30"
                            Margin="0,0,3,0"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            ToolTip="{DynamicResource Loc.Network.Search.Clear}"
                            Click="ClearSearchOnClick"
                            Style="{StaticResource GhostButton}"
                            Visibility="Collapsed"
                            AutomationProperties.Name="{DynamicResource Loc.Network.Search.Clear}">
                        <TextBlock Text="&#xE711;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="11" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="20,10,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource MetricTile}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Network.Summary.Interfaces}" Style="{StaticResource EyebrowText}" />
                    <TextBlock x:Name="InterfaceCountText" Margin="0,4,0,0" Text="0" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource MetricTile}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Network.Summary.Listeners}" Style="{StaticResource EyebrowText}" />
                    <TextBlock x:Name="PortCountText" Margin="0,4,0,0" Text="0" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource MetricTile}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Network.Summary.HiddenOwners}" Style="{StaticResource EyebrowText}" />
                    <TextBlock x:Name="HiddenOwnerCountText" Margin="0,4,0,0" Text="0" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Margin="20,10,20,10"
                Style="{StaticResource InlineInfoCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource StatusPill}" Padding="7,2" VerticalAlignment="Top">
                    <TextBlock x:Name="StatusStateText" Style="{StaticResource NetworkStateText}" />
                </Border>
                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           Margin="10,2,0,0"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <ui:Card Grid.Row="4"
                 Margin="20,0,20,0"
                 Padding="0"
                 ClipToBounds="True">
            <TabControl x:Name="NetworkTabs" Margin="0">
                <TabItem Header="{DynamicResource Loc.Network.Tab.Interfaces}">
                    <DataGrid x:Name="InterfaceGrid"
                              Style="{StaticResource OperationalDataGrid}"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Loc.Network.Column.Interface}"
                                                Binding="{Binding Name}"
                                                Width="1*" />
                            <DataGridTemplateColumn Header="{DynamicResource Loc.Network.Column.State}"
                                                    SortMemberPath="State"
                                                    Width="0.8*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7"
                                                     Height="7"
                                                     Margin="0,0,7,0"
                                                     Fill="{DynamicResource MutedTextBrush}">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource MutedTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="UP">
                                                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="DOWN">
                                                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding State}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource Loc.Network.Column.Addresses}"
                                                Binding="{Binding Addresses}"
                                                Width="2.6*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TechnicalText}" />
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{DynamicResource Loc.Network.Column.Mac}"
                                                Binding="{Binding MacAddress}"
                                                Width="1.4*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TechnicalText}" />
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{DynamicResource Loc.Network.Column.Mtu}" Binding="{Binding Mtu}" Width="0.7*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Network.Column.RxTotal}" Binding="{Binding RxTotal}" Width="1*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Network.Column.TxTotal}" Binding="{Binding TxTotal}" Width="1*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Network.Column.RxRate}" Binding="{Binding RxRate}" Width="1*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Network.Column.TxRate}" Binding="{Binding TxRate}" Width="1*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="{DynamicResource Loc.Network.Tab.Ports}">
                    <DataGrid x:Name="PortGrid"
                              Style="{StaticResource OperationalDataGrid}"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Loc.Network.Column.Protocol}" Binding="{Binding Protocol}" Width="0.8*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Network.Column.State}" Binding="{Binding State}" Width="0.9*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Network.Column.LocalAddress}"
                                                Binding="{Binding LocalAddress}"
                                                Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TechnicalText}" />
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{DynamicResource Loc.Network.Column.Port}" Binding="{Binding Port}" Width="0.7*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Network.Column.Pid}"
                                                Binding="{Binding ProcessId}"
                                                Width="0.8*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TechnicalText}" />
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{DynamicResource Loc.Network.Column.Process}" Binding="{Binding ProcessName}" Width="1.7*" />
                            <DataGridTemplateColumn Header="{DynamicResource Loc.Network.Column.Owner}"
                                                    SortMemberPath="OwnerStatus"
                                                    Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource MutedTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OwnerVisible}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding OwnerStatus}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </ui:Card>

        <TextBlock x:Name="FooterText"
                   Grid.Row="5"
                   Margin="22,10,22,14"
                   Style="{StaticResource CaptionText}"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
