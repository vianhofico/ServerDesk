<Window x:Class="ServerDesk.App.ProfileMetadataImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.Transfer.ImportWindowTitle}"
        Width="1040"
        Height="650"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{DynamicResource Loc.Transfer.ImportTitle}"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,0"
                       Text="{DynamicResource Loc.Transfer.ImportSubtitle}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <TextBlock x:Name="TargetSummaryText"
                       Margin="0,7,0,0"
                       FontWeight="SemiBold" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,14"
                Padding="14"
                CornerRadius="9"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{DynamicResource Loc.Transfer.ImportCredentialWarning}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <CheckBox x:Name="ReviewedCheckBox"
                          Margin="0,10,0,0"
                          Content="{DynamicResource Loc.Transfer.ReviewAcknowledgement}"
                          Click="ReviewedOnClick" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Padding="8"
                CornerRadius="10"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <DataGrid ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="Transparent"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Loc.Transfer.ColumnServer}"
                                        Binding="{Binding Name}"
                                        Width="180" />
                    <DataGridTextColumn Header="{DynamicResource Loc.Transfer.ColumnEndpoint}"
                                        Binding="{Binding Endpoint}"
                                        Width="260" />
                    <DataGridTextColumn Header="{DynamicResource Loc.Transfer.ColumnEnvironment}"
                                        Binding="{Binding EnvironmentDisplay}"
                                        Width="130" />
                    <DataGridTextColumn Header="{DynamicResource Loc.Transfer.ColumnAuthentication}"
                                        Binding="{Binding AuthenticationDisplay}"
                                        Width="150" />
                    <DataGridTextColumn Header="{DynamicResource Loc.Transfer.ColumnResult}"
                                        Binding="{Binding StateDisplay}"
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText"
                       MaxWidth="650"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="ImportButton"
                        Padding="14,7"
                        Content="{DynamicResource Loc.Transfer.ImportReviewed}"
                        Click="ImportOnClick" />
                <Button x:Name="CancelButton"
                        Margin="8,0,0,0"
                        Padding="14,7"
                        Content="{DynamicResource Loc.Transfer.Cancel}"
                        Click="CancelOnClick" />
                <Button x:Name="CloseButton"
                        Margin="8,0,0,0"
                        Padding="14,7"
                        Content="{DynamicResource Loc.Transfer.Close}"
                        Click="CloseOnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
