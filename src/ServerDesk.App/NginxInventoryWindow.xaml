<Window x:Class="ServerDesk.App.NginxInventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.Nginx.WindowTitle}"
        Width="1180"
        Height="760"
        MinWidth="920"
        MinHeight="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Loc.Nginx.Subtitle}"
                           Margin="0,4,0,0"
                           Opacity="0.72" />
                <TextBlock x:Name="StatusText"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="EditButton"
                        Content="{DynamicResource Loc.Nginx.Edit}"
                        MinWidth="92"
                        Padding="14,7"
                        IsEnabled="False"
                        Click="EditOnClick" />
                <Button x:Name="RefreshButton"
                        Content="{DynamicResource Loc.Nginx.Refresh}"
                        MinWidth="92"
                        Padding="14,7"
                        Margin="8,0,0,0"
                        Click="RefreshOnClick" />
                <Button x:Name="CancelButton"
                        Content="{DynamicResource Loc.Nginx.Cancel}"
                        MinWidth="92"
                        Padding="14,7"
                        Margin="8,0,0,0"
                        IsEnabled="False"
                        Click="CancelOnClick" />
            </StackPanel>
        </Grid>

        <TextBox x:Name="SearchTextBox"
                 Grid.Row="1"
                 Margin="0,16,0,12"
                 MinHeight="34"
                 Padding="10,6"
                 ToolTip="{DynamicResource Loc.Nginx.Search}"
                 TextChanged="SearchOnTextChanged" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="SiteGrid"
                      Grid.Column="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      SelectionChanged="SiteSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Loc.Nginx.Site}" Binding="{Binding DisplayName}" Width="2*" />
                    <DataGridTextColumn Header="{DynamicResource Loc.Nginx.Listen}" Binding="{Binding ListenDisplay}" Width="*" />
                    <DataGridTextColumn Header="{DynamicResource Loc.Nginx.Source}" Binding="{Binding SourcePath}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" BorderThickness="1" BorderBrush="#22000000" CornerRadius="6" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SelectedTitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ServerNamesText" Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="ProxyTargetsText" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="TlsText" Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="CertificatesText" Grid.Row="4" Margin="0,8,0,8" TextWrapping="Wrap" />
                    <TextBox x:Name="RawBlockTextBox"
                             Grid.Row="5"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="12"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
