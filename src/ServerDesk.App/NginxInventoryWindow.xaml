<Window x:Class="ServerDesk.App.NginxInventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource Loc.Nginx.WindowTitle}"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource PageTitleText}" />
                    <TextBlock Margin="0,2,0,3"
                               Text="{DynamicResource Loc.Nginx.Subtitle}"
                               Style="{StaticResource CaptionText}" />
                    <TextBlock x:Name="EndpointText"
                               Style="{StaticResource TechnicalText}"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>

                <Border Grid.Column="1"
                        Style="{StaticResource StatusPill}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;"
                                   Margin="0,0,7,0"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Text="{DynamicResource Loc.Nginx.ActionTooltip}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="20,14,20,0"
                Style="{StaticResource CommandBarSurface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RefreshButton"
                            Click="RefreshOnClick"
                            Style="{StaticResource PrimaryButton}"
                            AutomationProperties.Name="{DynamicResource Loc.Nginx.Refresh}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;"
                                       Margin="0,0,7,0"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="White" />
                            <TextBlock Text="{DynamicResource Loc.Nginx.Refresh}" Foreground="White" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="EditButton"
                            Margin="8,0,0,0"
                            Content="{DynamicResource Loc.Nginx.Edit}"
                            Click="EditOnClick"
                            Style="{StaticResource SecondaryButton}"
                            IsEnabled="False"
                            AutomationProperties.Name="{DynamicResource Loc.Nginx.Edit}" />
                    <Button x:Name="CancelButton"
                            Margin="8,0,0,0"
                            Content="{DynamicResource Loc.Nginx.Cancel}"
                            Click="CancelOnClick"
                            Style="{StaticResource GhostButton}"
                            IsEnabled="False"
                            AutomationProperties.Name="{DynamicResource Loc.Nginx.Cancel}" />
                </StackPanel>

                <Grid Grid.Column="2">
                    <TextBox x:Name="SearchTextBox"
                             Style="{StaticResource OperationalSearchTextBox}"
                             Padding="34,6,36,6"
                             ToolTip="{DynamicResource Loc.Nginx.Search}"
                             TextChanged="SearchOnTextChanged"
                             AutomationProperties.Name="{DynamicResource Loc.Nginx.Search}" />
                    <TextBlock Text="&#xE721;"
                               Margin="11,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <Button x:Name="ClearSearchButton"
                            Width="32"
                            Height="30"
                            Margin="0,0,3,0"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="ClearSearchOnClick"
                            Style="{StaticResource GhostButton}"
                            ToolTip="{DynamicResource Loc.Nginx.ClearSearch}"
                            Visibility="Collapsed"
                            AutomationProperties.Name="{DynamicResource Loc.Nginx.ClearSearch}">
                        <TextBlock Text="&#xE711;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="11" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="20,10,20,10"
                Style="{StaticResource InlineInfoCard}">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="3" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <ui:Card Grid.Column="0"
                     Padding="0"
                     ClipToBounds="True">
                <DataGrid x:Name="SiteGrid"
                          Style="{StaticResource OperationalDataGrid}"
                          BorderThickness="0"
                          SelectionChanged="SiteSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Loc.Nginx.Site}"
                                            Binding="{Binding DisplayName}"
                                            Width="1.6*" />
                        <DataGridTextColumn Header="{DynamicResource Loc.Nginx.Listen}"
                                            Binding="{Binding ListenDisplay}"
                                            Width="1.1*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TechnicalText}" />
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{DynamicResource Loc.Nginx.Source}"
                                            Binding="{Binding SourcePath}"
                                            Width="2.2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TechnicalText}" />
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </ui:Card>

            <Border Grid.Column="2" Style="{StaticResource DetailsPane}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="SelectedTitleText"
                               Style="{StaticResource SectionTitleText}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ServerNamesText"
                               Grid.Row="1"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ProxyTargetsText"
                               Grid.Row="2"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="TlsText"
                               Grid.Row="3"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="CertificatesText"
                               Grid.Row="4"
                               Margin="0,8,0,12"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="5"
                               Text="{DynamicResource Loc.Nginx.RawBlock}"
                               Style="{StaticResource FormLabelText}" />
                    <TextBox x:Name="RawBlockTextBox"
                             Grid.Row="6"
                             Margin="0,4,0,0"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="12"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"
                             AutomationProperties.Name="{DynamicResource Loc.Nginx.RawBlock}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
