<Window x:Class="ServerDesk.App.ConnectionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connection history"
        Width="1120"
        Height="650"
        MinWidth="900"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Connection history" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Margin="0,5,0,0"
                           Text="Recent SSH control-session attempts. History is bounded locally and stores snapshots only — never credentials or prompt responses."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Padding="14,7" VerticalAlignment="Center" Click="RefreshOnClick" />
        </Grid>

        <Border Grid.Row="1"
                Margin="0,16,0,12"
                Padding="12"
                CornerRadius="8"
                Background="{DynamicResource SurfaceSecondaryBrush}">
            <TextBlock x:Name="StatusText"
                       Text="Loading recent attempts…"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </Border>

        <Border Grid.Row="2"
                CornerRadius="10"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <DataGrid x:Name="HistoryGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Started" Binding="{Binding Started}" Width="145" />
                    <DataGridTextColumn Header="Server" Binding="{Binding ProfileName}" Width="150" />
                    <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="210" />
                    <DataGridTextColumn Header="Route" Binding="{Binding Route}" Width="190" />
                    <DataGridTextColumn Header="Result" Binding="{Binding Outcome}" Width="145" />
                    <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="95" />
                    <DataGridTextColumn Header="Failure code" Binding="{Binding FailureCode}" Width="150" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock VerticalAlignment="Center"
                       Text="Retention: newest 500 attempts globally. Deleting a server keeps the history snapshot and clears the profile foreign key."
                       FontSize="11"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <Button HorizontalAlignment="Right" Content="Close" Padding="14,7" IsCancel="True" />
        </Grid>
    </Grid>
</Window>
