<Window x:Class="ServerDesk.App.PackageAdministrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.PackageAdmin.WindowTitle}"
        Width="1240"
        Height="780"
        MinWidth="1020"
        MinHeight="650"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Loc.PackageAdmin.Subtitle}"
                           Margin="0,4,0,0"
                           Opacity="0.72"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1"
                    x:Name="RefreshButton"
                    Content="{DynamicResource Loc.PackageAdmin.RefreshInventory}"
                    MinWidth="120"
                    Padding="14,7"
                    VerticalAlignment="Top"
                    Click="RefreshOnClick" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="PackageGrid"
                      Grid.Column="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      EnableRowVirtualization="True"
                      SelectionChanged="PackageSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Loc.PackageAdmin.Package}" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="{DynamicResource Loc.PackageAdmin.Installed}" Binding="{Binding InstalledVersion}" Width="2*" />
                    <DataGridTextColumn Header="{DynamicResource Loc.PackageAdmin.Candidate}" Binding="{Binding CandidateVersion}" Width="2*" />
                    <DataGridTextColumn Header="{DynamicResource Loc.PackageAdmin.Architecture}" Binding="{Binding Architecture}" Width="*" />
                    <DataGridTextColumn Header="{DynamicResource Loc.PackageAdmin.Repository}" Binding="{Binding Repository}" Width="2*" />
                    <DataGridTextColumn Header="{DynamicResource Loc.PackageAdmin.Classification}" Binding="{Binding UpdateClassification}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2"
                    BorderThickness="1"
                    BorderBrush="#22000000"
                    CornerRadius="6"
                    Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.PackageAdmin.GuardedOperation}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Loc.PackageAdmin.SelectedOnlyNotice}"
                                   Margin="0,6,0,12"
                                   Opacity="0.72"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="{DynamicResource Loc.PackageAdmin.Manager}" />
                        <TextBlock x:Name="ManagerText"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,12" />

                        <TextBlock Text="{DynamicResource Loc.PackageAdmin.Operation}" />
                        <ComboBox x:Name="OperationComboBox"
                                  Margin="0,4,0,10"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Text"
                                  SelectionChanged="EditorChanged" />

                        <TextBlock Text="{DynamicResource Loc.PackageAdmin.SelectedPackages}" />
                        <TextBlock x:Name="SelectedPackagesText"
                                   Margin="0,4,0,12"
                                   TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PreviewButton"
                                    Content="{DynamicResource Loc.PackageAdmin.Preview}"
                                    Padding="14,7"
                                    Click="PreviewOnClick" />
                            <Button x:Name="ExecuteButton"
                                    Content="{DynamicResource Loc.PackageAdmin.Execute}"
                                    Padding="14,7"
                                    Margin="8,0,0,0"
                                    IsEnabled="False"
                                    Click="ExecuteOnClick" />
                        </StackPanel>

                        <TextBlock Text="{DynamicResource Loc.PackageAdmin.ExactCommand}"
                                   FontWeight="SemiBold"
                                   Margin="0,14,0,4" />
                        <TextBox x:Name="PreviewTextBox"
                                 IsReadOnly="True"
                                 MinHeight="64"
                                 TextWrapping="Wrap"
                                 FontFamily="Cascadia Mono, Consolas" />

                        <TextBlock Text="{DynamicResource Loc.PackageAdmin.Impact}"
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,4" />
                        <TextBlock x:Name="ImpactText"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="{DynamicResource Loc.PackageAdmin.NoAutomaticUpgrade}"
                                   Margin="0,14,0,0"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{DynamicResource Loc.PackageAdmin.Footer}"
                   Margin="0,12,0,0"
                   Opacity="0.68"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
