<Window x:Class="ServerDesk.App.DatabaseRuntimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.DatabaseRuntime.WindowTitle}"
        Width="1180"
        Height="720"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Loc.DatabaseRuntime.Subtitle}"
                           Margin="0,4,0,0"
                           Opacity="0.72"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="RefreshButton"
                        Content="{DynamicResource Loc.DatabaseRuntime.Refresh}"
                        MinWidth="92"
                        Padding="14,7"
                        Click="RefreshOnClick" />
                <Button x:Name="CancelButton"
                        Content="{DynamicResource Loc.DatabaseRuntime.Cancel}"
                        MinWidth="92"
                        Padding="14,7"
                        Margin="8,0,0,0"
                        IsEnabled="False"
                        Click="CancelOnClick" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="SummaryText"
                   Grid.Row="1"
                   Margin="0,12,0,12"
                   Opacity="0.75"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="EngineGrid"
                      Grid.Column="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      SelectionChanged="EngineSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Loc.DatabaseRuntime.Engine}" Binding="{Binding Engine}" Width="130" />
                    <DataGridTextColumn Header="{DynamicResource Loc.DatabaseRuntime.Status}" Binding="{Binding Status}" Width="130" />
                    <DataGridTextColumn Header="{DynamicResource Loc.DatabaseRuntime.Version}" Binding="{Binding Version}" Width="2*" />
                    <DataGridTextColumn Header="{DynamicResource Loc.DatabaseRuntime.Service}" Binding="{Binding ServiceUnit}" Width="180" />
                    <DataGridTextColumn Header="{DynamicResource Loc.DatabaseRuntime.Runtime}" Binding="{Binding ActiveState}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2"
                    BorderThickness="1"
                    BorderBrush="#22000000"
                    CornerRadius="6"
                    Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="SelectedTitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="ExecutableText" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="VersionText" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="ServiceText" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="JournalText" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailText" Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Margin="0,12,0,0"
                   Text="{DynamicResource Loc.DatabaseRuntime.SafetyFooter}"
                   Opacity="0.72"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
