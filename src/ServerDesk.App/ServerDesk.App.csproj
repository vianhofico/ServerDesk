<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Branding\serverdesk.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ServerDesk.Application\ServerDesk.Application.csproj" />
    <ProjectReference Include="..\ServerDesk.Domain\ServerDesk.Domain.csproj" />
    <ProjectReference Include="..\ServerDesk.Infrastructure.Databases\ServerDesk.Infrastructure.Databases.csproj" />
    <ProjectReference Include="..\ServerDesk.Infrastructure.Persistence\ServerDesk.Infrastructure.Persistence.csproj" />
    <ProjectReference Include="..\ServerDesk.Infrastructure.Ssh\ServerDesk.Infrastructure.Ssh.csproj" />
    <ProjectReference Include="..\ServerDesk.Platform.Windows\ServerDesk.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Branding\serverdesk.ico" />
  </ItemGroup>

  <Target Name="BuildTerminalFrontend"
          BeforeTargets="BeforeBuild"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="npm install --no-package-lock --no-audit --no-fund"
          WorkingDirectory="$(MSBuildProjectDirectory)\TerminalFrontend" />
    <Exec Command="npm run build"
          WorkingDirectory="$(MSBuildProjectDirectory)\TerminalFrontend" />
    <ItemGroup>
      <_TerminalFrontendAsset Include="$(MSBuildProjectDirectory)\TerminalFrontend\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_TerminalFrontendAsset)"
          DestinationFolder="$(OutDir)TerminalFrontend\dist\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyTerminalFrontendToPublish"
          AfterTargets="Publish"
          Condition="Exists('$(MSBuildProjectDirectory)\TerminalFrontend\dist')">
    <ItemGroup>
      <_TerminalPublishAsset Include="$(MSBuildProjectDirectory)\TerminalFrontend\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_TerminalPublishAsset)"
          DestinationFolder="$(PublishDir)TerminalFrontend\dist\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
