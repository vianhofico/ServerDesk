<Window x:Class="ServerDesk.App.DeploymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.Deploy.WindowTitle}"
        Width="1500"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="HeaderText" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Loc.Deploy.Subtitle}"
                           Margin="0,4,0,0"
                           Opacity="0.72"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Content="{DynamicResource Loc.Deploy.Cancel}"
                    MinWidth="90"
                    Padding="14,7"
                    VerticalAlignment="Top"
                    IsEnabled="False"
                    Click="CancelOnClick" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="460" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="7*" MinWidth="590" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,4,0">
                    <GroupBox Header="{DynamicResource Loc.Deploy.Target}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc.Deploy.TargetId}" FontWeight="SemiBold" />
                            <TextBox x:Name="TargetIdTextBox"
                                     Margin="0,4,0,0"
                                     Padding="8,5"
                                     ToolTip="{DynamicResource Loc.Deploy.TargetIdHint}"
                                     TextChanged="TargetInputChanged" />
                            <TextBlock Text="{DynamicResource Loc.Deploy.TargetName}" Margin="0,10,0,0" FontWeight="SemiBold" />
                            <TextBox x:Name="TargetNameTextBox"
                                     Margin="0,4,0,0"
                                     Padding="8,5"
                                     TextChanged="TargetInputChanged" />
                            <TextBlock Text="{DynamicResource Loc.Deploy.Environment}" Margin="0,10,0,0" FontWeight="SemiBold" />
                            <TextBox x:Name="EnvironmentTextBox"
                                     Margin="0,4,0,0"
                                     Padding="8,5"
                                     TextChanged="TargetInputChanged" />
                            <TextBlock Text="{DynamicResource Loc.Deploy.Kind}" Margin="0,10,0,0" FontWeight="SemiBold" />
                            <ComboBox x:Name="KindComboBox"
                                      Margin="0,4,0,0"
                                      MinHeight="32"
                                      DisplayMemberPath="Display"
                                      SelectionChanged="KindSelectionChanged" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="GitGroup"
                              Header="{DynamicResource Loc.Deploy.RepositoryPath}"
                              Margin="0,12,0,0"
                              Padding="12">
                        <StackPanel>
                            <TextBox x:Name="RepositoryPathTextBox"
                                     Padding="8,5"
                                     ToolTip="{DynamicResource Loc.Deploy.RepositoryPathHint}"
                                     TextChanged="TargetInputChanged" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="ComposeGroup"
                              Header="{DynamicResource Loc.Deploy.Compose}"
                              Margin="0,12,0,0"
                              Padding="12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc.Deploy.ComposeProject}" FontWeight="SemiBold" />
                            <TextBox x:Name="ComposeProjectTextBox"
                                     Margin="0,4,0,0"
                                     Padding="8,5"
                                     TextChanged="TargetInputChanged" />
                            <TextBlock Text="{DynamicResource Loc.Deploy.ComposeConfigs}" Margin="0,10,0,0" FontWeight="SemiBold" />
                            <TextBox x:Name="ComposeConfigsTextBox"
                                     Margin="0,4,0,0"
                                     Padding="8,5"
                                     MinHeight="72"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     TextChanged="TargetInputChanged" />
                            <TextBlock Text="{DynamicResource Loc.Deploy.ComposeMode}" Margin="0,10,0,0" FontWeight="SemiBold" />
                            <ComboBox x:Name="ComposeModeComboBox"
                                      Margin="0,4,0,0"
                                      MinHeight="32"
                                      DisplayMemberPath="Display"
                                      SelectionChanged="TargetInputSelectionChanged" />
                            <CheckBox x:Name="ComposePullCheckBox"
                                      Content="{DynamicResource Loc.Deploy.ComposePull}"
                                      Margin="0,10,0,0"
                                      Checked="TargetInputChecked"
                                      Unchecked="TargetInputChecked" />
                            <CheckBox x:Name="ComposeBuildCheckBox"
                                      Content="{DynamicResource Loc.Deploy.ComposeBuild}"
                                      Margin="0,6,0,0"
                                      Checked="TargetInputChecked"
                                      Unchecked="TargetInputChecked" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="SystemdGroup"
                              Header="{DynamicResource Loc.Deploy.SystemdUnit}"
                              Margin="0,12,0,0"
                              Padding="12">
                        <TextBox x:Name="SystemdUnitTextBox"
                                 Padding="8,5"
                                 ToolTip="{DynamicResource Loc.Deploy.SystemdUnitHint}"
                                 TextChanged="TargetInputChanged" />
                    </GroupBox>

                    <GroupBox Header="{DynamicResource Loc.Deploy.Health}"
                              Margin="0,12,0,0"
                              Padding="12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="4*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource Loc.Deploy.HealthName}" FontWeight="SemiBold" />
                                    <TextBox x:Name="HealthNameTextBox" Margin="0,4,0,0" Padding="7,5" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Loc.Deploy.HealthKind}" FontWeight="SemiBold" />
                                    <ComboBox x:Name="HealthKindComboBox"
                                              Margin="0,4,0,0"
                                              MinHeight="32"
                                              DisplayMemberPath="Display"
                                              SelectionChanged="HealthKindSelectionChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{DynamicResource Loc.Deploy.HealthTarget}" FontWeight="SemiBold" />
                                    <TextBox x:Name="HealthTargetTextBox" Margin="0,4,0,0" Padding="7,5" />
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="{DynamicResource Loc.Deploy.HealthPort}" FontWeight="SemiBold" />
                                    <TextBox x:Name="HealthPortTextBox" Margin="0,4,0,0" Padding="7,5" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="HealthHintText" Margin="0,7,0,0" Opacity="0.7" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="{DynamicResource Loc.Deploy.HealthAdd}"
                                        Padding="12,6"
                                        Click="AddHealthOnClick" />
                                <Button Content="{DynamicResource Loc.Deploy.HealthRemove}"
                                        Margin="8,0,0,0"
                                        Padding="12,6"
                                        Click="RemoveHealthOnClick" />
                            </WrapPanel>
                            <DataGrid x:Name="HealthGrid"
                                      Margin="0,10,0,0"
                                      MinHeight="120"
                                      MaxHeight="190"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource Loc.Deploy.HealthName}" Binding="{Binding Name}" Width="2*" />
                                    <DataGridTextColumn Header="{DynamicResource Loc.Deploy.HealthKind}" Binding="{Binding KindDisplay}" Width="2*" />
                                    <DataGridTextColumn Header="{DynamicResource Loc.Deploy.HealthTarget}" Binding="{Binding TargetDisplay}" Width="4*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </GroupBox>

                    <Button x:Name="PreviewButton"
                            Content="{DynamicResource Loc.Deploy.Preview}"
                            Margin="0,14,0,0"
                            Padding="14,8"
                            MinWidth="160"
                            HorizontalAlignment="Left"
                            Click="PreviewOnClick" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource Loc.Deploy.Plan}" FontWeight="SemiBold" />
                <DataGrid x:Name="PlanGrid"
                          Grid.Row="1"
                          Margin="0,8,0,0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Loc.Deploy.Sequence}" Binding="{Binding Sequence}" Width="55" />
                        <DataGridTextColumn Header="{DynamicResource Loc.Deploy.Step}" Binding="{Binding StepDisplay}" Width="3*" />
                        <DataGridTextColumn Header="{DynamicResource Loc.Deploy.Risk}" Binding="{Binding RiskDisplay}" Width="2*" />
                        <DataGridTextColumn Header="{DynamicResource Loc.Deploy.Conditional}" Binding="{Binding ConditionalDisplay}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
                <WrapPanel Grid.Row="2" Margin="0,10,0,12">
                    <Button x:Name="ExecuteButton"
                            Content="{DynamicResource Loc.Deploy.Execute}"
                            Padding="14,8"
                            MinWidth="190"
                            IsEnabled="False"
                            Click="ExecuteOnClick" />
                    <Button x:Name="RollbackButton"
                            Content="{DynamicResource Loc.Deploy.Rollback}"
                            Margin="8,0,0,0"
                            Padding="14,8"
                            MinWidth="170"
                            IsEnabled="False"
                            Click="RollbackOnClick" />
                </WrapPanel>
                <TextBlock Grid.Row="3" Text="{DynamicResource Loc.Deploy.Results}" FontWeight="SemiBold" />
                <DataGrid x:Name="ResultGrid"
                          Grid.Row="4"
                          Margin="0,8,0,0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Loc.Deploy.Sequence}" Binding="{Binding Sequence}" Width="55" />
                        <DataGridTextColumn Header="{DynamicResource Loc.Deploy.Step}" Binding="{Binding StepDisplay}" Width="2*" />
                        <DataGridTextColumn Header="{DynamicResource Loc.Deploy.Outcome}" Binding="{Binding OutcomeDisplay}" Width="120" />
                        <DataGridTextColumn Header="{DynamicResource Loc.Deploy.Message}" Binding="{Binding Message}" Width="4*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   Text="{DynamicResource Loc.Deploy.SafetyFooter}"
                   Opacity="0.72"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
