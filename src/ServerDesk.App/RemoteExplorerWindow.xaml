<Window x:Class="ServerDesk.App.RemoteExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Explorer"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        AllowDrop="True"
        Loaded="WindowOnLoaded"
        Closed="WindowOnClosed"
        DragOver="WindowOnDragOver"
        Drop="WindowOnDrop">
    <Window.Resources>
        <Style x:Key="ExplorerButton" TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="26" FontWeight="SemiBold" />
                <TextBlock x:Name="EndpointText"
                           Margin="0,5,0,0"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="New folder" Click="NewFolderOnClick" Style="{StaticResource ExplorerButton}" />
                <Button Content="Upload" Click="UploadOnClick" Style="{StaticResource ExplorerButton}" />
                <Button Content="Download" Click="DownloadOnClick" Style="{StaticResource ExplorerButton}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Content="Back" Click="BackOnClick" Style="{StaticResource ExplorerButton}" Margin="0" />
            <Button Grid.Column="1" Content="Up" Click="UpOnClick" Style="{StaticResource ExplorerButton}" />
            <TextBox x:Name="AddressBox"
                     Grid.Column="2"
                     Margin="10,0,8,0"
                     VerticalContentAlignment="Center"
                     KeyDown="AddressBoxOnKeyDown" />
            <Button Grid.Column="3" Content="Refresh" Click="RefreshOnClick" Style="{StaticResource ExplorerButton}" Margin="0" />
            <Button Grid.Column="4" Content="Cancel" Click="CancelOnClick" Style="{StaticResource ExplorerButton}" />
        </Grid>

        <Border Grid.Row="2"
                Margin="0,12,0,10"
                Padding="10"
                CornerRadius="7"
                Background="{DynamicResource SurfaceSecondaryBrush}">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </Border>

        <DataGrid x:Name="FileGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  MouseDoubleClick="FileGridOnMouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2.6*" />
                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="*" />
                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="*" />
                <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedText}" Width="1.5*" />
                <DataGridTextColumn Header="Mode" Binding="{Binding PermissionsText}" Width="0.8*" />
                <DataGridTextColumn Header="UID" Binding="{Binding OwnerText}" Width="0.7*" />
                <DataGridTextColumn Header="GID" Binding="{Binding GroupText}" Width="0.7*" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Edit text" Click="EditOnClick" />
                    <MenuItem Header="Download" Click="DownloadOnClick" />
                    <MenuItem Header="Rename" Click="RenameOnClick" />
                    <MenuItem Header="Permissions" Click="PermissionsOnClick" />
                    <Separator />
                    <MenuItem Header="Delete" Click="DeleteOnClick" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <ProgressBar x:Name="TransferProgress"
                         Grid.Column="1"
                         Height="8"
                         Minimum="0"
                         Maximum="100"
                         Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
