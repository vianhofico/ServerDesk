<Window x:Class="ServerDesk.App.RemoteExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.Explorer.WindowTitle}"
        Width="1240"
        Height="800"
        MinWidth="920"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        AllowDrop="True"
        Loaded="WindowOnLoaded"
        Closed="WindowOnClosed"
        DragOver="WindowOnDragOver"
        Drop="WindowOnDrop">
    <Window.Resources>
        <Style x:Key="ExplorerTechnicalText"
               TargetType="TextBlock"
               BasedOn="{StaticResource TechnicalText}" />
        <Style x:Key="ExplorerNameText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SurfaceCard}" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Explorer.Header.Title}"
                               FontSize="27"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource Loc.Explorer.Header.Subtitle}"
                               Margin="0,3,0,10"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ServerNameText" FontWeight="SemiBold" />
                        <TextBlock Text="  ·  " Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="EndpointText"
                                   Style="{StaticResource ExplorerTechnicalText}"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="12,8"
                            CornerRadius="8"
                            Background="{DynamicResource SurfaceSecondaryBrush}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc.Explorer.Header.Environment}"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock x:Name="EnvironmentValueText"
                                       Margin="0,2,0,0"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Margin="8,0,0,0"
                            Padding="12,8"
                            CornerRadius="8"
                            Background="{DynamicResource AccentSoftBrush}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc.Explorer.Header.Connection}"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock x:Name="ConnectionValueText"
                                       Margin="0,2,0,0"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Style="{StaticResource CommandBarSurface}">
            <WrapPanel VerticalAlignment="Center">
                <Button x:Name="NewFolderButton"
                        Content="{DynamicResource Loc.Explorer.Command.NewFolder}"
                        Click="NewFolderOnClick"
                        Style="{StaticResource SecondaryButton}" />
                <Button x:Name="UploadButton"
                        Margin="8,0,0,0"
                        Content="{DynamicResource Loc.Explorer.Command.Upload}"
                        Click="UploadOnClick"
                        Style="{StaticResource PrimaryButton}" />
                <Button x:Name="DownloadButton"
                        Margin="8,0,0,0"
                        Content="{DynamicResource Loc.Explorer.Command.Download}"
                        Click="DownloadOnClick"
                        Style="{StaticResource SecondaryButton}"
                        IsEnabled="False" />

                <Border Width="1" Height="24" Margin="14,5" Background="{DynamicResource BorderBrush}" />

                <Button x:Name="EditButton"
                        Content="{DynamicResource Loc.Explorer.Command.EditText}"
                        Click="EditOnClick"
                        Style="{StaticResource GhostButton}"
                        IsEnabled="False" />
                <Button x:Name="RenameButton"
                        Margin="4,0,0,0"
                        Content="{DynamicResource Loc.Explorer.Command.Rename}"
                        Click="RenameOnClick"
                        Style="{StaticResource GhostButton}"
                        IsEnabled="False" />
                <Button x:Name="PermissionsButton"
                        Margin="4,0,0,0"
                        Content="{DynamicResource Loc.Explorer.Command.Permissions}"
                        Click="PermissionsOnClick"
                        Style="{StaticResource GhostButton}"
                        IsEnabled="False" />
                <Button x:Name="DeleteButton"
                        Margin="12,0,0,0"
                        Content="{DynamicResource Loc.Explorer.Command.Delete}"
                        Click="DeleteOnClick"
                        Style="{StaticResource DangerButton}"
                        IsEnabled="False" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BackButton"
                        Width="38"
                        Padding="0"
                        Content="←"
                        ToolTip="{DynamicResource Loc.Explorer.Nav.Back}"
                        Click="BackOnClick"
                        Style="{StaticResource GhostButton}"
                        IsEnabled="False"
                        AutomationProperties.Name="{DynamicResource Loc.Explorer.Nav.Back}" />
                <Button x:Name="ForwardButton"
                        Width="38"
                        Margin="2,0,0,0"
                        Padding="0"
                        Content="→"
                        ToolTip="{DynamicResource Loc.Explorer.Nav.Forward}"
                        Click="ForwardOnClick"
                        Style="{StaticResource GhostButton}"
                        IsEnabled="False"
                        AutomationProperties.Name="{DynamicResource Loc.Explorer.Nav.Forward}" />
                <Button x:Name="UpButton"
                        Width="38"
                        Margin="2,0,0,0"
                        Padding="0"
                        Content="↑"
                        ToolTip="{DynamicResource Loc.Explorer.Nav.Up}"
                        Click="UpOnClick"
                        Style="{StaticResource GhostButton}"
                        IsEnabled="False"
                        AutomationProperties.Name="{DynamicResource Loc.Explorer.Nav.Up}" />
            </StackPanel>

            <Grid Grid.Column="1" Margin="8,0">
                <Border Style="{StaticResource SurfaceCard}" CornerRadius="7" Padding="4,2">
                    <Grid>
                        <ScrollViewer x:Name="BreadcrumbScroll"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" />
                        </ScrollViewer>
                        <TextBox x:Name="AddressBox"
                                 Visibility="Collapsed"
                                 Style="{StaticResource FieldTextBox}"
                                 BorderThickness="0"
                                 FontFamily="Cascadia Mono, Consolas"
                                 KeyDown="AddressBoxOnKeyDown"
                                 AutomationProperties.Name="{DynamicResource Loc.Explorer.Path.Label}" />
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="EditPathButton"
                        Content="{DynamicResource Loc.Explorer.Nav.EditPath}"
                        Click="EditAddressOnClick"
                        Style="{StaticResource GhostButton}" />
                <Button x:Name="RefreshButton"
                        Margin="4,0,0,0"
                        Content="{DynamicResource Loc.Explorer.Nav.Refresh}"
                        Click="RefreshOnClick"
                        Style="{StaticResource SecondaryButton}" />
                <Button x:Name="CancelButton"
                        Margin="6,0,0,0"
                        Content="{DynamicResource Loc.Explorer.Nav.Cancel}"
                        Click="CancelOnClick"
                        Style="{StaticResource GhostButton}"
                        IsEnabled="False" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <Border x:Name="StatusCard" Style="{StaticResource InlineInfoCard}" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusStateText" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="  ·  " Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusMessageText" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource OperationalSearchTextBox}"
                         Padding="10,6,38,6"
                         TextChanged="SearchBoxOnTextChanged"
                         ToolTip="{DynamicResource Loc.Explorer.Search.Tooltip}"
                         AutomationProperties.Name="{DynamicResource Loc.Explorer.Search.Label}" />
                <Button x:Name="ClearSearchButton"
                        Width="32"
                        Height="30"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,3,0"
                        Padding="0"
                        Content="×"
                        ToolTip="{DynamicResource Loc.Explorer.Search.Clear}"
                        Click="ClearSearchOnClick"
                        Style="{StaticResource GhostButton}"
                        Visibility="Collapsed"
                        AutomationProperties.Name="{DynamicResource Loc.Explorer.Search.Clear}" />
            </Grid>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource SurfaceCard}" CornerRadius="8" ClipToBounds="True">
            <Grid>
                <DataGrid x:Name="FileGrid"
                          Style="{StaticResource OperationalDataGrid}"
                          BorderThickness="0"
                          SelectionChanged="FileGridOnSelectionChanged"
                          MouseDoubleClick="FileGridOnMouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{DynamicResource Loc.Explorer.Column.Name}" SortMemberPath="Name" Width="2.8*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource ExplorerNameText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{DynamicResource Loc.Explorer.Column.Type}" Binding="{Binding Kind}" Width="*" />
                        <DataGridTextColumn Header="{DynamicResource Loc.Explorer.Column.Size}" Binding="{Binding SizeText}" Width="*" />
                        <DataGridTextColumn Header="{DynamicResource Loc.Explorer.Column.Modified}" Binding="{Binding ModifiedText}" Width="1.5*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ExplorerTechnicalText}" />
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{DynamicResource Loc.Explorer.Column.Mode}" Binding="{Binding PermissionsText}" Width="0.8*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ExplorerTechnicalText}" />
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{DynamicResource Loc.Explorer.Column.Owner}" Binding="{Binding OwnerText}" Width="0.7*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ExplorerTechnicalText}" />
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{DynamicResource Loc.Explorer.Column.Group}" Binding="{Binding GroupText}" Width="0.7*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ExplorerTechnicalText}" />
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource Loc.Explorer.Command.EditText}" Click="EditOnClick" />
                            <MenuItem Header="{DynamicResource Loc.Explorer.Command.Download}" Click="DownloadOnClick" />
                            <MenuItem Header="{DynamicResource Loc.Explorer.Command.Rename}" Click="RenameOnClick" />
                            <MenuItem Header="{DynamicResource Loc.Explorer.Command.Permissions}" Click="PermissionsOnClick" />
                            <Separator />
                            <MenuItem Header="{DynamicResource Loc.Explorer.Command.Delete}"
                                      Foreground="{DynamicResource DangerBrush}"
                                      Click="DeleteOnClick" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <Border x:Name="GridStateOverlay"
                        Background="{DynamicResource SurfaceBrush}"
                        Visibility="Visible"
                        IsHitTestVisible="False">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="GridStateTitle"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="GridStateDetail"
                                   Margin="0,7,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="FooterText" Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock Text="{DynamicResource Loc.Explorer.DropHint}"
                           Margin="0,3,16,0"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <ProgressBar x:Name="TransferProgress"
                         Grid.Column="1"
                         Height="8"
                         Minimum="0"
                         Maximum="100"
                         Visibility="Collapsed"
                         VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
